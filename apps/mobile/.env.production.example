# Copy to apps/mobile/.env.production and fill in. That file is gitignored.
#
# ⚠️  THIS TARGETS PRODUCTION: live data, live Razorpay, real money, real children's
#     records. It is used only by `npm run dev:mobile:prod`, deliberately, and it is not
#     what a normal day looks like. Do not place test orders against it.
#
# EDIT THIS FILE, NEVER .env — `dev:mobile:prod` overwrites .env on every start.
#
# Everything here is EXPO_PUBLIC_* and is EMBEDDED IN THE CLIENT BUNDLE. Only publishable
# values. Server secrets live in `.secrets.production.env` at the repository root (`EN4`).

EXPO_PUBLIC_APP_ENV=production

# --- Supabase ------------------------------------------------------------------
# Production project (Mumbai, ap-south-1 — `A2`). Dashboard → Settings → API.
EXPO_PUBLIC_SUPABASE_URL=
# The ANON key, never the service-role key. `EN3` fails the build if a server-only name
# appears in a client environment at all — not just if it is used.
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# --- Razorpay ------------------------------------------------------------------
# MUST start rzp_live_. This is the only environment where that is true (`EN1`).
EXPO_PUBLIC_RAZORPAY_KEY_ID=

# --- Optional ------------------------------------------------------------------
EXPO_PUBLIC_SENTRY_DSN=

# Opt in to running a DEV build against production. The startup guard refuses production
# otherwise, because the failure it prevents is silent: a developer testing a checkout flow
# against live data creates a real order for a real child, and nothing about the screen says
# so. Set only here, only for a deliberate prod check.
EXPO_PUBLIC_ALLOW_PROD=true
