# Copy to apps/mobile/.env.staging and fill in. That file is gitignored.
#
#   cp apps/mobile/.env.staging.example apps/mobile/.env.staging
#   $EDITOR apps/mobile/.env.staging
#   npm run dev:mobile          # copies this onto .env and starts Expo
#
# EDIT THIS FILE (or .env.production), NEVER .env — `dev:mobile` overwrites .env on every
# start, so an edit there is lost the next time somebody runs it. That indirection is the
# point: it is what replaces hand-swapping Razorpay keys before each test (`A7`), which is
# the practice this pattern exists to end.
#
# Everything here is EXPO_PUBLIC_* and is therefore EMBEDDED IN THE CLIENT BUNDLE. Only
# publishable values belong in this file. Server secrets live in `.secrets.<env>.env` at the
# repository root and are pushed with `npm run secrets:set` (`EN4`) — two different files for
# two different trust levels, and `EN3` fails the build if a server-only name appears here.

# local | staging | production. `packages/shared/src/env.ts` refuses to start if this
# disagrees with the Razorpay key prefix below (`EN2`).
EXPO_PUBLIC_APP_ENV=staging

# --- Supabase ------------------------------------------------------------------
# Staging project. Dashboard → Settings → API.
EXPO_PUBLIC_SUPABASE_URL=
# The ANON key. Publishable by design — RLS is the control, not this key (`D17`, `PB1`).
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# --- Razorpay ------------------------------------------------------------------
# MUST start rzp_test_. `EN1`: local and staging share the one Razorpay test account, and
# only production is live. A live key here is the mistake that moves real money in a test.
EXPO_PUBLIC_RAZORPAY_KEY_ID=

# --- Optional ------------------------------------------------------------------
# Leave blank to no-op.
EXPO_PUBLIC_SENTRY_DSN=

# Guard for running a DEV build against PRODUCTION data. Leave false here; it is set true
# only in .env.production, and only deliberately.
EXPO_PUBLIC_ALLOW_PROD=false
