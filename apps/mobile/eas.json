{
  "cli": {
    "version": ">= 13.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "channel": "development",
      "env": {
        "APP_ENV": "local"
      },
      "environment": "development"
    },
    "staging": {
      "distribution": "internal",
      "channel": "staging",
      "android": {
        "buildType": "apk"
      },
      "env": {
        "APP_ENV": "staging"
      },
      "environment": "preview",
      "autoIncrement": true
    },
    "preview": {
      "extends": "staging",
      "channel": "staging",
      "ios": {
        "distribution": "store"
      },
      "android": {
        "buildType": "app-bundle"
      },
      "environment": "preview",
      "autoIncrement": true
    },
    "production": {
      "autoIncrement": true,
      "channel": "production",
      "env": {
        "APP_ENV": "production"
      },
      "environment": "production"
    },
    "production-apk": {
      "extends": "production",
      "channel": "production",
      "android": {
        "buildType": "apk"
      }
    }
  },
  "submit": {
    "production": {
      "ios": {
        "appleTeamId": "F247T8Y2NT",
        "ascAppId": "6749555467",
        "ascApiKeyId": "435XUS53TJ",
        "ascApiKeyIssuerId": "92f32c0c-4434-4bd3-91d2-7b66868a48e4"
      },
      "android": {
        "track": "internal"
      }
    },
    "preview": {
      "ios": {
        "appleTeamId": "F247T8Y2NT",
        "ascAppId": "6800175123"
      },
      "android": {
        "track": "internal"
      }
    }
  }
}
