# apps/web — the public half of the environment, for local development.
#
#   cp apps/web/.env.example apps/web/.env
#
# Both values are publishable by design: the anon key ships in the browser bundle and RLS is
# the control, not the key (packages/shared/src/env.ts). The SERVICE ROLE key must NEVER
# appear here — it belongs in .secrets.<env>.env at the repository root and nowhere a build
# can reach it.
#
# `.env` is gitignored. This file is the template.

PUBLIC_APP_ENV=staging
PUBLIC_SUPABASE_URL=
PUBLIC_SUPABASE_ANON_KEY=

# The kitchen dashboard's transport. `fixture` runs against generated data and needs no
# server; `live` uses the api/ module. Defaults to fixture so a clean checkout works.
PUBLIC_KITCHEN_TRANSPORT=fixture

# The enquiry form's endpoint (E12-15). Unset falls back to the dev mock.
PUBLIC_ENQUIRY_ENDPOINT=
