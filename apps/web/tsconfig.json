{
  "$schema": "https://json.schemastore.org/tsconfig",
  // Astro's base is required, not optional: it supplies the `.astro` module shims, the
  // `astro:*` virtual modules and the JSX factory the templates compile through. The repo's
  // shared options are layered on top so `apps/web` keeps the same strictness as everything
  // else — `noUncheckedIndexedAccess` and `exactOptionalPropertyTypes` included.
  "extends": "astro/tsconfigs/strict",
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "verbatimModuleSyntax": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "noEmit": true,

    // `/admin/import` runs the CLI importer's own pure modules (`E10-29`). They are plain `.mjs`,
    // so `allowJs` lets TypeScript infer their types from the source itself rather than from a
    // hand-written declaration that could quietly drift from what the functions actually return —
    // which, for the code deciding what an import will do, is the last place drift belongs.
    "allowJs": true,
    "paths": { "@bulk-import/*": ["../../tools/bulk-import/src/*"] },

    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "exactOptionalPropertyTypes": true,
    "forceConsistentCasingInFileNames": true,

    // The browser half: the enquiry form's progressive enhancement runs in a document.
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "types": ["astro/client", "node"]
  },
  "include": [
    ".astro/types.d.ts",
    "src/**/*.ts",
    "src/**/*.astro",
    "*.mjs",
    "scripts/**/*.mjs",
    "../../tools/bulk-import/src/*.mjs"
  ],
  "exclude": ["dist", "node_modules"]
}
