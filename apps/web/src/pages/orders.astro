---
/**
 * Orders across every kitchen, with money — `E10-08`.
 *
 * A different surface from `/kitchen` on purpose, not the same one with a flag. The kitchen board
 * selects no money column at all, because `orders.view_financials` is a separate grant from
 * `orders.view` (`D3`) and a policy filters rows, never columns — so the column list *is* the
 * redaction. Two pages with two column lists means the kitchen path cannot leak a total by
 * mistake: the columns are not in the query it sends.
 *
 * `noindex`, like every back-office page.
 */
import BackofficeShell from '../components/BackofficeShell.astro';

import '../styles/tokens.css';
import '../styles/site.css';
import '../styles/backoffice.css';
---

<!doctype html>
<html lang="en-IN">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <title>Orders — GrayBag</title>
    <link rel="preload" href="/fonts/nunito-latin-var.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="icon" href="/img/favicon.png" type="image/png" sizes="64x64" />
  </head>

  <body>
    <BackofficeShell
      current="/orders"
      title="Orders"
      subtitle="Move between days · filter · open one for the detail"
    >
      <!--
        The day switcher stays in the header, where the prototype puts it: moving between days is
        the thing this screen is for, and burying it in the body would make the most-used control
        the least reachable.
      -->
      <div slot="actions" class="daynav">
        <button class="daynav__step" id="o-prev" type="button" aria-label="Previous day">‹</button>
        <div class="daynav__label">
          <p class="daynav__date" id="o-date-label">—</p>
          <p class="daynav__count" id="o-count">—</p>
        </div>
        <button class="daynav__step" id="o-next" type="button" aria-label="Next day">›</button>
        <button class="btn btn--ghost btn--sm daynav__today" id="o-today" type="button" hidden>Today</button>
      </div>
      <a slot="actions" class="btn btn--ghost" href="/kitchen/sheet">Packing sheet</a>
      <button id="o-export" slot="actions" class="btn btn--ghost" type="button">Export CSV</button>
      <button id="o-reload" slot="actions" class="btn btn--ghost" type="button">Refresh</button>

      <!--
        The filter line, in the prototype's `.toolbar` — `E10-70`.

        This screen had no filters at all. At three schools an unfiltered day is readable; the
        moment there are ten it is a wall, and the question somebody actually arrives with is
        "what did Amity take today" or "which orders were cancelled". The chips are rendered from
        the day's own data, so a school with nothing on this day does not offer a filter that
        would return an empty page.
      -->
      <div class="toolbar" id="o-toolbar" hidden>
        <div class="chips" id="o-schools" role="group" aria-label="Filter by school"></div>
        <div class="chips" id="o-states" role="group" aria-label="Filter by status"></div>
      </div>

      <div class="pad">
        <div id="o-status" class="visually-hidden" role="status" aria-live="polite"></div>
        <div id="o-banner"></div>
        <div id="o-summary"></div>
        <div id="o-board"></div>
      </div>
    </BackofficeShell>

    <script>
      import { mountShell } from '../lib/backoffice/shell.js';
      import { api, money } from '@graybag/shared';
      import { configureBackofficeApi } from '../lib/backoffice/session.js';
      import { requireBackofficeAccess } from '../lib/backoffice/guard.js';
      import { describeDate, serviceDateToday, shiftDate } from '../lib/kitchen/view.js';
      import { ORDERS_FIXTURE } from '../lib/admin/orders-fixture.js';
      import { downloadCsv, ordersToCsv } from '../lib/admin/csv-export.js';

      const $ = <T extends HTMLElement>(id: string) => document.getElementById(id) as T;
      const el = {
        dateLabel: $('o-date-label'), count: $('o-count'), today: $<HTMLButtonElement>('o-today'),
        banner: $('o-banner'), summary: $('o-summary'), board: $('o-board'),
        status: $('o-status'), reload: $<HTMLButtonElement>('o-reload'),
        toolbar: $('o-toolbar'), schools: $('o-schools'), states: $('o-states'),
        exportCsv: $<HTMLButtonElement>('o-export'),
      };

      const esc = (s: string) =>
        s.replace(/[&<>"']/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' })[c]!);

      const today = serviceDateToday(new Date());
      /*
       * The demo state — `E10-63`. Without it this route redirects to `/signin`, which is what
       * let it ship unstyled: `parity-shot` photographed and measured the sign-in page and
       * reported the route as fine. It reads no session and signs nobody out.
       */
      const demo = new URLSearchParams(location.search).has('state');
      let serviceDate = today;
      let orders: api.AdminOrder[] = [];
      // Capabilities, not a grant list: the platform owner holds no rows (`E02-39`) and the
      // money column would silently disappear for the one account that may see everything.
      let access: api.Capabilities = api.capabilities([]);
      let loading = true;
      let error: string | null = null;

      /*
       * Filters live in the URL — `E10-70`.
       *
       * A filtered day is a thing somebody sends to somebody else ("look at Gem today"), and a
       * filter held only in memory makes that impossible; it also loses the view on a refresh,
       * which is the button most used on this page. Same reasoning, and the same shape, as the
       * dish workbench's query.
       */
      const params = new URLSearchParams(location.search);
      let schoolFilter = params.get('school') ?? 'all';
      let statusFilter = params.get('status') ?? 'all';

      function syncUrl(): void {
        const next = new URLSearchParams(location.search);
        for (const [key, value] of [['school', schoolFilter], ['status', statusFilter]] as const) {
          if (value === 'all') next.delete(key); else next.set(key, value);
        }
        const query = next.toString();
        history.replaceState(null, '', query ? `?${query}` : location.pathname);
      }

      /** The day, narrowed to what the chips ask for. */
      const filtered = (): api.AdminOrder[] =>
        orders.filter((o) =>
          (schoolFilter === 'all' || o.schoolId === schoolFilter) &&
          (statusFilter === 'all' || o.status === statusFilter));

      const filtering = () => schoolFilter !== 'all' || statusFilter !== 'all';

      /*
       * `aria-pressed` carries the selected state and `<b>` carries the count, because that is what
       * `.bo .chip` already styles. Inventing `.chip--on` and `.chip__n` here would be a second
       * vocabulary for a thing the design system names once — the exact failure `E10-55` existed
       * to end.
       */
      function chip(group: string, value: string, label: string, current: string, count: number): string {
        return (
          `<button class="chip" type="button" ` +
            `data-filter="${esc(group)}" data-value="${esc(value)}" ` +
            `aria-pressed="${current === value}">` +
            `${esc(label)} <b>${count}</b>` +
          `</button>`
        );
      }

      /**
       * The chips, built from the day's own orders.
       *
       * A school with nothing today does not get a chip: offering a filter whose only possible
       * result is an empty page is offering somebody a way to confuse themselves. The counts are
       * on the chips for the same reason — "Gem 0" would be a chip you can see is pointless, and
       * a chip that is not there is better than one that is.
       *
       * Each dimension counts against the **other** filter in force, so the numbers add up to
       * what you would actually see if you pressed it.
       */
      function renderFilters(): void {
        if (loading || error || orders.length === 0) { el.toolbar.hidden = true; return; }
        el.toolbar.hidden = false;

        const byStatus = orders.filter((o) => statusFilter === 'all' || o.status === statusFilter);
        const schools = new Map<string, { name: string; n: number }>();
        for (const o of byStatus) {
          const entry = schools.get(o.schoolId) ?? { name: o.schoolName || 'Unknown school', n: 0 };
          entry.n += 1;
          schools.set(o.schoolId, entry);
        }

        el.schools.innerHTML =
          chip('school', 'all', 'All schools', schoolFilter, byStatus.length) +
          [...schools.entries()]
            .sort((a, b) => a[1].name.localeCompare(b[1].name))
            .map(([id, s]) => chip('school', id, s.name, schoolFilter, s.n))
            .join('');

        const bySchool = orders.filter((o) => schoolFilter === 'all' || o.schoolId === schoolFilter);
        const statuses = new Map<string, number>();
        for (const o of bySchool) statuses.set(o.status, (statuses.get(o.status) ?? 0) + 1);

        el.states.innerHTML =
          chip('status', 'all', 'Any status', statusFilter, bySchool.length) +
          [...statuses.entries()]
            .sort((a, b) => a[0].localeCompare(b[0]))
            .map(([code, n]) => chip('status', code, STATUS_WORD[code] ?? code, statusFilter, n))
            .join('');
      }

      const STATUS_WORD: Record<string, string> = {
        draft: 'Draft', pending_payment: 'Awaiting payment', paid: 'Paid',
        preparing: 'Making', delivered: 'Delivered', cancelled: 'Cancelled', refunded: 'Refunded',
      };

      async function load() {
        loading = true; error = null; render();
        if (demo) {
          orders = ORDERS_FIXTURE;
          // Every control shown, for the same reason the demo sidebar reveals every link: this is
          // what the a11y gate and the parity shot walk, and a screen filtered down to nothing
          // leaves the money column untested.
          access = api.capabilities(['orders.view', 'orders.view_financials']);
          loading = false; render();
          return;
        }
        try {
          configureBackofficeApi();
          [orders, access] = await Promise.all([
            api.fetchAdminOrders(serviceDate),
            api.fetchMyCapabilities(),
          ]);
        } catch (cause) {
          error = cause instanceof Error ? cause.message : 'The order list did not load.';
          orders = [];
        } finally {
          loading = false;
          render();
        }
      }

      /** School, then break — the two things somebody scanning a day actually groups by. */
      function bySchool(list: api.AdminOrder[]) {
        const groups = new Map<string, { name: string; orders: api.AdminOrder[] }>();
        for (const order of list) {
          const key = order.schoolId || 'unknown';
          if (!groups.has(key)) groups.set(key, { name: order.schoolName || 'Unknown school', orders: [] });
          groups.get(key)!.orders.push(order);
        }
        return [...groups.values()].sort((a, b) => a.name.localeCompare(b.name));
      }

      function render() {
        el.dateLabel.textContent = describeDate(serviceDate, today);
        el.today.hidden = serviceDate === today;

        /**
         * The money grant is checked before anything is drawn.
         *
         * This is `ux-spec` §5.21's N3 — "you can't see this" — and it must never render as N1,
         * "nothing here". An admin without `orders.view_financials` seeing an empty page would
         * reasonably conclude there were no orders, and act on that.
         */
        if (!loading && !access.has('orders.view_financials')) {
          el.count.textContent = '—';
          el.summary.innerHTML = '';
          el.board.innerHTML =
            `<div class="empty"><h2>You can see orders, not money</h2>` +
            `<p>This page shows totals and refunds, which needs the <b>orders.view_financials</b> ` +
            `permission. Your account does not have it. There may well be orders today — this is ` +
            `about what you may see, not about whether there are any.</p>` +
            `<a class="btn" href="/kitchen">Go to the kitchen board</a></div>`;
          return;
        }

        if (loading) {
          el.count.textContent = 'Loading…';
          el.board.innerHTML = Array(4).fill('<div class="sk"></div>').join('');
          return;
        }

        if (error) {
          el.count.textContent = '—';
          el.summary.innerHTML = '';
          el.board.innerHTML =
            `<div class="empty"><h2>We can't reach the order list</h2>` +
            `<p>${esc(error)}</p>` +
            `<button class="btn" data-retry>Try again</button></div>`;
          return;
        }

        renderFilters();

        const shown = filtered();
        const t = api.totalsFor(shown);
        el.count.textContent = shown.length === 0
          ? 'No orders'
          : `${t.orders} order${t.orders === 1 ? '' : 's'} · ${bySchool(shown).length} schools` +
            (filtering() ? ` of ${orders.length}` : '');

        /*
         * "Nobody ordered" and "nothing matches your filters" are different facts and must not
         * share a screen — §5.21 again. The first is about the day and the second is about the
         * chips, and only one of them has anything you can do about it.
         */
        if (shown.length === 0) {
          el.summary.innerHTML = '';
          el.board.innerHTML = orders.length === 0
            ? `<div class="empty"><h2>Nobody ordered on this day</h2>` +
              `<p>Not an error — there are simply no orders for ` +
              `${esc(describeDate(serviceDate, today))}. If that is unexpected, check the cutoff ` +
              `for that date rather than assuming the board is broken.</p></div>`
            : `<div class="empty"><h2>No orders match these filters</h2>` +
              `<p>There ${orders.length === 1 ? 'is' : 'are'} <b>${orders.length}</b> order` +
              `${orders.length === 1 ? '' : 's'} on this day — none of them with the filters you ` +
              `have set.</p>` +
              `<button class="btn" type="button" data-clear-filters>Clear filters</button></div>`;
          return;
        }

        el.summary.innerHTML =
          `<section class="kitchen__summary" aria-label="Money for the day">` +
            `<p class="kitchen__counts">` +
              `<span><b>${money.formatPaise(t.grossPaise)}</b> taken</span>` +
              `<span><b>${money.formatPaise(t.refundedPaise)}</b> refunded</span>` +
              `<span><b>${money.formatPaise(t.netPaise)}</b> net</span>` +
              (t.cancelled ? `<span><b>${t.cancelled}</b> cancelled</span>` : '') +
            `</p>` +
          `</section>`;

        el.board.innerHTML = bySchool(shown)
          .map((group) => {
            const gt = api.totalsFor(group.orders);
            return (
              `<section class="kitchen__group">` +
                `<header class="kitchen__group-head">` +
                  `<div class="kitchen__group-who">` +
                    `<p class="kitchen__group-class">${esc(group.name)}</p>` +
                    `<p class="kitchen__group-where">${group.orders.length} order${group.orders.length === 1 ? '' : 's'}</p>` +
                  `</div>` +
                  `<p class="kitchen__progress">${money.formatPaise(gt.netPaise)}</p>` +
                `</header>` +
                `<table >` +
                  `<thead><tr>` +
                    `<th scope="col">Order</th><th scope="col">Child</th><th scope="col">Class</th>` +
                    `<th scope="col">Status</th><th scope="col" class="num">Total</th>` +
                    `<th scope="col" class="num">Refunded</th>` +
                  `</tr></thead>` +
                  `<tbody>` +
                    group.orders.map((o) =>
                      `<tr>` +
                        `<td class="otable__ref">${esc(o.orderRef)}</td>` +
                        `<td>${esc(o.recipientName)}</td>` +
                        `<td>${esc([o.classLabel, o.sectionLabel].filter(Boolean).join('-'))}` +
                          `${o.breakLabel ? ` · ${esc(o.breakLabel)}` : ''}</td>` +
                        `<td>${esc(STATUS_WORD[o.status] ?? o.status)}</td>` +
                        `<td class="num">${money.formatPaise(o.totalPaise)}</td>` +
                        `<td class="num">${o.refundedPaise ? money.formatPaise(o.refundedPaise) : '—'}</td>` +
                      `</tr>`,
                    ).join('') +
                  `</tbody>` +
                `</table>` +
              `</section>`
            );
          })
          .join('');

        /**
         * Said once, at the bottom, rather than as a disabled button on every row.
         *
         * `E10-08` asks for refund capability and there is no refund endpoint: `order-lifecycle`
         * §4.1 performs `cancelled -> refunded` as `system` only, and nothing performs it.
         * A greyed-out "Refund" on 34 rows would suggest the feature exists and is merely
         * unavailable to you, which is a different and wronger thing to say.
         */
        el.board.innerHTML +=
          `<p class="notice notice--info">` +
            `Refunds are not issued from here yet — no endpoint exists to move money. ` +
            `<b>Cancelling an order on the kitchen board does not refund anyone either.</b> ` +
            `See docs/kitchen-write-contract.md §2.2.` +
          `</p>`;
      }

      el.board.addEventListener('click', (event) => {
        const target = event.target as HTMLElement;
        if (target.closest('[data-retry]')) void load();
        if (target.closest('[data-clear-filters]')) {
          schoolFilter = 'all'; statusFilter = 'all'; syncUrl(); render();
        }
      });

      /*
       * One listener on the toolbar rather than one per chip, because the chips are re-rendered on
       * every filter change — a listener bound to a button that is about to be replaced is a leak
       * and a bug in the same line.
       *
       * Filtering is client-side and re-renders without re-reading: the day is already in memory,
       * and a round trip to narrow a list you are holding is a round trip on a school-gate
       * connection for no new information.
       */
      el.toolbar.addEventListener('click', (event) => {
        const chip = (event.target as HTMLElement).closest<HTMLElement>('[data-filter]');
        if (!chip) return;
        const value = chip.dataset.value ?? 'all';
        if (chip.dataset.filter === 'school') schoolFilter = value;
        else statusFilter = value;
        syncUrl();
        render();
      });

      /**
       * The file is built from the rows on screen, filters included.
       *
       * A second read would export a different set from the one being looked at — and the person
       * exporting has just narrowed the day to the thing they care about. A file that quietly
       * disagrees with the screen it came from is worse than no export.
       */
      el.exportCsv.addEventListener('click', () => {
        const shown = filtered();
        if (shown.length === 0) return;
        const schoolName = schoolFilter === 'all'
          ? null
          : shown[0]?.schoolName ?? null;
        downloadCsv(
          ordersToCsv(shown, {
            serviceDate,
            schoolName,
            status: statusFilter === 'all' ? null : statusFilter,
          }),
          `graybag-orders-${serviceDate}.csv`,
        );
      });

      el.reload.addEventListener('click', () => void load());
      $('o-prev').addEventListener('click', () => { serviceDate = shiftDate(serviceDate, -1); void load(); });
      $('o-next').addEventListener('click', () => { serviceDate = shiftDate(serviceDate, 1); void load(); });
      el.today.addEventListener('click', () => { serviceDate = today; void load(); });

      void (async () => {
        // Same guard as `/kitchen`: a signed-out visitor is sent to sign in rather than shown an
        // empty page that looks like a day with no orders. The demo state is exempt — it is the
        // whole point of it, and it is why this route could not be verified before.
        try {
          if (demo) { await load(); return; }
          // The gate, not a session check — `E10-73`. An account that reaches no screen
          // is signed out at the door rather than shown a frame it cannot fill.
          if (!(await requireBackofficeAccess('/orders'))) return;
        } catch {
          /* An unconfigured build falls through to the error state below. */
        }
        await load();
      })();
    void mountShell();
    </script>
  </body>
</html>
