---
/**
 * The kitchen dashboard (`E09-04`, `E09-05`).
 *
 * A static shell hosting one client-side island. The marketing site stays `output: 'static'` and
 * ships zero JavaScript; this page is the exception, and it is an exception on one route rather
 * than a change of architecture. Reads will go through the Supabase client with the operator's
 * own JWT (`A4` permits reads); writes go through an Edge Function.
 *
 * **It is `noindex`.** Not secret — the data behind it is protected server-side by RLS and
 * always will be — but a kitchen tool has no business in a search result, and `E12-06`'s sign-in
 * does not exist yet.
 *
 * Today it runs against `fixtureTransport`. The two things it needs from the server —
 * `mark-delivered` and back-office sign-in — belong to another thread, so the screen is built and
 * reviewable now and the swap is one line in the script below.
 */
import BackofficeShell from '../components/BackofficeShell.astro';

import '../styles/tokens.css';
import '../styles/site.css';
import '../styles/kitchen.css';
import '../styles/backoffice.css';

import { CANCEL_REASONS } from '../lib/kitchen/types.js';
---

<!doctype html>
<html lang="en-IN">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <title>Kitchen — GrayBag</title>
    <link rel="preload" href="/fonts/nunito-latin-var.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="icon" href="/img/favicon.png" type="image/png" sizes="64x64" />
  </head>

  <body>
    <!--
      The kitchen board is on the shell too — `E10-61`.
      See the note above `.bo--board` in `backoffice.css` for why the frame is shared and the
      board's own layout is not.
    -->
    <BackofficeShell
      current="/kitchen"
      title="Kitchen"
      subtitle="Today's orders, what to cook, and handing food over"
    >
      <header class="kitchen__bar">
        <div class="kitchen__bar-inner">
          <div class="daynav">
            <button class="daynav__step" id="k-prev" type="button" aria-label="Previous day">‹</button>
            <div class="daynav__label">
              <p class="daynav__date" id="k-date-label">—</p>
              <p class="daynav__count" id="k-count">—</p>
            </div>
            <button class="daynav__step" id="k-next" type="button" aria-label="Next day">›</button>
            <button class="kitchen__btn daynav__today" id="k-today" type="button" hidden>Today</button>
          </div>

          <!--
            The filters live behind one line, not in two rows of chips.

            Eleven chips wrapped to two rows cost 108px of a sticky bar that already cost 212 —
            about a third of a kitchen tablet spent on controls nobody touches once service
            starts. The summary says what is selected ("Lunch break · Amity · Any status") and
            opens the chips on tap.

            `aria-expanded` and `aria-controls` are what make this a disclosure rather than a
            mystery button, and the chips keep their own `role="group"` labels when open.
          -->
          <button id="k-filter-toggle" class="kitchen__btn kitchen__filterline" type="button"
                  aria-expanded="false" aria-controls="k-filters">
            <span id="k-filter-summary">All orders</span>
            <span class="kitchen__filterline-caret" aria-hidden="true">▾</span>
          </button>

          <!--
            `aria-label` because the visible word is `display: none` on a phone and the glyph beside
            it is `aria-hidden` — which left the button with **no accessible name at all** at 390px.
            The a11y gate caught it; nothing in the visual review would have. The label matches the
            visible text at the widths where there is visible text, so `label-in-name` still holds.
          -->
          <button id="k-reload" class="kitchen__btn kitchen__refresh" type="button" aria-label="Refresh">
            <span class="kitchen__refresh-word">Refresh</span>
            <span class="kitchen__refresh-glyph" aria-hidden="true">↻</span>
          </button>

          <!--
            Beside Refresh, not after the filters. The bar is a grid whose second line belongs to
            the filter chips, and placing the nav after them put it on a row of its own — 60px of
            a sticky bar `E09-37` had just cut from 270 to 136, for one button.
          -->

          <div class="kitchen__filters" id="k-filters" hidden></div>
        </div>
      </header>

      <main class="kitchen__wrap">
        <!-- Announced to a screen reader when it changes; the visual state is in the cards. -->
        <div id="k-status-line" class="visually-hidden" role="status" aria-live="polite"></div>
        <div id="k-banner"></div>
        <div id="k-summary"></div>
        <div id="k-board"></div>
      </main>
    </BackofficeShell>

    <!--
      A real dialog, not `window.prompt`.

      The prompt asked the operator to "Enter 1-4" and blocked the page while it waited. A native
      `<dialog>` brings the focus trap, Esc-to-close and the inert backdrop with it, so none of
      that is hand-rolled.

      The warning is the important part, and half of it is now obsolete: since `E09-38` the parent
      **is** emailed, with the sentence typed below. What is still true is that **no money moves** —
      `orders.refund` is a separate grant and a separate act, and a kitchen that presses this
      believing it has refunded somebody leaves a parent who has paid and has no food.

      The typed detail is required rather than optional. An optional explanation, on a screen used
      in a hurry, is an empty one — and this one is not for us, it is the whole content of the
      message a parent receives.
    -->
    <!--
      The undo strip. Fixed to the bottom so it is thumb-reachable on a tablet and never shifts
      the list under a finger that is already moving toward the next row.
    -->
    <div id="k-undo" class="kundo" hidden>
      <p class="kundo__what" role="status" aria-live="polite"></p>
      <button type="button" class="kitchen__btn kundo__btn" id="k-undo-btn">Undo</button>
    </div>

    <dialog id="k-cancel" class="kdialog" aria-labelledby="k-cancel-title">
      <form method="dialog" class="kdialog__form">
        <h2 id="k-cancel-title" class="kdialog__title">Cancel this order?</h2>
        <p class="kdialog__who" id="k-cancel-who"></p>

        <div class="kdialog__warn" role="note">
          <b>This does not refund anyone.</b> Cancelling records that the food was not delivered
          and why, and <b>emails the person who ordered</b>. No money moves — a refund is a
          separate action.
        </div>

        <fieldset class="kdialog__reasons">
          <legend>Why?</legend>
          {CANCEL_REASONS.map((r, i) => (
            <label class="kdialog__reason">
              <input type="radio" name="reason" value={r.code} checked={i === 0} />
              <span>{r.label}</span>
            </label>
          ))}
        </fieldset>

        <!--
          The typed detail. `required` and `minlength` are on the element, so the browser refuses
          the submit and points at the field without any of this being hand-rolled — and the Edge
          Function refuses it again, which is the check that holds.

          The label says where the words go. Somebody who knows a parent will read this writes a
          different sentence from somebody filling in an internal field, and that difference is
          the entire value of the box.
        -->
        <div class="kdialog__detail">
          <label class="kdialog__detail-label" for="k-cancel-detail">
            What happened? <span class="kdialog__detail-hint">Sent to the person who ordered, in your words.</span>
          </label>
          <textarea
            class="kdialog__detail-input"
            id="k-cancel-detail"
            name="detail"
            rows="3"
            required
            minlength="4"
            maxlength="500"
            placeholder="The van broke down and we could not get to the school in time."
          ></textarea>
        </div>

        <div class="kdialog__actions">
          <!--
            `formnovalidate`, or the required detail field blocks the way *out* of the dialog:
            constraint validation runs on `method="dialog"` submits too, so backing out would have
            demanded an explanation for the cancellation you decided not to make.
          -->
          <button type="submit" value="" class="kitchen__btn" formnovalidate>Keep the order</button>
          <button type="submit" value="cancel" class="kitchen__btn kitchen__btn--danger" id="k-cancel-go">
            Cancel the order
          </button>
        </div>
      </form>
    </dialog>

    <script>
      import { mountShell } from '../lib/backoffice/shell.js';
      import { fixtureTransport } from '../lib/kitchen/fixture.js';
      import { liveTransport } from '../lib/kitchen/live.js';
      import { requireBackofficeAccess } from '../lib/backoffice/guard.js';
      import { CANCEL_REASONS, MIN_CANCEL_DETAIL } from '../lib/kitchen/types.js';
      import type { KitchenAction, KitchenDay, KitchenFilters, KitchenStatus } from '../lib/kitchen/types.js';
      import {
        STATUS_LABEL,
        allowedActions,
        applyFilters,
        boardState,
        allergenBadges,
        countLine,
        filterSummary,
        serviceDateToday,
        describeDate,
        filterOptions,
        groupByClass,
        groupByDish,
        shiftDate,
        groupProgress,
        groupState,
        productionTotals,
        summarise,
      } from '../lib/kitchen/view.js';

      /**
       * The one line that changes when the server exists.
       *
       * `PUBLIC_KITCHEN_TRANSPORT=live` will select a Supabase-backed implementation once
       * `mark-delivered` and `E12-06`'s sign-in are built. Until then everything below runs
       * against fixtures, which is what makes every state reachable in review.
       */
      // The kitchen's date, never UTC and never the device's — see `serviceDateToday`.
      const today = serviceDateToday(new Date());

      /**
       * Every state is reachable deliberately, via `?state=`.
       *
       * This is the clickable prototype's control rail, applied to a working tool and for the
       * same reason: the states nobody designs are the ones you can only reach by breaking
       * something. A guard that has never been shown to fail is worth nothing, and "the offline
       * banner works" is not a claim anyone should have to take on trust.
       *
       *   ?state=loading   ?state=empty      ?state=offline
       *   ?state=fail      ?state=forbidden  ?state=readonly   ?state=unreachable
       */
      const forced = new URLSearchParams(location.search).get('state');

      const PERMISSION_SETS = {
        forbidden: { viewOrders: false, markDelivered: false, cancelOrders: false },
        // A porter who hands food over but may not cancel: cancelling triggers a refund, and
        // `orders.cancel` is a separate grant precisely so it can be withheld (`D3`, `E09-09`).
        readonly: { viewOrders: true, markDelivered: false, cancelOrders: false },
      } as const;

      const permissions =
        forced === 'forbidden' ? PERMISSION_SETS.forbidden
        : forced === 'readonly' ? PERMISSION_SETS.readonly
        : undefined;

      /**
       * Fixtures or the real server, chosen once.
       *
       * `PUBLIC_KITCHEN_TRANSPORT=live` points at staging through the `api/` module; anything
       * else uses generated data, which is what keeps every `?state=` reachable and what lets a
       * clean checkout run with no server at all. A forced state always implies fixtures — you
       * cannot ask the real server for a failure on demand.
       */
      const useLive = import.meta.env.PUBLIC_KITCHEN_TRANSPORT === 'live' && !forced;
      const fixture = fixtureTransport(today, permissions);
      if (forced === 'fail') fixture.failNext();
      const transport = useLive ? liveTransport() : fixture;

      const $ = <T extends HTMLElement>(id: string) => document.getElementById(id) as T;
      const el = {
        prev: $<HTMLButtonElement>('k-prev'), next: $<HTMLButtonElement>('k-next'),
        todayBtn: $<HTMLButtonElement>('k-today'), dateLabel: $('k-date-label'),
        count: $('k-count'), filters: $('k-filters'), reload: $<HTMLButtonElement>('k-reload'),
        banner: $('k-banner'), summary: $('k-summary'), board: $('k-board'), live: $('k-status-line'),
      };

      /**
       * The current selection, as state rather than as DOM.
       *
       * Named `sel` and not `state` on purpose: the render functions already carry a `state`
       * from `boardState`, and shadowing it made `state.breakId` typecheck against the board
       * union — which is the kind of collision that compiles in a dynamic language and does not
       * here, gratefully.
       */
      const filterToggle = $<HTMLButtonElement>('k-filter-toggle');
      const filterSummaryEl = $('k-filter-summary');

      const undoStrip = $('k-undo');
      const undoWhat = undoStrip.querySelector('.kundo__what') as HTMLElement;
      const undoBtn = $<HTMLButtonElement>('k-undo-btn');

      const cancelDialog = $<HTMLDialogElement>('k-cancel');
      const cancelWho = $('k-cancel-who');
      const cancelDetail = $<HTMLTextAreaElement>('k-cancel-detail');

      const sel = { serviceDate: today, schoolId: '', breakId: '', status: '' };

      /**
       * Which question the board is answering: "what goes to this classroom" or "how many of
       * these do I make".
       *
       * Not persisted. A shared kitchen tablet is picked up by whoever is next, and a toggle
       * left on `dish` by the person plating is a surprise for the person doing the handover.
       * Each visit starts on the handover view, which is the one the day ends in.
       */
      let grouping: 'class' | 'dish' = 'class';

      let day: KitchenDay | null = null;
      let loading = true;
      let error: string | null = null;
      /** Orders with a write in flight. Optimistic, but visibly so. */
      const busy = new Set<string>();

      const filters = (): KitchenFilters => ({
        serviceDate: sel.serviceDate,
        schoolId: sel.schoolId || null,
        breakId: sel.breakId || null,
        status: (sel.status || null) as KitchenStatus | null,
      });

      const esc = (s: string) =>
        s.replace(/[&<>"']/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' })[c]!);

      const say = (message: string) => { el.live.textContent = message; };

      const time = (iso: string) =>
        new Date(iso).toLocaleTimeString([], { hour: '2-digit', minute: '2-digit' });

      // ------------------------------------------------------------------ load

      async function load(): Promise<KitchenDay | null> {
        // Any pending write goes before a reload, or the fresh list would arrive without it and
        // the optimistic status would be overwritten by the stale one from the server.
        await flushPending();
        loading = true;
        error = null;
        render();
        try {
          day = await transport.load(filters());
        } catch (cause) {
          // Keep whatever was on screen. A kitchen mid-service would rather have the 07:12 list
          // than an error page, and `boardState` renders it as explicitly stale.
          error = cause instanceof Error ? cause.message : 'Could not reach the server.';
        } finally {
          loading = false;
          render();
        }
        return day;
      }

      // ---------------------------------------------------------------- update

      /**
       * The undo window, and why it defers the write rather than reversing it.
       *
       * Gmail's "Undo Send" does not recall a sent mail — it holds the send for a few seconds and
       * cancels it if you press undo. That distinction is the whole design here, because the
       * lifecycle has **no reverse tuple**: `preparing -> paid` does not exist for any actor, so
       * a write that has happened cannot be taken back client-side at all.
       *
       * Deferring needs no new tuple, no migration and no server change. If undo is pressed, the
       * request was never sent and there is nothing in the audit trail to explain — which is also
       * more honest than recording a mistake that never reached anybody.
       *
       * It is deliberately the *first* of the three layers in
       * `docs/kitchen-write-contract.md` §1, because a finger landing on the wrong button and
       * being noticed immediately is the overwhelming majority of mis-taps. The other two layers
       * are corrections after the fact and genuinely need the server.
       *
       * **One pending batch at a time.** A second action flushes the first rather than queueing
       * beside it: two windows running at once means two rollback states to reason about, and it
       * bounds how stale the server can be to a single window.
       */
      const UNDO_WINDOW_MS = 10_000;

      /** What `askWhyCancelled` resolves with — `E09-38`. Both halves reach the customer. */
      interface CancelReason {
        code: string;
        /** Typed by the operator, sent verbatim in the cancellation email. */
        detail: string;
      }

      interface Pending {
        orderIds: string[];
        to: KitchenAction;
        // `| undefined` rather than `?:` — `exactOptionalPropertyTypes` distinguishes "absent"
        // from "present and undefined", and this is built by spreading a value that may be either.
        reasonCode: string | undefined;
        /** What the operator typed. Sent to the customer verbatim (`E09-38`). */
        reasonDetail: string | undefined;
        /** The statuses to restore on undo — the real ones, from before the optimistic change. */
        previous: Map<string, KitchenStatus>;
        timer: ReturnType<typeof setTimeout>;
        tick: ReturnType<typeof setInterval>;
        deadline: number;
      }

      let pending: Pending | null = null;

      /**
       * Orders this session moved and then let past the undo window.
       *
       * Memory only, and deliberately: it is about what *you* just did, so it should not survive
       * a reload any more than the undo window does. Holds ids, never anything about the child.
       */
      const committed = new Set<string>();

      function queueUpdate(
        orderIds: string[], to: KitchenAction, reasonCode?: string, reasonDetail?: string,
      ) {
        if (!orderIds.length || !day) return;

        // Whatever was waiting goes now. Its window is over the moment attention moves on.
        void flushPending();

        const previous = new Map(day.orders.map((o) => [o.id, o.status] as const));
        day = { ...day, orders: day.orders.map((o) => (orderIds.includes(o.id) ? { ...o, status: to } : o)) };

        const deadline = Date.now() + UNDO_WINDOW_MS;
        pending = {
          orderIds, to, reasonCode, reasonDetail, previous, deadline,
          timer: setTimeout(() => void flushPending(), UNDO_WINDOW_MS),
          // Anchored to a deadline rather than counted down, for the same reason the OTP resend
          // is: a backgrounded tab stops firing intervals, and a kitchen tablet is backgrounded
          // constantly. The timeout above is what actually fires; this only draws the number.
          tick: setInterval(renderUndo, 250),
        };

        render();
      }

      /** Send the pending write, if there is one. Returns when the server has answered. */
      async function flushPending(): Promise<void> {
        const p = pending;
        if (!p) return;
        clearTimeout(p.timer);
        clearInterval(p.tick);
        pending = null;
        renderUndo();

        p.orderIds.forEach((id) => busy.add(id));
        render();

        try {
          await transport.updateStatus(
            p.reasonCode
              ? {
                  orderIds: p.orderIds, to: p.to, reasonCode: p.reasonCode,
                  ...(p.reasonDetail ? { reasonDetail: p.reasonDetail } : {}),
                }
              : { orderIds: p.orderIds, to: p.to },
          );
          if (p.to !== 'cancelled') p.orderIds.forEach((id) => committed.add(id));
          say(`${p.orderIds.length} order${p.orderIds.length === 1 ? '' : 's'} marked ${STATUS_LABEL[p.to].toLowerCase()}.`);
        } catch (cause) {
          // Roll back and say so loudly. A write that silently does nothing is the worst thing
          // this screen can do: the tray leaves, the record does not, and nobody finds out until
          // a parent asks.
          day = day ? { ...day, orders: day.orders.map((o) => ({ ...o, status: p.previous.get(o.id) ?? o.status })) } : day;
          error = cause instanceof Error ? cause.message : 'That change did not save.';
          say('That change did not save. Nothing was recorded.');
        } finally {
          p.orderIds.forEach((id) => busy.delete(id));
          render();
        }
      }

      /**
       * Draw the strip. Called on a short interval while a window is open, so the number moves.
       *
       * The message sits in the live region and the seconds do not: announcing "9… 8… 7…" to a
       * screen reader would bury the one sentence that matters under a countdown.
       */
      function renderUndo() {
        if (!pending) {
          undoStrip.hidden = true;
          undoWhat.textContent = '';
          return;
        }
        const left = Math.max(0, Math.ceil((pending.deadline - Date.now()) / 1000));
        const n = pending.orderIds.length;
        const verb = pending.to === 'cancelled' ? 'cancelled' : STATUS_LABEL[pending.to].toLowerCase();
        undoStrip.hidden = false;
        const next = `${n} order${n === 1 ? '' : 's'} ${pending.to === 'preparing' ? 'started' : verb}`;
        // Only rewrite when the sentence itself changes, so the live region announces once
        // instead of on every tick.
        if (undoWhat.textContent !== next) undoWhat.textContent = next;
        undoBtn.textContent = `Undo (${left})`;
      }

      /** Take it back. Nothing was sent, so there is nothing to reverse. */
      function undoPending() {
        const p = pending;
        if (!p || !day) return;
        clearTimeout(p.timer);
        clearInterval(p.tick);
        pending = null;

        day = { ...day, orders: day.orders.map((o) => ({ ...o, status: p.previous.get(o.id) ?? o.status })) };
        say(`Undone. ${p.orderIds.length} order${p.orderIds.length === 1 ? '' : 's'} unchanged.`);
        renderUndo();
        render();
      }

      undoBtn.addEventListener('click', undoPending);

      /**
       * A pending write must never be lost by leaving the page.
       *
       * `visibilitychange` is the reliable one on a tablet — `beforeunload` is not guaranteed to
       * run when an app is backgrounded or the tab is killed. Both are here because they fail in
       * different situations, and a deferred write that never happens is exactly the silent
       * no-op this screen is otherwise careful to avoid.
       */
      document.addEventListener('visibilitychange', () => {
        if (document.visibilityState === 'hidden') void flushPending();
      });
      window.addEventListener('pagehide', () => void flushPending());

      // ---------------------------------------------------------------- render

      function renderBanner(offline: boolean, state: ReturnType<typeof boardState>) {
        const parts: string[] = [];
        if (state.kind === 'stale') {
          parts.push(
            `<div class="kitchen__banner" data-tone="warning"><span aria-hidden="true">⚠</span><div>` +
              `<b>You are offline.</b> This is the list loaded at ${esc(time(state.loadedAt))}. ` +
              `Marking orders needs a connection — the buttons are off until it comes back.` +
              `</div></div>`,
          );
        }
        if (day && day.permissions.viewOrders && !day.permissions.markDelivered) {
          // Said once, plainly. Buttons that are simply absent leave somebody hunting for a
          // control that was never there, and concluding the tool is broken.
          parts.push(
            `<div class="kitchen__banner" data-tone="info"><span aria-hidden="true">i</span><div>` +
              `<b>You can see the list but not change it.</b> This account does not hold ` +
              `<b>orders.mark_delivered</b>. Ask an administrator if you need to hand food over.` +
              `</div></div>`,
          );
        }
        if (error && day) {
          parts.push(
            `<div class="kitchen__banner" data-tone="danger"><span aria-hidden="true">✕</span><div>` +
              `<b>That change did not save.</b> ${esc(error)} Nothing was recorded — try again.` +
              `</div></div>`,
          );
        }
        el.banner.innerHTML = parts.join('');
      }

      /**
       * "To cook" is dropped entirely in the dish grouping.
       *
       * It lists "10 Paneer Wrap, 9 Rajma Chawal…" — which is precisely what the group headers
       * below already say, one per block, in bigger type and next to the orders they belong to.
       * Keeping both costs about 180px of a 1080px screen to say the same thing twice.
       *
       * It stays in the class grouping, where the per-dish totals genuinely appear nowhere else:
       * grouped by class, nothing on the screen tells you how many wraps to make.
       */
      function renderSummary(state: ReturnType<typeof boardState>) {
        if (grouping === 'dish') { el.summary.innerHTML = ''; return; }
        if (!day || (state.kind !== 'data' && state.kind !== 'stale')) { el.summary.innerHTML = ''; return; }
        const visible = applyFilters(day.orders, filters());
        const totals = productionTotals(visible);
        const s = summarise(visible);

        // One row: what to make, then how the day stands. It scrolls sideways rather than
        // wrapping, so its height is fixed however many dishes are on the menu — the card used
        // to be 178px of a 1080px screen and is now about 80.
        el.summary.innerHTML =
          `<section class="kitchen__summary" aria-label="To cook${
            sel.breakId ? `, ${esc(day?.breaks.find((b) => b.id === sel.breakId)?.label ?? '')}` : ''
          }">` +
            // `tabindex="0"` because it scrolls sideways: a scrollable region with nothing
            // focusable inside it cannot be reached by keyboard at all, so the dishes past the
            // right edge would be unreadable without a mouse. Labelled, so it is not an
            // anonymous tab stop.
            `<div class="kitchen__totals" role="group" aria-label="Dishes to cook" tabindex="0">` +
              totals
                .map((t) => `<div class="kitchen__total"><b>${t.quantity}</b><span>${esc(t.dishName)}</span></div>`)
                .join('') +
            `</div>` +
            `<p class="kitchen__counts">` +
              `<span><b>${s.items}</b> items</span>` +
              `<span><b>${s.outstanding}</b> to hand over</span>` +
              `<span><b>${s.delivered}</b> delivered</span>` +
              (s.cancelled ? `<span><b>${s.cancelled}</b> cancelled</span>` : '') +
            `</p>` +
          `</section>`;
      }

      function renderBoard(state: ReturnType<typeof boardState>, offline: boolean) {
        if (state.kind === 'loading') {
          el.board.innerHTML = Array(4).fill('<div class="kitchen__skeleton"></div>').join('');
          return;
        }
        if (state.kind === 'unreachable') {
          el.board.innerHTML =
            `<div class="kitchen__state"><h2>We can't reach the order list</h2>` +
            `<p>${esc(state.message)} Nothing is wrong with today's orders — this is our side. ` +
            `If it stays down, the printed list is the fallback.</p>` +
            `<button class="kitchen__btn kitchen__btn--primary" data-retry>Try again</button></div>`;
          return;
        }
        if (state.kind === 'forbidden') {
          // §5.21 N3. An empty list here would read as "no orders today" — the worst possible
          // misreading in a kitchen, because the response to it is that nobody cooks.
          el.board.innerHTML =
            `<div class="kitchen__state"><h2>Your account cannot see orders</h2>` +
            `<p>You are signed in, but this account does not have permission to view orders for ` +
            `this kitchen. That is a settings problem, not a problem with today's orders — ask an ` +
            `administrator to grant <b>orders.view</b>.</p></div>`;
          return;
        }
        if (state.kind === 'empty-day') {
          el.board.innerHTML =
            `<div class="kitchen__state"><h2>No orders for this day</h2>` +
            `<p>Nobody has ordered for ${esc(describeDate(sel.serviceDate, today))}. That is a real answer, ` +
            `not a failure — ` +
            `check the date if you were expecting some.</p></div>`;
          return;
        }
        if (state.kind === 'empty-filter') {
          el.board.innerHTML =
            `<div class="kitchen__state"><h2>Nothing matches these filters</h2>` +
            `<p>There are orders today, but none with the school, break and status you have chosen.</p>` +
            `<button class="kitchen__btn" data-clear>Clear filters</button></div>`;
          return;
        }

        if (grouping === 'dish') {
          el.board.innerHTML = renderDishGroups(state.groups.flatMap((g) => g.orders), offline);
          return;
        }

        el.board.innerHTML = state.groups
          .map((g) => {
            const canAct = !offline && g.outstandingIds.length > 0 && Boolean(day?.permissions.markDelivered);
            return (
              `<section class="kitchen__group" data-state="${groupState(g)}" aria-labelledby="h-${esc(g.key)}">` +
                `<header class="kitchen__group-head">` +
                  `<div class="kitchen__group-who">` +
                    `<p class="kitchen__group-class" id="h-${esc(g.key)}">Class ${esc(g.classLabel)}</p>` +
                    `<p class="kitchen__group-where">${esc(g.schoolName)}${g.breakLabel ? ` · ${esc(g.breakLabel)}` : ''}</p>` +
                  `</div>` +
                  `<p class="kitchen__progress">${esc(groupProgress(g))}</p>` +
                  (day?.permissions.markDelivered
                    ? `<button class="kitchen__btn kitchen__btn--primary" data-group="${esc(g.key)}" ${canAct ? '' : 'disabled'}>` +
                        `Mark all delivered${g.outstandingIds.length ? ` (${g.outstandingIds.length})` : ''}` +
                      `</button>`
                    : '') +
                `</header>` +
                g.orders.map(renderOrder(offline)).join('') +
              `</section>`
            );
          })
          .join('');
      }

      /**
       * One line: the dish, the quantity, and the parent's request if there is one.
       *
       * The note sits **against its own line**, not against the order. "Less spicy" on one wrap
       * and not the other is the case §5.6.1 designed the field around, and an order-level note
       * cannot express it. It is given a block of its own rather than a parenthetical because
       * the whole justification for the field existing is that the kitchen actually reads it.
       *
       * Labelled "Request", which is what it is. Not a safety record and never an allergy — the
       * app routes that language into the child's profile — and the label is what stops an
       * operator reading a blank line as "no allergies".
       */
      const renderLine = (l: KitchenDay['orders'][number]['lines'][number]) =>
        `<li class="kline">` +
          `<span class="kline__qty">${l.quantity}</span>` +
          `<span class="kline__dish">${esc(l.dishName)}</span>` +
          (l.note
            ? `<span class="kline__note"><b>Request</b> ${esc(l.note)}</span>`
            : '') +
        `</li>`;

      /**
       * Allergen badges beside the child's name — `E09-33`.
       *
       * The kitchen is the last human in the chain: they hand a physical bag to a named child,
       * and until now they were told nothing. Codes only, from the enumerated table. No parent
       * note, no severity, no medical detail.
       *
       * **"Not provided" is rendered, never nothing.** Blank space beside a name reads as "no
       * allergies" to anyone who has not read this comment, and that is the one thing this must
       * never say by accident (`ux-spec` §5.21).
       */
      const renderAllergens = (codes: string[] | null) => {
        const badges = allergenBadges(codes);
        if (!badges) return `<span class="kallergen kallergen--none">No allergies provided</span>`;
        return badges.map((b) => `<span class="kallergen">${esc(b)}</span>`).join('');
      };

      const renderOrder = (offline: boolean) => (o: KitchenDay['orders'][number]) => {
        const actions = allowedActions(o.status, day?.permissions);
        const label = { preparing: 'Start', delivered: 'Delivered', cancelled: 'Cancel' } as const;
        return (
          `<div class="kitchen__order" data-busy="${busy.has(o.id)}">` +
            `<div class="kitchen__child">` +
              `<ul class="kline-list">${o.lines.map(renderLine).join('')}</ul>` +
              `<p class="kitchen__name">${esc(o.recipientName)}` +
                renderAllergens(o.allergenCodes) +
              `</p>` +
            `</div>` +
            `<span class="kitchen__pill" data-status="${o.status}">` +
              `<span aria-hidden="true">${({ paid: '○', preparing: '◐', delivered: '✓', cancelled: '✕' })[o.status]}</span>` +
              `${STATUS_LABEL[o.status]}` +
            `</span>` +
            `<div class="kitchen__actions">` +
              actions
                .map((a) =>
                  // `Delivered` is the action taken on all but a handful of orders in a service,
                  // and it was one of three identical buttons. Ranking it is the difference
                  // between reading a row and hitting the right thing in one look.
                  `<button class="kitchen__btn${a === 'delivered' ? ' kitchen__btn--primary kitchen__act--main' : ''}${a === 'cancelled' ? ' kitchen__btn--danger' : ''}" ` +
                  `data-order="${o.id}" data-action="${a}" ${offline || busy.has(o.id) ? 'disabled' : ''}>` +
                  `${label[a]}<span class="visually-hidden"> ${esc(o.recipientName)}</span></button>`,
                )
                .join('') +
              /**
               * What can still be corrected, said where the mistake happens.
               *
               * The ten-second undo window (`E09-29`) catches the common case, and this covers
               * what is left: `order-lifecycle.md` §4.1 has no `preparing -> paid` tuple for any
               * actor, so once the window closes the database refuses the change and a button
               * would be a lie.
               *
               * It deliberately does **not** say "ask an admin" — that was the first wording and
               * Andy rejected it outright: at volume every mis-tap becomes a support ticket, and
               * pointing at a person is not a design. `docs/kitchen-write-contract.md` §1(b)
               * specifies the correction that replaces this line, and it is deleted when that
               * lands.
               */
              // Only on rows this session actually moved and whose undo window has closed.
              //
              // It used to render on every `preparing` or `delivered` row, which on a 24-order
              // board meant the same sentence twenty-four times — the most repeated thing on
              // the screen, about a feature that does not exist. On a row that arrived already
              // delivered from the server it was answering a question nobody had asked.
              (committed.has(o.id) && (o.status === 'preparing' || o.status === 'delivered')
                ? `<p class="kitchen__oneway">` +
                    `${o.status === 'preparing' ? 'Started' : 'Delivered'} by hand. ` +
                    `Correcting this is not built yet.` +
                  `</p>`
                : '') +
              /**
               * A cancelled order says so on the row, not only in the dialog nobody sees again.
               *
               * The operator who cancelled it read the warning; the person looking at the board
               * an hour later did not, and "Cancelled" on its own reads as finished business.
               * Deleted in the PR that lands the refund — `kitchen-write-contract.md` §2.4.
               */
              (o.status === 'cancelled'
                ? `<p class="kitchen__oneway">Not refunded — no money has moved.</p>`
                : '') +
            `</div>` +
          `</div>`
        );
      };

      /**
       * The board grouped by dish — the view somebody plating food actually wants.
       *
       * `groupByClass` answers "what goes to this classroom"; this answers "how many of these do
       * I make, and who is each one for". Same orders, same page, one toggle — a second screen
       * would be a second thing to build, test and teach for a question this one already holds
       * all the data for.
       *
       * A portion carries its own note, because the note belongs to the line and the whole point
       * of grouping by dish is that you are looking at the line when you make it.
       */
      function renderDishGroups(orders: KitchenDay['orders'], offline: boolean): string {
        const groups = groupByDish(orders);
        if (groups.length === 0) return '';

        // "5-A" is two different classes when two schools are on the board, and the dish view
        // deliberately mixes schools together — so the school is named on the portion whenever
        // there is more than one, and left off when there is only one and it would be noise.
        const manySchools = new Set(orders.map((o) => o.schoolId)).size > 1;

        return groups
          .map((g) => {
            const canAct = !offline && g.outstandingIds.length > 0 && Boolean(day?.permissions.markDelivered);
            return (
              `<section class="kitchen__group" aria-labelledby="d-${esc(g.key)}">` +
                `<header class="kitchen__group-head">` +
                  `<div class="kitchen__group-who">` +
                    `<p class="kitchen__group-class" id="d-${esc(g.key)}">` +
                      `<span class="kitchen__group-qty">${g.quantity}</span> ${esc(g.dishName)}` +
                    `</p>` +
                    `<p class="kitchen__group-where">${g.portions.length} order${g.portions.length === 1 ? '' : 's'}</p>` +
                  `</div>` +
                  (day?.permissions.markDelivered
                    ? `<button class="kitchen__btn kitchen__btn--primary" data-dish-group="${esc(g.key)}" ${canAct ? '' : 'disabled'}>` +
                        `Mark all delivered${g.outstandingIds.length ? ` (${g.outstandingIds.length})` : ''}` +
                      `</button>`
                    : '') +
                `</header>` +
                g.portions
                  .map((portion) =>
                    `<div class="kitchen__order" data-busy="${busy.has(portion.orderId)}">` +
                      `<div class="kitchen__child">` +
                        `<ul class="kline-list"><li class="kline">` +
                          `<span class="kline__qty">${portion.quantity}</span>` +
                          `<span class="kline__dish">${esc(portion.classLabel)}</span>` +
                          (portion.note
                            ? `<span class="kline__note"><b>Request</b> ${esc(portion.note)}</span>`
                            : '') +
                        `</li></ul>` +
                        `<p class="kitchen__name">${esc(portion.recipientName)}` +
                          `${manySchools ? ` · ${esc(portion.schoolName)}` : ''}` +
                          `${portion.breakLabel ? ` · ${esc(portion.breakLabel)}` : ''}</p>` +
                      `</div>` +
                      `<span class="kitchen__pill" data-status="${portion.status}">` +
                        `<span aria-hidden="true">${({ paid: '○', preparing: '◐', delivered: '✓', cancelled: '✕' })[portion.status]}</span>` +
                        `${STATUS_LABEL[portion.status]}` +
                      `</span>` +
                    `</div>`,
                  )
                  .join('') +
              `</section>`
            );
          })
          .join('');
      }

      /**
       * The secondary filters, drawn as chips rather than dropdowns.
       *
       * A chip shows its state without being opened, which is the whole complaint about a row of
       * selects reading "All": you cannot tell what you are looking at. They are also a single
       * tap at 56px, and a dropdown on a tablet with wet hands is two interactions and a
       * scrolling list.
       *
       * Anything with fewer than two options is not drawn — an inert control is worse than none.
       */
      /**
       * The school's name when exactly one has orders today, else `null`.
       *
       * `filterOptions` hides the school chips in that case, and a board that is silently scoped
       * to one school out of three is a board where "24 orders" means the wrong thing. The name
       * moves into the count line rather than becoming a chip nobody can press.
       */
      const soleSchoolName = (): string | null => {
        const { schools, showSchools } = filterOptions(day);
        return !showSchools && schools.length === 1 ? (schools[0]?.name ?? null) : null;
      };

      /** The collapsed line, and whether the chips are open. */
      let filtersOpen = false;

      function renderFilterLine() {
        const { schools, breaks } = filterOptions(day);
        filterSummaryEl.textContent = filterSummary(filters(), { schools, breaks });
        filterToggle.setAttribute('aria-expanded', String(filtersOpen));
        el.filters.hidden = !filtersOpen;
        // A set filter is worth seeing at a glance even while collapsed, so the line inverts the
        // way a selected chip does rather than looking like every other button on the bar.
        filterToggle.dataset.filtered = String(
          Boolean(sel.schoolId || sel.breakId || sel.status),
        );
      }

      filterToggle.addEventListener('click', () => {
        filtersOpen = !filtersOpen;
        renderFilterLine();
      });

      function renderFilters() {
        const options = filterOptions(day);
        const group = (
          label: string,
          key: 'schoolId' | 'breakId' | 'status',
          items: { id: string; label: string }[],
          allLabel: string,
        ) =>
          `<div class="chips" role="group" aria-label="${esc(label)}">` +
            [{ id: '', label: allLabel }, ...items]
              .map((item) =>
                `<button class="chip" type="button" data-filter="${key}" data-value="${esc(item.id)}" ` +
                `aria-pressed="${sel[key] === item.id}">${esc(item.label)}</button>`,
              )
              .join('') +
          `</div>`;

        const parts: string[] = [];

        /**
         * The grouping toggle leads the row, before any filter.
         *
         * It changes what the board *is* rather than what it shows, so it is not a filter and is
         * separated from them. Same chip shape because it behaves the same way — one tap, its
         * state visible without being opened.
         */
        parts.push(
          `<div class="chips" role="group" aria-label="Group the list by">` +
            ([['class', 'By class'], ['dish', 'By dish']] as const)
              .map(([value, text]) =>
                `<button class="chip" type="button" data-grouping="${value}" ` +
                `aria-pressed="${grouping === value}">${text}</button>`,
              )
              .join('') +
          `</div>`,
        );

        if (options.showSchools) {
          parts.push(group('School', 'schoolId', options.schools.map((s2) => ({ id: s2.id, label: s2.name })), 'All schools'));
        }
        if (options.showBreaks) {
          parts.push(group('Break', 'breakId', options.breaks.map((b) => ({ id: b.id, label: b.label })), 'All breaks'));
        }
        parts.push(
          group('Status', 'status', [
            { id: 'paid', label: STATUS_LABEL.paid },
            { id: 'preparing', label: STATUS_LABEL.preparing },
            { id: 'delivered', label: STATUS_LABEL.delivered },
            { id: 'cancelled', label: STATUS_LABEL.cancelled },
          ], 'Any status'),
        );
        el.filters.innerHTML = parts.join('');
      }

      function renderDay(board: ReturnType<typeof boardState>) {
        el.dateLabel.textContent = describeDate(sel.serviceDate, today);
        el.todayBtn.hidden = sel.serviceDate === today;

        const visible = day ? applyFilters(day.orders, filters()) : [];
        el.count.textContent =
          board.kind === 'loading' ? 'Loading…'
          : board.kind === 'unreachable' || board.kind === 'forbidden' ? '—'
          : countLine(visible, groupByClass(visible), soleSchoolName());
      }

      function render() {
        const offline = forced === 'offline' || !navigator.onLine;
        const state = boardState({
          day: forced === 'empty' && day ? { ...day, orders: [] } : day,
          filters: filters(),
          loading: loading || forced === 'loading',
          offline,
          error: forced === 'unreachable' ? 'Simulated: the server did not respond.' : error,
        });
        renderDay(state);
        renderUndo();
        renderFilters();
        renderFilterLine();
        renderBanner(offline, state);
        renderSummary(state);
        renderBoard(state, offline);
      }

      // ----------------------------------------------------------------- wiring

      el.board.addEventListener('click', async (event) => {
        const target = (event.target as HTMLElement).closest('button');
        if (!target || !day) return;

        if (target.hasAttribute('data-retry')) return load();
        if (target.hasAttribute('data-clear')) {
          sel.schoolId = ''; sel.breakId = ''; sel.status = '';
          return render();
        }

        const dishKey = target.getAttribute('data-dish-group');
        if (dishKey) {
          const state = boardState({ day, filters: filters(), loading, offline: !navigator.onLine, error });
          const visible = state.kind === 'data' || state.kind === 'stale' ? state.groups.flatMap((g) => g.orders) : [];
          const group = groupByDish(visible).find((g) => g.key === dishKey);
          if (group) queueUpdate(group.outstandingIds, 'delivered');
          return;
        }

        const groupKey = target.getAttribute('data-group');
        if (groupKey) {
          const state = boardState({ day, filters: filters(), loading, offline: !navigator.onLine, error });
          const group = (state.kind === 'data' || state.kind === 'stale' ? state.groups : []).find((g) => g.key === groupKey);
          if (group) queueUpdate(group.outstandingIds, 'delivered');
          return;
        }

        const orderId = target.getAttribute('data-order');
        const action = target.getAttribute('data-action') as KitchenAction | null;
        if (!orderId || !action) return;

        if (action === 'cancelled') {
          // A cancellation without a reason loses *why* the food was not delivered, and the
          // schema will not take one — `cancel_reason_code` is how a refund is later explained.
          const reason = await askWhyCancelled(orderId);
          if (!reason) return;
          return queueUpdate([orderId], 'cancelled', reason.code, reason.detail);
        }

        queueUpdate([orderId], action);
      });

      /**
       * Ask why, and return the code **and the typed sentence** — or `null` if the operator
       * backed out.
       *
       * The child's name goes into the dialog so the operator can see who they are cancelling
       * for, and is written with `textContent` rather than into the markup: it is tier P, and it
       * is the one string on this screen that comes from a person rather than from us.
       */
      function askWhyCancelled(orderId: string): Promise<CancelReason | null> {
        const order = day?.orders.find((o) => o.id === orderId);
        cancelWho.textContent = order
          ? `${order.recipientName} · ${order.lines.map((l) => `${l.quantity} × ${l.dishName}`).join(', ')}`
          : '';

        // Cleared on every open. A sentence left over from the previous cancellation would be
        // sent, unread, to a different parent about a different order.
        cancelDetail.value = '';

        cancelDialog.showModal();
        return new Promise((resolve) => {
          cancelDialog.addEventListener(
            'close',
            () => {
              // `returnValue` is the submit button's `value`. Esc and the backdrop both close
              // with an empty one, so backing out and "Keep the order" are the same path.
              if (cancelDialog.returnValue !== 'cancel') return resolve(null);
              const chosen = cancelDialog.querySelector<HTMLInputElement>('input[name=reason]:checked');
              const detail = cancelDetail.value.trim();
              // The browser will not submit with an empty required field, so reaching here with
              // one means validation was bypassed. Treat it as backing out rather than sending a
              // parent an empty explanation.
              if (!chosen?.value || detail.length < MIN_CANCEL_DETAIL) return resolve(null);
              resolve({ code: chosen.value, detail });
            },
            { once: true },
          );
        });
      }

      el.filters.addEventListener('click', (event) => {
        const target = event.target as HTMLElement;

        // The grouping toggle lives in this row but is not a filter — it changes what the board
        // is, not what it shows. Handled first, because the filter branch below returns early on
        // anything without `data-filter` and would swallow it.
        const grouped = target.closest<HTMLElement>('[data-grouping]')?.dataset.grouping;
        if (grouped === 'class' || grouped === 'dish') {
          grouping = grouped;
          return render();
        }

        const chip = target.closest<HTMLElement>('[data-filter]');
        if (!chip) return;
        const key = chip.dataset.filter as 'schoolId' | 'breakId' | 'status';
        sel[key] = chip.dataset.value ?? '';
        render();
      });

      const goToDate = (iso: string) => {
        sel.serviceDate = iso;
        void load();
      };
      el.prev.addEventListener('click', () => goToDate(shiftDate(sel.serviceDate, -1)));
      el.next.addEventListener('click', () => goToDate(shiftDate(sel.serviceDate, 1)));
      el.todayBtn.addEventListener('click', () => goToDate(today));
      el.reload.addEventListener('click', load);
      window.addEventListener('online', render);
      window.addEventListener('offline', render);

      // ------------------------------------------------------------------ start

      void (async () => {
        // Signed out against the real server is not an empty kitchen — it is a locked door, and
        // §5.21's N3 says the two must never look alike. Fixtures need no session.
        // The gate, not a session check — `E10-73`. An account that reaches no screen
        // is signed out at the door rather than shown a frame it cannot fill.
        if (useLive && !(await requireBackofficeAccess('/kitchen'))) return;
        // Populate the filter options from the first load rather than from `day`: TypeScript
        // cannot see an assignment made inside `load()` from out here, and narrowing a
        // module-level `let` across an await is exactly where that analysis gives up.
        // The bar renders itself from whatever the day contains, so there is nothing to
        // populate here — which is also why a school appearing tomorrow needs no code change.
        await load();
      })();
    void mountShell();
    </script>
  </body>
</html>
