---
/**
 * Today — the status page, not the launcher — `E10-67`.
 *
 * ## What this replaced, and why
 *
 * `E10-43` built this as fourteen cards, one per route, each with the one-line description
 * `nav.ts` holds. That was right for the complaint it answered — Andy: *"I need to find and paste
 * URL endpoints"* — and it stopped being right the moment `E10-55` put a persistent sidebar on
 * every screen. A second navigation underneath the first is a screen spent saying nothing, and it
 * was the first thing anyone saw every morning.
 *
 * The prototype's Today is a **status page**: what is blocking orders, what today has taken, what
 * needs a person, and what the kitchen is doing right now. That is the question this URL is
 * actually opened with.
 *
 * ## Assembled from reads other screens already make
 *
 * Nothing here is a new source of truth and nothing here is a control. Every figure is derived
 * from data RLS has already scoped, and every line says where to go and fix what it names — the
 * page's whole job is to be the shortest path to the screen that can do something.
 *
 * ## Panels are independent, and a panel that cannot be read says so
 *
 * Six reads behind five different grants. A kitchen operator legitimately cannot read most of
 * them, and a failed read must not blank the page — so each panel is fetched, gated and rendered
 * on its own, and one failing leaves the others standing.
 *
 * **A number that could not be read is never rendered as zero.** `ux-spec` §5.21, and here it is
 * load-bearing: "₹0 today" is a sentence somebody would act on. See `Panel` in `today.ts`.
 */
import BackofficeShell from '../components/BackofficeShell.astro';

import '../styles/tokens.css';
import '../styles/site.css';
import '../styles/backoffice.css';
---

<!doctype html>
<html lang="en-IN">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <title>Today — GrayBag</title>
    <link rel="preload" href="/fonts/nunito-latin-var.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="icon" href="/img/favicon.png" type="image/png" sizes="64x64" />
  </head>

  <body>
    <BackofficeShell
      current="/dashboard"
      title="Today"
      subtitle="What needs you, and what the kitchen is doing"
    >
      <button id="d-reload" slot="actions" class="btn btn--ghost" type="button">Refresh</button>

      <div class="pad">
        <div id="d-status" class="visually-hidden" role="status" aria-live="polite"></div>
        <div id="d-banner"></div>
        <div id="d-cards"></div>
        <div id="d-board"></div>
        <div id="d-nothing"></div>
      </div>
    </BackofficeShell>

    <script>
      import { api, money } from '@graybag/shared';

      import { mountShell } from '../lib/backoffice/shell.js';
      import { reachable } from '../lib/backoffice/gate.js';
      import { requireBackofficeAccess } from '../lib/backoffice/guard.js';
      import { describeDate, serviceDateToday } from '../lib/kitchen/view.js';
      import { schoolMenuRows } from '../lib/admin/catalogue-view.js';
      import { readiness } from '../lib/admin/school-readiness.js';
      import { TODAY_FIXTURE, TODAY_FIXTURE_GRANTS } from '../lib/admin/today-fixture.js';
      import {
        attention, boardRows, dishesBlockingOrders, ordersToday, packsToday, revenueToday,
        isShown, sortBoard, readable, unreadable, withheld,
        type AttentionItem, type BlockingDishes, type BoardRow, type OrdersToday,
        type PacksToday, type Panel, type RevenueToday,
      } from '../lib/admin/today.js';

      const $ = (id: string) => document.getElementById(id)!;
      const esc = (s: string) =>
        s.replace(/[&<>"']/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' })[c]!);

      const demo = new URLSearchParams(location.search).has('state');
      const today = serviceDateToday(new Date());

      /**
       * Every panel starts **withheld**, with the reason kept for the code rather than the screen.
       *
       * It used to start `unreadable('Needs orders.view_financials.')` and render that sentence,
       * which was the bug Andy caught on 2026-09-02: the page introduced itself to an account
       * with no access by listing the four things it was not going to show it, and named the
       * grant behind each one. *"Other employees (kitchen) can't know that we track reports,
       * access, even revenue using this web dashboard."*
       *
       * So a panel this account may not have is **absent**, not explained. A panel it may have
       * and we failed to fetch is still explained — see `Panel` in `today.js` for why those two
       * must not share a rendering.
       */
      const NO_GRANT = (grant: string) => `Needs ${grant}.`;

      let blocking: Panel<BlockingDishes> = withheld(NO_GRANT('menu.edit'));
      let orders: Panel<OrdersToday> = withheld(NO_GRANT('orders.view'));
      let revenue: Panel<RevenueToday> = withheld(NO_GRANT('orders.view_financials'));
      let packs: Panel<PacksToday> = withheld(NO_GRANT('meal_packs.manage'));
      let needs: Panel<AttentionItem[]> = withheld(NO_GRANT('school.edit'));
      let board: Panel<BoardRow[]> = withheld(NO_GRANT('orders.view'));
      let loading = true;
      /** What this account can open, for the empty state. Set once the gate has answered. */
      let elsewhere: { href: string; label: string }[] = [];
      /** The last capabilities we successfully read. Never downgraded by a failed refresh. */
      let held: api.Capabilities | null = null;

      /* ------------------------------------------------------------------ rendering */

      /**
       * A card, or nothing at all.
       *
       * Three outcomes, not two:
       *
       *  - **withheld** — no card. Not a placeholder, not a dash, not a title. A heading reading
       *    "Revenue today" over an explanation is still the sentence "we track revenue".
       *  - **failed** — the card, with why in place of the figure. Never a zero: "₹0 today" is
       *    something somebody would act on, and this reader is entitled to the real number.
       *  - **readable** — the figure.
       */
      function card(
        title: string, panel: Panel<unknown>,
        show: (value: never) => { k: string; m: string }, kind = '',
      ): string {
        if (!isShown(panel)) return '';
        const body = panel.readable
          ? (() => {
              const { k, m } = show(panel.value as never);
              return `<div class="k">${k}</div><div class="m">${m}</div>`;
            })()
          : `<div class="k k--none">—</div><div class="m">${esc(panel.why)}</div>`;
        return `<div class="card${kind}"><h4>${esc(title)}</h4>${body}</div>`;
      }

      function renderBanner(): void {
        // Only when there is something to say. A banner that is always present is furniture.
        if (!blocking.readable || blocking.value.count === 0) {
          $('d-banner').innerHTML = '';
          return;
        }
        const b = blocking.value;
        const shown = b.names.slice(0, 3).map(esc).join(', ');
        const rest = b.names.length > 3 ? `, and ${b.names.length - 3} more` : '';
        $('d-banner').innerHTML =
          `<div class="notice notice--warn">` +
            `<b class="notice__head">${b.count} dish${b.count === 1 ? '' : 'es'} on a live menu ` +
            `${b.count === 1 ? 'has' : 'have'} no veg or non-veg marking</b>` +
            `A parent cannot tell what they are ordering. ${shown}${rest}` +
            (b.schools.length ? ` — on ${b.schools.map(esc).join(', ')}` : '') +
            `. <a href="/admin/dishes?type=unset">Set them in Dishes</a>, filtered to the ones ` +
            `that need it.` +
          `</div>`;
      }

      function renderCards(): void {
        const cards =
            card('Orders today', orders, (o: OrdersToday) => ({
              k: String(o.total),
              m: o.total === 0
                ? 'Nothing ordered for today yet.'
                : Object.entries(o.byStatus)
                    .map(([status, n]) => `${n} ${esc(status)}`).join(' · '),
            })) +
            card('Revenue today', revenue, (r: RevenueToday) => ({
              k: money.formatPaise(r.netPaise),
              m:
                `${money.formatPaise(r.grossPaise)} taken` +
                (r.refundedPaise > 0 ? ` · ${money.formatPaise(r.refundedPaise)} refunded` : '') +
                (r.cancelled > 0 ? ` · ${r.cancelled} cancelled, not counted` : '') +
                // Stated rather than silently omitted — see `revenueToday`'s note. A meal paid
                // from a pack sits in a table no back-office account may read (`E21-63`).
                `<br>Meals paid from a pack are not separated out yet`,
            })) +
            card('Packs sold', packs, (p: PacksToday) => ({
              k: String(p.packsSold),
              m: p.packsSold === 0
                ? `${p.liveOffers} offer${p.liveOffers === 1 ? '' : 's'} live · none sold yet`
                : `${money.formatPaise(p.collectedPaise)} collected · ${p.mealsSold} meals sold`,
            })) +
            card('Needs you', needs, (items: AttentionItem[]) => ({
              k: String(items.length),
              m: items.length === 0
                ? 'Nothing is blocking an order.'
                : items.slice(0, 3).map((i) =>
                    esc(i.text) +
                    (i.fix ? ` <a href="${esc(i.fix.href)}">${esc(i.fix.label)}</a>` : ''),
                  ).join('<br>') +
                  (items.length > 3 ? `<br>and ${items.length - 3} more` : ''),
            }), needs.readable && needs.value.length > 0 ? ' card--warn' : '');

        // No grid when there are no cards. An empty four-column grid is a visible gap that reads
        // as something that failed to load.
        $('d-cards').innerHTML = cards === '' ? '' : `<div class="grid">${cards}</div>`;
      }

      function renderBoard(): void {
        // Withheld: no section, no heading. "Kitchen, right now — not visible to this account"
        // still tells the reader there is a live kitchen board in here, which is the disclosure.
        if (!isShown(board)) {
          $('d-board').innerHTML = '';
          return;
        }

        if (!board.readable) {
          $('d-board').innerHTML =
            `<div class="sec">Kitchen, right now</div>` +
            `<div class="empty"><h2>That did not load</h2><p>${esc(board.why)}</p></div>`;
          return;
        }

        const rows = sortBoard(board.value);
        if (rows.length === 0) {
          $('d-board').innerHTML =
            `<div class="sec">Kitchen, right now</div>` +
            `<div class="empty"><h2>Nothing for today</h2>` +
            `<p>No orders have been placed for ${esc(today)}. That is a real answer, not a ` +
            `failed read — the kitchen list would be empty too.</p></div>`;
          return;
        }

        $('d-board').innerHTML =
          `<div class="sec">Kitchen, right now</div>` +
          rows.map((r) => {
            const done = r.status === 'delivered';
            const off = r.status === 'cancelled';
            return (
              `<div class="gate ${done ? 'gate--pass' : off ? 'gate--fail' : 'gate--warn'}">` +
                `<div class="ic" aria-hidden="true">${done ? '✓' : off ? '×' : '·'}</div>` +
                `<div class="t">${esc(r.recipientName)}` +
                  (r.classLabel ? ` · Class ${esc(r.classLabel)}` : '') +
                  `<span>${esc(r.schoolName)}` +
                    (r.breakLabel ? ` · ${esc(r.breakLabel)}` : '') +
                    ` · ${r.items} item${r.items === 1 ? '' : 's'}` +
                    // `null` is "you may not see money", which is not the same as ₹0 — a
                    // pack-paid meal is genuinely zero, and the two must not read alike.
                    (r.totalPaise === null ? '' : ` · ${money.formatPaise(r.totalPaise)}`) +
                  `</span></div>` +
                `<span class="tag tag--${done ? 'live' : 'draft'}">${esc(r.status)}</span>` +
              `</div>`
            );
          }).join('');
      }

      /**
       * When every panel is withheld, say something true rather than nothing at all.
       *
       * A school viewer holds `reports.view` and nothing else: no order count, no money, no
       * packs, no board. Every one of those is correctly absent, and the result would be a page
       * with a title and a blank — the *"is this broken?"* state `ux-spec` §5.21 exists to
       * prevent, arrived at from the opposite direction.
       *
       * So this points at what they *can* open, taken from the same navigation they already see
       * in the sidebar. It discloses nothing: everything it names is a link they are looking at.
       */
      function renderNothing(): void {
        const anything =
          $('d-banner').innerHTML !== '' || $('d-cards').innerHTML !== '' ||
          $('d-board').innerHTML !== '' || loading;
        if (anything) { $('d-nothing').innerHTML = ''; return; }

        $('d-nothing').innerHTML =
          `<div class="empty"><h2>Nothing on Today is for you</h2>` +
          `<p>Today gathers the kitchen's day, and this account does not work on it. ` +
          (elsewhere.length > 0
            ? `What you can open is in the sidebar.</p>`
            : `</p>`) +
          elsewhere.map((item) =>
            `<a class="btn" href="${esc(item.href)}">${esc(item.label)}</a> `).join('') +
          `</div>`;
      }

      function render(): void {
        /*
         * The subtitle is the **date**, replacing the static sentence once we know which day is
         * on screen. The prototype does the same, and it is the right call: a status page whose
         * heading does not say which day it is about is one you have to trust rather than read —
         * and this is the page somebody opens at 7am to find out whether today looks right.
         */
        const sub = document.querySelector<HTMLElement>('[data-page-sub]');
        if (sub) sub.textContent = `${describeDate(today, today)} · Mohali`;

        renderBanner();
        renderCards();
        renderBoard();
        renderNothing();

        const said: string[] = [];
        if (loading) said.push('Loading today.');
        else {
          if (orders.readable) said.push(`${orders.value.total} orders today.`);
          if (needs.readable) said.push(`${needs.value.length} things need you.`);
          if (blocking.readable && blocking.value.count > 0) {
            said.push(`${blocking.value.count} dishes are blocking orders.`);
          }
        }
        $('d-status').textContent = said.join(' ');
      }

      /* ------------------------------------------------------------------ loading */

      /**
       * Run a panel's read, turning a refusal into a sentence rather than into a crash.
       *
       * Each panel is separately awaited so that one failing read leaves the rest of the page
       * standing. A screen that goes blank because the packs Edge Function is down is a screen
       * that cannot tell you the kitchen has 40 orders waiting.
       */
      async function panel<T>(
        held: boolean, grant: string, read: () => Promise<T>,
      ): Promise<Panel<T>> {
        // Not held is `withheld`, which renders nothing. Held and broken is `unreadable`, which
        // renders the reason. The read is never even attempted for the first, so a refusal never
        // reaches the network and never needs interpreting.
        if (!held) return withheld(NO_GRANT(grant));
        try {
          return readable(await read());
        } catch (cause) {
          return unreadable(cause instanceof Error ? cause.message : 'That read did not complete.');
        }
      }

      /**
       * @param known the capabilities the gate already read, on first load. Refresh passes none
       *   and re-reads them, because a grant can be revoked while a tab is open.
       */
      async function load(known?: api.Capabilities): Promise<void> {
        loading = true; render();

        /*
         * A failed capability read falls back to **what we last knew**, not to nothing.
         *
         * `.catch(() => api.capabilities([]))` was the old fallback and it is the wrong direction
         * now that an absent grant hides a panel rather than explaining it: one blink of the
         * network on Refresh and the page would silently become the "nothing here for you"
         * screen for the person who runs the kitchen.
         */
        const caps = demo
          ? api.capabilities(TODAY_FIXTURE_GRANTS)
          : known
            ?? (await api.fetchMyCapabilities().catch(() => held))
            ?? api.capabilities([]);
        held = caps;
        elsewhere = demo ? [] : reachable(caps).map((i) => ({ href: i.href, label: i.label }));

        if (demo) {
          blocking = readable(TODAY_FIXTURE.blocking);
          orders = readable(TODAY_FIXTURE.orders);
          revenue = readable(TODAY_FIXTURE.revenue);
          packs = readable(TODAY_FIXTURE.packs);
          needs = readable(TODAY_FIXTURE.attention);
          board = readable(TODAY_FIXTURE.board);
          loading = false; render();
          await mountShell();
          return;
        }

        /*
         * The catalogue reads feed two panels — the banner and half of "Needs you" — so they are
         * fetched once and shared. `readiness` needs six tables; they are small, and one parallel
         * batch costs one round trip of wall-clock rather than six.
         */
        const catalogue = caps.has('menu.edit') || caps.has('school.edit')
          ? Promise.all([
              api.fetchAdminSchools(), api.fetchMenuAssignments(), api.fetchAdminMenus(),
              api.fetchAdminDishes(), api.fetchAllBreakTimes(), api.fetchServiceDaysBySchool(),
            ]).catch(() => null)
          : Promise.resolve(null);

        const [kitchenPanel, moneyOrders, packPanel, cat] = await Promise.all([
          // Orders and the board come from ONE kitchen read. It carries the child, the break and
          // the lines and no money column at all, which is `D3`'s split and why the kitchen path
          // cannot leak a total by mistake.
          panel(caps.has('orders.view'), 'orders.view', () => api.fetchKitchenOrders(today)),
          caps.has('orders.view_financials')
            ? api.fetchAdminOrders(today).catch(() => null)
            : Promise.resolve(null),
          panel(caps.has('meal_packs.manage'), 'meal_packs.manage', async () => {
            const [offers, sold] = await Promise.all([
              api.fetchAdminPackOffers(), api.fetchPackOfferSales(),
            ]);
            return packsToday(offers, sold);
          }),
          catalogue,
        ]);

        orders = kitchenPanel.readable ? readable(ordersToday(kitchenPanel.value)) : kitchenPanel;
        board = kitchenPanel.readable
          ? readable(boardRows(kitchenPanel.value, moneyOrders))
          : kitchenPanel;
        packs = packPanel;

        revenue = !caps.has('orders.view_financials')
          ? withheld(NO_GRANT('orders.view_financials'))
          : moneyOrders === null
            ? unreadable('The money read did not complete.')
            : readable(revenueToday(moneyOrders));

        if (cat === null) {
          const entitled = caps.has('menu.edit') || caps.has('school.edit');
          // Entitled and broken says so; not entitled says nothing at all, on both panels.
          const why = entitled
            ? 'The catalogue read did not complete.'
            : NO_GRANT('menu.edit or school.edit');
          blocking = entitled ? unreadable(why) : withheld(why);
          needs = entitled ? unreadable(why) : withheld(why);
        } else {
          const [schools, assignments, menus, dishes, breaks, days] = cat;
          const rows = schoolMenuRows(schools, assignments, menus, dishes, today);
          const found = dishesBlockingOrders(rows, dishes);
          blocking = readable(found);
          needs = readable(
            attention(readiness(schools, assignments, menus, dishes, breaks, days, today), found),
          );
        }

        loading = false; render();
        await mountShell();
      }

      // Refresh re-reads capabilities as well as data, so a revoked grant takes a panel away
      // from an open tab rather than waiting for a reload.
      $('d-reload').addEventListener('click', () => void load());

      void (async () => {
        if (demo) { await load(); return; }

        /*
         * The gate, not a session check — `E10-73`.
         *
         * This used to ask only *"is anybody signed in"*, and this URL is the one people
         * bookmark, so it is where an account with no access landed and was shown the shape of
         * the system. `requireBackofficeAccess` answers the harder question and has already
         * navigated away by the time it returns `null`.
         */
        const caps = await requireBackofficeAccess('/dashboard');
        if (!caps) return;
        await load(caps);
      })();
    </script>
  </body>
</html>
