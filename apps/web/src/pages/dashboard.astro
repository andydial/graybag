---
/**
 * Where signing in lands you — `E10-43`.
 *
 * Andy: *"I should login into a dashboard and should have options to navigate to all other
 * available web screens / reports etc. Currently I need to find and paste URL endpoints to open
 * some / many of those."*
 *
 * ## Why a page and not just the bar
 *
 * The bar in `BackofficeNav.astro` carries labels. A label is enough once you know what a screen
 * is; it is not enough the first time, and it is not enough for kitchen staff who will be given an
 * account and told to get on with it. This page carries the one-line description that `nav.ts` has
 * always held for every route — what the screen is *for* — so the answer to "where do I do X" is
 * readable rather than guessable.
 *
 * It is also the honest destination for sign-in. Before this, `/signin` sent everybody to
 * `/kitchen` whatever they held, so an account with only `reports.view` landed on a screen it
 * could not read and had no way to discover the one it could.
 *
 * ## Nothing here decides access
 *
 * The cards are filtered by `fetchMyGrants()` for presentation only. Every route behind them is
 * enforced by RLS, and a card revealed in error opens a screen that refuses — which is the same
 * position we were in when there were no cards at all.
 */
import BackofficeNav from '../components/BackofficeNav.astro';
import { NAV } from '../lib/backoffice/nav.js';

import '../styles/tokens.css';
import '../styles/site.css';
import '../styles/kitchen.css';
import '../styles/admin.css';
---

<!doctype html>
<html lang="en-IN">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <title>Dashboard — GrayBag</title>
    <link rel="preload" href="/fonts/nunito-latin-var.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="icon" href="/img/favicon.png" type="image/png" sizes="64x64" />
  </head>

  <body>
    <div class="kitchen">
      <header class="kitchen__bar">
        <div class="kitchen__bar-inner kitchen__bar-inner--admin">
          <h1 class="kitchen__title">GrayBag</h1>
          <BackofficeNav current="/dashboard" />
        </div>
      </header>

      <main class="kitchen__wrap admin__wrap">
        <div id="d-status" class="visually-hidden" role="status" aria-live="polite"></div>

        <p class="admin__intro">
          Everything this account can open. Screens you do not have permission for are not listed —
          <b>ask for the permission rather than the URL</b>, because the server refuses either way.
        </p>

        <div class="dash" id="d-cards">
          {
            NAV.map((item) => (
              <a class="dash__card" href={item.href} data-nav-item data-requires={item.requires.join(' ')} hidden>
                <span class="dash__label">{item.label}</span>
                <span class="dash__desc">{item.description}</span>
              </a>
            ))
          }
        </div>

        <div class="kitchen__state" id="d-empty" hidden>
          <h2>Nothing to show you yet</h2>
          <p id="d-empty-why"></p>
        </div>
      </main>
    </div>

    <script>
      import { api } from '@graybag/shared';

      import { mountNav } from '../lib/backoffice/nav-mount.js';
      import { NAV, noAccessReason } from '../lib/backoffice/nav.js';
      import { configureBackofficeApi, currentUser } from '../lib/backoffice/session.js';

      const $ = (id: string) => document.getElementById(id)!;
      const demo = new URLSearchParams(location.search).has('state');

      /** Reveal the cards whose every required grant is held. Same rule as the bar, same data. */
      function reveal(held: ReadonlySet<string>): number {
        let shown = 0;
        for (const card of document.querySelectorAll<HTMLElement>('#d-cards [data-nav-item]')) {
          const requires = (card.dataset.requires ?? '').split(' ').filter(Boolean);
          if (requires.every((g) => held.has(g))) {
            card.hidden = false;
            shown += 1;
          }
        }
        return shown;
      }

      async function load(): Promise<void> {
        if (demo) {
          reveal(new Set(NAV.flatMap((i) => i.requires)));
          await mountNav();
          return;
        }

        configureBackofficeApi();

        // Signed out is the common case for this URL — it is the one people bookmark.
        try {
          if (!(await currentUser())) {
            location.assign(`/signin?next=${encodeURIComponent('/dashboard')}`);
            return;
          }
        } catch {
          // Fall through: a failed session read should not strand somebody on a blank page.
        }

        let held: ReadonlySet<string> = new Set();
        try {
          held = new Set(await api.fetchMyGrants());
        } catch {
          $('d-empty').hidden = false;
          $('d-empty-why').textContent =
            'We could not read this account’s permissions. Try again, and if it persists the database is unreachable.';
          await mountNav();
          return;
        }

        if (reveal(held) === 0) {
          $('d-empty').hidden = false;
          $('d-empty-why').textContent =
            noAccessReason({ name: '', grants: held as never }) ??
            'This account can open no back-office screen.';
        }

        $('d-status').textContent = `${reveal(held)} screens available.`;
        await mountNav();
      }

      void load();
    </script>
  </body>
</html>
