---
/**
 * When orders were taken — `E11-12`.
 *
 * Andy: *"Currently orders are only seen for the day the delivery is requested for, I want to see
 * sales (orders) placed for a given day. That way I can see when a large order day comes — I want
 * to be able to see growth or reduction in orders."*
 *
 * ## Why this is not a toggle on `/reports`
 *
 * The two screens read the same rows and answer opposite questions.
 *
 * `/reports` is bucketed by **service date**: what are we cooking on Thursday, and what did that
 * day earn. It is the operational and GST view, and its default range ends tomorrow because
 * tomorrow's lunch is already sold.
 *
 * This one is bucketed by **placement date**: was yesterday busy, is demand rising. Its default
 * range ends today, because a day cannot be busy in the future.
 *
 * Same numbers, different axis — and folding both into one screen behind a selector was the first
 * design considered and rejected: the two have different defaults, different comparisons and
 * different audiences, and a single screen would have to caption every figure with which basis it
 * was on. A number whose meaning depends on a control somewhere above it is how a report gets
 * quoted wrongly in a meeting.
 *
 * They cannot disagree, because both fold from one set of rows — `summarise` keys by service day,
 * placed day and school, and every view is a `groupRows` of that. A test asserts the totals match
 * across all six axes.
 *
 * ## No child appears here either
 *
 * `REPORT_ORDER_COLUMNS` gained exactly one field for this screen — `placed_at`, a business
 * timestamp. Still no recipient, class or section.
 */
import BackofficeShell from '../../components/BackofficeShell.astro';

import '../../styles/tokens.css';
import '../../styles/site.css';
import '../../styles/backoffice.css';
---

<!doctype html>
<html lang="en-IN">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <title>Sales — GrayBag</title>
    <link rel="preload" href="/fonts/nunito-latin-var.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="icon" href="/img/favicon.png" type="image/png" sizes="64x64" />
  </head>

  <body>
    <BackofficeShell
      current="/admin/sales"
      title="Sales"
      subtitle="Orders by the day they were placed"
    >
      <button id="s-reload" class="btn btn--ghost" slot="actions" type="button">Refresh</button>

        <div id="s-status" class="visually-hidden" role="status" aria-live="polite"></div>

        <p class="m">
          <b>Paid orders only</b>, by the day they were placed rather than the day the food is
          served — so a busy evening shows up on the evening it happened. Days are <b>IST</b>: an
          order taken at 11pm counts for that night, which is when most of them arrive.
          Unpaid and cancelled orders are not sales and are not counted here;
          <a href="/reports">the revenue report</a> shows them against the service date.
        </p>

        <div class="rctl">
          <div class="rctl__presets" role="group" aria-label="Range">
            <button class="chip" type="button" data-preset="7">7 days</button>
            <button class="chip" type="button" data-preset="30">30 days</button>
            <button class="chip" type="button" data-preset="90">90 days</button>
            <button class="chip" type="button" data-preset="month">This month</button>
            <button class="chip" type="button" data-preset="last">Last month</button>
          </div>

          <div class="rctl__dates">
            <label for="s-from">From</label>
            <input id="s-from" type="date" required />
            <label for="s-to">To</label>
            <input id="s-to" type="date" required />
          </div>

          <div class="rctl__group">
            <label for="s-by">Show by</label>
            <select id="s-by">
              <option value="placedDay" selected>Day</option>
              <option value="placedWeek">Week</option>
              <option value="placedMonth">Month</option>
              <option value="school">School</option>
            </select>
          </div>
        </div>

        <div class="pad" id="s-body"></div>
      </BackofficeShell>

    <script>
      import { mountShell } from '../../lib/backoffice/shell.js';
      import { api, money } from '@graybag/shared';
      import { columns } from '../../lib/admin/chart.js';
      import { configureBackofficeApi } from '../../lib/backoffice/session.js';
      import { requireBackofficeAccess } from '../../lib/backoffice/guard.js';
      import { serviceDateToday } from '../../lib/kitchen/view.js';
      import { SALES_FIXTURE } from '../../lib/admin/sales-fixture.js';
      import { PACK_MONEY_FIXTURE } from '../../lib/admin/pack-money-fixture.js';
      import { packVisibilityOf } from '../../lib/admin/pack-visibility.js';

      const $ = <T extends HTMLElement>(id: string) => document.getElementById(id) as T;
      const el = {
        body: $('s-body'), status: $('s-status'), reload: $<HTMLButtonElement>('s-reload'),
        from: $<HTMLInputElement>('s-from'), to: $<HTMLInputElement>('s-to'),
        by: $<HTMLSelectElement>('s-by'),
      };
      const esc = (s: string) =>
        String(s ?? '').replace(/[&<>"']/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' })[c]!);
      const rupees = (p: number) => money.formatPaise(p);

      const demo = new URLSearchParams(location.search).has('state');

      let rows: api.ReportRow[] = [];
      let previous: api.ReportRow[] = [];
      /**
       * Meal pack money — `E21`, `M10`.
       *
       * Kept in its own variables and rendered in its own section, never merged into the figures
       * above. A pack sale is a **liability** on the day it happens and becomes revenue one item
       * at a time, so adding it to "Net revenue" would report money we still owe in food as money
       * we have earned.
       */
      let packs: api.PackMoneyRow[] = [];
      // Starts `unreadable`: before the read runs we have no answer at all, which is exactly what
      // that state means. Starting at `visible` would flash a confident ₹0 during the first paint.
      let packVisibility: api.Visibility = 'unreadable';
      /**
       * School id to its short code — `E11-14`.
       *
       * Andy: *"instead of showing school's name — it should a like unique ID sort of label."*
       * Full names are long enough that a chart axis with three of them is unreadable, and
       * "Amity International, Mohali" beside "Gem Public School" wastes the width the bars need.
       * `school.code` is short, unique and already the identifier the importer matches on.
       *
       * The full name stays in the table and in every tooltip — the code is a label, not a
       * replacement for knowing which school it is.
       */
      let schoolCodes = new Map<string, string>();
      let loading = true;
      let error: string | null = null;

      const MONTHS = ['January', 'February', 'March', 'April', 'May', 'June',
        'July', 'August', 'September', 'October', 'November', 'December'];

      /** From the parts, never through a `Date` — `E09-32`. */
      function label(key: string, by: string): string {
        if (by === 'placedMonth') {
          const [y, m] = key.split('-');
          return `${MONTHS[Number(m) - 1] ?? key} ${y}`;
        }
        if (by === 'placedWeek') {
          const [, m, d] = key.split('-');
          return `w/c ${Number(d)} ${(MONTHS[Number(m) - 1] ?? '').slice(0, 3)}`;
        }
        if (by === 'placedDay') {
          const [, m, d] = key.split('-');
          return `${Number(d)} ${(MONTHS[Number(m) - 1] ?? '').slice(0, 3)}`;
        }
        // A school bucket's key is its id. Show the short code; fall back to the name only if the
        // code could not be read, because an unlabelled uuid on an axis is worse than a long name.
        return schoolCodes.get(key)?.toUpperCase() ?? key;
      }

      /** The full name, for tooltips and the table — the code is a label, not a substitute. */
      function fullName(b: api.Bucket, by: string): string {
        return by === 'school' ? b.label : label(b.key, by);
      }

      function shift(date: string, days: number): string {
        return new Date(Date.parse(`${date}T12:00:00Z`) + days * 86_400_000).toISOString().slice(0, 10);
      }

      function applyPreset(preset: string) {
        const today = serviceDateToday(new Date());
        const [y, m] = today.split('-').map(Number) as [number, number];
        if (preset === 'month') {
          el.from.value = `${y}-${String(m).padStart(2, '0')}-01`;
          el.to.value = today;
        } else if (preset === 'last') {
          const py = m === 1 ? y - 1 : y;
          const pm = m === 1 ? 12 : m - 1;
          el.from.value = `${py}-${String(pm).padStart(2, '0')}-01`;
          el.to.value = shift(`${y}-${String(m).padStart(2, '0')}-01`, -1);
        } else {
          el.from.value = shift(today, -(Number(preset) - 1));
          el.to.value = today;
        }
        void load();
      }

      async function load() {
        loading = true; error = null; render();
        try {
          if (demo) {
            rows = SALES_FIXTURE.rows as unknown as api.ReportRow[];
            previous = SALES_FIXTURE.previous as unknown as api.ReportRow[];
            schoolCodes = new Map(SALES_FIXTURE.schoolCodes);
            packs = PACK_MONEY_FIXTURE;
            packVisibility = 'visible';
          } else {
            configureBackofficeApi();
            const prev = api.previousWindow(el.from.value, el.to.value);
            // Both windows in one go. The comparison is the whole point of the screen, and
            // fetching it lazily would mean the headline figures arrive without their context.
            const [now, before, schools] = await Promise.all([
              api.fetchOrdersPlaced(el.from.value, el.to.value),
              api.fetchOrdersPlaced(prev.from, prev.to),
              // Codes for the axis labels. Refused reads are survivable: the chart falls back to
              // the school name, which is worse to read but never wrong.
              api.fetchAdminSchools().catch(() => []),
            ]);
            rows = now; previous = before;
            schoolCodes = new Map(schools.map((x) => [x.id, x.code]));

            /*
             * Pack money is read separately and is allowed to fail on its own — the food figures
             * are the reason this screen exists and must not be held hostage to a pack read.
             *
             * **A failed or refused read is `blind`, never zero.** `meal_pack_money` is
             * `security_invoker` over a table whose only read policy is `meal_pack_read_own`, so a
             * back-office account can legitimately get an empty list while packs exist. `E21-63`
             * is the same finding — refusing to render "0 paid with a pack" when the truth is "we
             * can't see" — and it matters more here, because ₹0 owed in food is a sentence Andy
             * would act on.
             */
            // Annotated rather than inferred: `Promise.all` over two differently-shaped
            // `.catch(() => null)` results widens to `unknown` under this tsconfig.
            const [packRows, soldByOffer]: [api.PackMoneyRow[] | null, Record<string, number> | null] =
              await Promise.all([
              api.fetchPackMoney().catch(() => null),
              // The sold COUNT comes from the Edge Function, which runs under the service role and
              // can see every pack. That makes it the discriminator below. Counts only — no owner,
              // no order, no child.
              api.fetchPackOfferSales().catch(() => null),
              ]);

            /*
             * Zero and blind are different answers, and an empty list alone cannot tell them
             * apart. `packVisibilityOf` decides, with the Edge Function's service-role count as
             * the evidence — see `pack-visibility.ts` for why that is an answer and not a guess.
             */
            packs = packRows ?? [];
            packVisibility = packVisibilityOf(packRows, soldByOffer);
          }
        } catch (cause) {
          error = cause instanceof Error ? cause.message : 'The sales figures did not load.';
          rows = []; previous = [];
        } finally {
          loading = false; render();
        }
      }

      /**
       * A figure with its change on the previous window of the same length.
       *
       * The arrow and the words carry the direction together — colour alone would fail anyone who
       * cannot distinguish it, and this is the screen whose entire job is up or down.
       */
      /** Green for a real rise, red for a real fall, and neither when it rounded to nothing. */
      function toneOf(c: api.Comparison | null): string {
        if (!c || c.change === null) return '';
        const pct = Math.round(c.change * 100);
        if (pct === 0) return '';
        return pct > 0 ? ' gstat__note--up' : ' gstat__note--down';
      }

      function stat(value: string, title: string, c: api.Comparison | null, note = ''): string {
        let delta = '';
        if (c) {
          if (c.change === null) {
            delta = c.previous === 0 && c.now > 0 ? 'first in this period' : 'nothing before';
          } else {
            const pct = Math.round(c.change * 100);
            // Rounded to nothing is "unchanged", not "▲ 0% up". An arrow claiming a direction the
            // number does not support is the kind of small dishonesty that makes a whole
            // dashboard feel approximate.
            delta = pct === 0
              ? 'about the same as the previous period'
              : `${pct > 0 ? '▲' : '▼'} ${Math.abs(pct)}% ${pct > 0 ? 'up on' : 'down on'} the previous period`;
          }
        }
        return (
          `<div class="card">` +
            `<h4>${esc(title)}</h4>` +
            `<div class="k">${esc(value)}</div>` +
            (delta ? `<div class="m">${esc(delta)}</div>` : '') +
            (note ? `<div class="m">${esc(note)}</div>` : '') +
          `</div>`
        );
      }

      function render() {
        if (loading) {
          el.body.innerHTML = Array(3).fill('<div class="sk"></div>').join('');
          return;
        }
        if (error) {
          el.body.innerHTML =
            `<div class="empty"><h2>We can't show sales</h2><p>${esc(error)}</p>` +
            `<p>This screen needs <b>reports.view</b> and <b>orders.view_financials</b>.</p>` +
            `<button class="btn" data-retry>Try again</button></div>`;
          return;
        }
        if (rows.length === 0) {
          el.body.innerHTML =
            `<div class="empty"><h2>No paid orders in this range</h2>` +
            `<p>Nothing was paid for between <b>${esc(el.from.value)}</b> and ` +
            `<b>${esc(el.to.value)}</b> — or this account cannot read orders, which needs ` +
            `<b>reports.view</b>. Those look the same from here.</p></div>`;
          return;
        }

        const by = el.by.value as api.GroupBy;
        const buckets = api.groupRows(rows, by);
        const t = api.totalOf(buckets);
        const p = api.totalOf(api.groupRows(previous, by));

        const paid = t.paid;
        const paidPrev = p.paid;
        // Average order value across the orders that were actually paid. Dividing by every order
        // placed would let a run of unpaid ones look like a fall in what people spend.
        const aov = paid === 0 ? 0 : Math.round(t.netPaise / paid);
        const aovPrev = paidPrev === 0 ? 0 : Math.round(p.netPaise / paidPrev);

        // The busiest bucket, named. "When a large order day comes" is the literal ask, and a
        // chart shows the shape without saying which one it was.
        // Busiest by **paid** orders, matching everything else on the screen.
        const best = [...buckets].sort((a, b) => b.paid - a.paid)[0];

        el.status.textContent =
          `${paid} paid orders, ${rupees(t.netPaise)} net, ` +
          `${esc(el.from.value)} to ${esc(el.to.value)}, across ${buckets.length} ${by === 'school' ? 'schools' : 'periods'}.`;

        const ordersChart = columns(
          buckets.map((b) => ({
            label: label(b.key, by),
            value: b.paid,
            title: `${fullName(b, by)}: ${b.paid} paid order${b.paid === 1 ? '' : 's'}, ${rupees(b.netPaise)} net`,
          })),
          { label: `Paid orders by ${by === 'school' ? 'school' : by.replace('placed', '').toLowerCase()}` },
        );

        const moneyChart = columns(
          buckets.map((b) => ({
            label: label(b.key, by),
            value: b.netPaise,
            title: `${fullName(b, by)}: ${rupees(b.netPaise)} net`,
          })),
          { label: 'Net revenue from orders placed', format: rupees },
        );

        el.body.innerHTML =
          `<div class="grid">` +
            stat(String(paid), 'Paid orders', api.compare(paid, paidPrev)) +
            stat(rupees(t.netPaise), 'Net revenue', api.compare(t.netPaise, p.netPaise)) +
            stat(rupees(aov), 'Average order', api.compare(aov, aovPrev)) +
            (best
              ? stat(String(best.paid), 'Busiest ' + (by === 'school' ? 'school' : 'period'), null, fullName(best, by))
              : '') +
          `</div>` +

          `<section class="sec-wrap" aria-labelledby="oc-h">` +
            `<h2 id="oc-h">Paid orders</h2>` +
            ordersChart +
          `</section>` +

          `<section class="sec-wrap" aria-labelledby="mc-h">` +
            `<h2 id="mc-h">Net revenue from those orders</h2>` +
            moneyChart +
          `</section>` +

          `<section class="sec-wrap" aria-labelledby="st-h">` +
            `<h2 id="st-h">The numbers</h2>` +
            `<table>` +
              `<thead><tr>` +
                `<th scope="col">${by === 'school' ? 'School' : 'Placed'}</th>` +
                `<th scope="col">Paid orders</th>` +
                `<th scope="col">Gross</th><th scope="col">GST</th>` +
                `<th scope="col">Refunded</th><th scope="col">Net</th><th scope="col">Average</th>` +
              `</tr></thead>` +
              `<tbody>` +
                /*
                 * Newest first on a time axis — the question is nearly always about the last few
                 * days. **Not** on the school axis: `groupRows` already ranks schools biggest
                 * first, and reversing that put the smallest at the top, directly contradicting
                 * the chart beside it.
                 */
                (by === 'school' ? buckets : [...buckets].reverse()).map((b) =>
                  `<tr>` +
                    // The table is where the full name belongs — the code is for the axis.
                    `<th scope="row">${esc(by === 'school' ? b.label : label(b.key, by))}</th>` +
                    `<td class="num">${b.paid}</td>` +
                    `<td class="num">${esc(rupees(b.grossPaise))}</td>` +
                    `<td class="num">${esc(rupees(b.taxPaise))}</td>` +
                    `<td class="num">${b.refundedPaise ? esc(rupees(b.refundedPaise)) : '—'}</td>` +
                    `<td class="num"><b>${esc(rupees(b.netPaise))}</b></td>` +
                    `<td class="num">${b.paid ? esc(rupees(Math.round(b.netPaise / b.paid))) : '—'}</td>` +
                  `</tr>`).join('') +
              `</tbody>` +
              `<tfoot><tr>` +
                `<th scope="row">Total</th>` +
                `<td class="num">${paid}</td>` +
                `<td class="num">${esc(rupees(t.grossPaise))}</td>` +
                `<td class="num">${esc(rupees(t.taxPaise))}</td>` +
                `<td class="num">${t.refundedPaise ? esc(rupees(t.refundedPaise)) : '—'}</td>` +
                `<td class="num"><b>${esc(rupees(t.netPaise))}</b></td>` +
                `<td class="num">${esc(rupees(aov))}</td>` +
              `</tr></tfoot>` +
            `</table>` +
            `<p class="m">` +
              `Compared against <b>${esc(api.previousWindow(el.from.value, el.to.value).from)}</b> to ` +
              `<b>${esc(api.previousWindow(el.from.value, el.to.value).to)}</b> — the window of the same ` +
              `length immediately before this one, so a shorter month never reads as a decline. ` +
              `<b>Only paid orders appear here</b> — unpaid and cancelled ones are not sales. ` +
              `Refunds are deducted from net.` +
            `</p>` +
          `</section>` +

          packSection();
      }

      /**
       * Meal packs — their own section, never merged into the food figures above (`M10`).
       *
       * Andy: *"Never merge pack sales into the food revenue line. A pack sale is a liability on
       * the day it happens, not a sale."* So this sits below the orders table with its own heading
       * and its own totals, and nothing it computes touches "Net revenue".
       *
       * Every figure comes from `meal_pack_money`, which computes the money in the database
       * (`meal_pack_deferred_paise`) — this renders and groups, it does not recompute. Sales are
       * filtered to the chosen window on `purchased_at`, the only date a *sale* has; the deferred
       * balance is deliberately **not** filtered, because a liability is a running total and
       * belongs to no period.
       */
      function packSection(): string {
        const sold = api.soldBetween(packs, el.from.value, el.to.value);
        const totals = api.packPeriodTotals(sold, packs, packVisibility);

        if (totals.visibility !== 'visible') {
          /*
           * `E21-63`'s rule: refuse to print a number we cannot stand behind. But say which kind
           * of not-knowing this is, because they lead to different actions and only one of them
           * means packs exist.
           *
           * An earlier version merged them and asserted "packs have been sold" in both — which is
           * false wherever the view has simply not shipped yet, and a report that invents a fact
           * to explain its own silence is worse than one that stays quiet.
           */
          const hidden = totals.visibility === 'hidden';
          return (
            `<section class="sec-wrap" aria-labelledby="pk-h">` +
              `<h2 id="pk-h">Meal packs</h2>` +
              `<div class="notice notice--warn"><b class="notice__head">` +
                (hidden
                  ? `Packs have been sold, and this account can't see them`
                  : `We can't read pack money here`) +
              `</b>` +
              (hidden
                ? `The money view returns nothing for this account, so this section would show ` +
                  `<b>₹0</b> — and ₹0 owed in food is not the same as "we cannot see". Nothing is ` +
                  `wrong with the packs; the back office has no read on them yet.`
                : `The pack money view did not answer, so there is nothing to show and nothing to ` +
                  `claim — <b>including whether any pack exists</b>. That is expected wherever ` +
                  `packs have not been deployed yet.`) +
              `</div>` +
            `</section>`
          );
        }

        if (totals.packsSold === 0 && totals.deferredOutstandingPaise === 0) {
          return (
            `<section class="sec-wrap" aria-labelledby="pk-h">` +
              `<h2 id="pk-h">Meal packs</h2>` +
              `<p class="m">No packs were sold in this window, and none are outstanding. ` +
              `Pack money is reported separately from food because a pack sale is money owed in ` +
              `food, not revenue. <a href="/admin/packs">Pack offers</a></p>` +
            `</section>`
          );
        }

        const rate = (r: number | null) =>
          r === null ? '—' : `${Math.round(r * 100)}%`;

        return (
          `<section class="sec-wrap" aria-labelledby="pk-h">` +
            `<h2 id="pk-h">Meal packs</h2>` +

            `<div class="notice notice--info"><b class="notice__head">None of this is in the revenue above</b>` +
            `A pack sale is a <b>liability</b> on the day it happens — money taken for food not ` +
            `yet served — and becomes revenue one item at a time as the food goes out. The ` +
            `figures above are food sold; these are separate and must stay that way.</div>` +

            `<div class="grid">` +
              stat(String(totals.packsSold), 'Packs sold', null, 'in this window') +
              stat(rupees(totals.grossExTaxPaise), 'Collected, ex-GST', null, 'in this window') +
              stat(rupees(totals.gstPaise), 'GST collected', null, 'charged in full at the sale') +
              stat(rupees(totals.deferredOutstandingPaise), 'Still owed in food', null,
                `${totals.itemsOutstanding} item${totals.itemsOutstanding === 1 ? '' : 's'} unspent · all packs, not just this window`) +
            `</div>` +

            `<div class="tablewrap"><table>` +
              `<caption class="vh">Meal pack money by offer</caption>` +
              `<thead><tr>` +
                `<th scope="col">Offer</th>` +
                `<th scope="col" class="num">Sold</th>` +
                `<th scope="col" class="num">Ex-GST</th>` +
                `<th scope="col" class="num">GST</th>` +
                `<th scope="col" class="num">Recognised</th>` +
                `<th scope="col" class="num">Breakage</th>` +
                `<th scope="col" class="num">Still owed</th>` +
                `<th scope="col" class="num">Redeemed</th>` +
                `<th scope="col" class="num">Bonus</th>` +
              `</tr></thead>` +
              `<tbody>` +
              totals.offers.map((o) =>
                `<tr>` +
                  `<td>${esc(o.offerName)}</td>` +
                  `<td class="num">${o.packsSold}</td>` +
                  `<td class="num">${esc(rupees(o.grossExTaxPaise))}</td>` +
                  `<td class="num">${esc(rupees(o.gstPaise))}</td>` +
                  `<td class="num">${esc(rupees(o.revenueRecognisedPaise))}</td>` +
                  // Breakage on its own column, never folded into Recognised (`M11`): revenue
                  // because a parent ate and revenue because a parent forgot are different facts.
                  `<td class="num">${o.breakagePaise ? esc(rupees(o.breakagePaise)) : '—'}</td>` +
                  `<td class="num">${esc(rupees(o.deferredPaise))}</td>` +
                  `<td class="num"><b>${rate(o.redemptionRate)}</b>` +
                    `<span class="sub">${o.itemsRedeemed} of ${o.itemsSold}</span></td>` +
                  // Bonus items reported separately from purchased ones, as Andy asked — and kept
                  // out of the redemption rate, which is a question about what a parent PAID for.
                  `<td class="num">${o.bonusItemsGranted > 0
                    ? `${o.bonusItemsRedeemed} of ${o.bonusItemsGranted}`
                    : '—'}</td>` +
                `</tr>`).join('') +
              `</tbody>` +
            `</table></div>` +

            `<p class="m">` +
              `<b>Redemption rate counts purchased items only.</b> Bonus items were never paid ` +
              `for, so counting them would make a generous bonus read as poor redemption — they ` +
              `are the last column instead. <b>Breakage</b> is items forfeited at expiry: real ` +
              `revenue, and a different fact from food somebody ate. <b>Recognised</b> and ` +
              `<b>breakage</b> are lifetime figures for the packs sold in this window, not ` +
              `movements within it.` +
            `</p>` +
          `</section>`
        );
      }

      el.body.addEventListener('click', (event) => {
        if ((event.target as HTMLElement).closest('[data-retry]')) void load();
      });
      el.reload.addEventListener('click', () => void load());
      el.from.addEventListener('change', () => void load());
      el.to.addEventListener('change', () => void load());
      el.by.addEventListener('change', render);
      for (const button of document.querySelectorAll<HTMLButtonElement>('[data-preset]')) {
        button.addEventListener('click', () => applyPreset(button.dataset.preset!));
      }

      void (async () => {
        if (demo) {
          el.from.value = SALES_FIXTURE.from;
          el.to.value = SALES_FIXTURE.to;
        } else {
          const today = serviceDateToday(new Date());
          // Ends **today**, not tomorrow. A day cannot be busy in the future — that is the one
          // default that differs from the revenue report, and it is the difference between the
          // two screens in miniature.
          el.from.value = shift(today, -29);
          el.to.value = today;
        }
        try {
          // The gate, not a session check — `E10-73`. An account that reaches no screen
          // is signed out at the door rather than shown a frame it cannot fill.
          if (!demo && !(await requireBackofficeAccess('/admin/sales'))) return;
        } catch { /* fall through and let the read fail visibly */ }
        await load();
      })();

      void mountShell();
    </script>
  </body>
</html>
