---
/**
 * Meal pack offers — `E21`, rebuilt.
 *
 * The workshop rather than the shop window: every offer including drafts, and the writes.
 *
 * ## The rebuilt model
 *
 * The old screen configured a **meal** — *N* items, one from a required category. One item is now
 * one item (`docs/meal-packs-rebuild.md` §1), and a pack carries an optional **bonus**: free items
 * earned by finishing the purchased ones inside a window. So the form is name, price ex-GST, item
 * count, bonus items, bonus window, validity — and nothing else.
 *
 * ## Editing a sold offer changes nothing a parent already holds
 *
 * Every term a pack depends on is **stamped onto it at sale**: the offer's name (`name_snapshot`),
 * the price, both tax components, the item count, the bonus terms and the expiry. So an edit
 * changes what the *next* buyer gets and nothing else, and the screen says so in those words
 * rather than greying fields out.
 *
 * That is a change from `E21-60`, which had to freeze `items_per_meal` and `required_category_id`
 * because a sold pack read them live — and from `E21-67`, where the offer's **name** was read live
 * too, so renaming an offer retitled packs already bought and reached an issued invoice's line
 * description. Both are gone with the columns. If the server ever does freeze something it
 * answers `already_sold` with the field named, and the drawer shows that sentence.
 *
 * ## The per-school switch is NOT here
 *
 * Andy, 2026-09-16: whether a school sells packs is a **school-readiness** property and belongs on
 * `/admin/schools` beside the other readiness gates, which is where he will be when he turns Amity
 * on. *"One control, one place."* This screen shows where each offer is offered, read-only, and
 * links there. Two surfaces writing one row is the "same thing in two places" problem the back
 * office redesign exists to kill.
 *
 * ## Nothing pack-related reaches a kitchen surface
 *
 * `meal_packs.manage` is platform-only, this screen is behind it, and its nav entry is hidden
 * without it. A kitchen operator cannot open it, see it, or learn from the navigation that it
 * exists.
 */
import BackofficeShell from '../../components/BackofficeShell.astro';

import '../../styles/tokens.css';
import '../../styles/site.css';
import '../../styles/backoffice.css';
---

<!doctype html>
<html lang="en-IN">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <title>Meal packs — GrayBag</title>
    <link rel="preload" href="/fonts/nunito-latin-var.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="icon" href="/img/favicon.png" type="image/png" sizes="64x64" />
  </head>

  <body>
    <BackofficeShell
      current="/admin/packs"
      title="Meal packs"
      subtitle="Sell meals up front · offered school by school"
    >
      <button slot="actions" class="btn btn--ghost" id="p-reload" type="button">Refresh</button>
      <button slot="actions" class="btn" id="p-new" type="button">New pack</button>

      <div class="toolbar">
        <p class="resultline" id="p-line" role="status" aria-live="polite"></p>
      </div>

      <div class="pad" id="p-body"></div>
    </BackofficeShell>

    <script>
      import { api, money } from '@graybag/shared';
      import { closeDrawer, mountShell, openDrawer } from '../../lib/backoffice/shell.js';
      import { configureBackofficeApi } from '../../lib/backoffice/session.js';
      import { requireBackofficeAccess } from '../../lib/backoffice/guard.js';
      import { PACKS_FIXTURE } from '../../lib/admin/packs-fixture.js';

      const $ = <T extends HTMLElement>(id: string) => document.getElementById(id) as T;
      const el = {
        body: $('p-body'), line: $('p-line'),
        reload: $<HTMLButtonElement>('p-reload'), neu: $<HTMLButtonElement>('p-new'),
      };
      const esc = (s: string) =>
        String(s ?? '').replace(/[&<>"']/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' })[c]!);
      const rupees = (p: number) => money.formatPaise(p);
      const demo = new URLSearchParams(location.search).has('state');

      let offers: api.AdminPackOffer[] = [];
      let sold: Record<string, number> = {};
      let schools: { id: string; name: string }[] = [];
      let loading = true;
      let error: string | null = null;

      async function load() {
        loading = true; error = null; render();
        try {
          if (demo) {
            offers = PACKS_FIXTURE.offers;
            sold = PACKS_FIXTURE.sold;
            schools = PACKS_FIXTURE.schools;
          } else {
            configureBackofficeApi();
            const [list, schoolRows] = await Promise.all([
              api.fetchAdminPackOffers(),
              api.fetchSchools(),
            ]);
            offers = list;
            schools = schoolRows.map((s) => ({ id: s.id, name: s.name }));
            /*
             * The sales count is allowed to fail on its own. It needs the Edge Function, and the
             * offers themselves are readable without it — a screen that refuses to show anything
             * because it could not count purchases is worse than one that shows the offers and
             * says the count is unavailable.
             */
            sold = await api.fetchPackOfferSales().catch(() => ({}));
          }
        } catch (cause) {
          error = cause instanceof Error ? cause.message : 'The offers did not load.';
          offers = [];
        } finally {
          loading = false; render();
        }
      }

      const liveSchools = (o: api.AdminPackOffer) => o.schools.filter((s) => s.isEnabled);

      function row(o: api.AdminPackOffer): string {
        const n = sold[o.id] ?? 0;
        const on = liveSchools(o);
        return (
          `<tr data-offer="${esc(o.id)}">` +
            `<td class="name"><button type="button" data-open="${esc(o.id)}" class="linkish">` +
              `${esc(o.name)}</button>` +
              `<span class="sub">${o.isActive
                ? '<span class="tag tag--live">live</span>'
                : '<span class="tag tag--draft">draft</span>'}</span></td>` +
            `<td>${o.itemsCount} item${o.itemsCount === 1 ? '' : 's'}` +
              // Bonus terms read as one sentence or not at all. "2 bonus" with no window, or a
              // window with no items, is the misconfiguration the form refuses by name.
              (o.bonusItemsCount > 0
                ? `<span class="sub">+${o.bonusItemsCount} bonus if used within ${o.bonusWindowDays} days</span>`
                : '<span class="sub">no bonus</span>') + `</td>` +
            `<td class="num"><b>${esc(rupees(o.netPricePaise))}</b>` +
              `<span class="sub">${esc(rupees(api.perItemPricePaise(o)))} an item</span></td>` +
            `<td class="num">${o.validityDays} days</td>` +
            `<td>${on.length > 0
              ? on.map((s) => `<span class="tag tag--menu">${esc(s.schoolName)}</span>`).join(' ')
              : '<span class="tag tag--none">no school</span>'}</td>` +
            `<td class="num">${n > 0 ? `<b>${n}</b>` : '—'}</td>` +
          `</tr>`
        );
      }

      function render() {
        if (loading) {
          el.line.textContent = '';
          el.body.innerHTML = Array(3).fill('<div class="sk"></div>').join('');
          return;
        }
        if (error) {
          el.line.textContent = '';
          el.body.innerHTML =
            `<div class="notice notice--err"><b class="notice__head">We can't show the offers</b>${esc(error)}</div>` +
            `<button class="btn" type="button" data-retry>Try again</button>`;
          return;
        }
        if (offers.length === 0) {
          // The prototype's empty state, which explains what a pack *is* — this screen is the one
          // place somebody meets the idea for the first time.
          el.line.textContent = '';
          el.body.innerHTML =
            `<div class="empty"><h3>No packs yet</h3>` +
            `<p>A pack is a number of meals bought up front at a lower price per meal. You choose ` +
            `the rules, the price, how long it lasts, and which schools it is offered at.</p>` +
            `<p>If you expected offers here and see none, this account may not hold ` +
            `<b>meal_packs.manage</b> — that is the only thing that shows them.</p>` +
            `<button class="btn" type="button" data-new>Create the first pack</button></div>`;
          return;
        }

        const live = offers.filter((o) => o.isActive).length;
        const totalSold = Object.values(sold).reduce((n, x) => n + x, 0);
        /*
         * Items **sold**, and it used to say "outstanding" — `E10-67`.
         *
         * `sold × itemsCount` is how many items have been paid for. Outstanding would be that minus
         * the ones already eaten, and this screen cannot see redemptions. **The deferred balance
         * lives on `/admin/sales`**, where it is derived from the packs and cross-checked against
         * the ledger (`M10`), which is the only place either number should be read as money.
         *
         * Bonus items are excluded on purpose: they were never paid for (`M10`), so counting them
         * here would inflate "paid for" with a giveaway.
         */
        const itemsSold = offers.reduce((n, o) => n + (sold[o.id] ?? 0) * o.itemsCount, 0);

        el.line.innerHTML =
          `<b>${live} live</b> · ${offers.length} offer${offers.length === 1 ? '' : 's'}` +
          (totalSold > 0 ? ` · ${totalSold} sold · ${itemsSold} items sold` : '');

        el.body.innerHTML =
          /*
           * The prototype's notice, and the sentence that matters most on this screen: a sold pack
           * is money held against food not yet served. It is the reason expiry exists.
           */
          `<div class="notice notice--info"><b class="notice__head">A pack sale is money you owe in food</b>` +
            `A sold pack is <b>not revenue</b> on the day it is bought — it is a liability, and it ` +
            `becomes revenue one item at a time as the food is served. Expiry is what bounds it: ` +
            `every pack expires a fixed number of days after purchase, and unused items are not ` +
            `refundable. <b>What is still owed is on <a href="/admin/sales">Sales</a></b>, kept ` +
            `separate from food revenue and checked against the ledger.</div>` +

          `<div class="tablewrap"><table>` +
            `<thead><tr>` +
              `<th scope="col">Pack</th><th scope="col">Items</th>` +
              `<th scope="col" class="num">Price</th><th scope="col" class="num">Valid</th>` +
              `<th scope="col">Offered at</th><th scope="col" class="num">Sold</th>` +
            `</tr></thead>` +
            `<tbody>${offers.map(row).join('')}</tbody>` +
          `</table></div>`;
      }

      /* ------------------------------------------------------------------ the drawer */

      function field(id: string, label: string, value: string | number, type = 'number', help = '', min = 1) {
        return `<div class="field"><label for="${id}">${esc(label)}</label>` +
          `<input id="${id}" type="${type}" value="${esc(String(value))}" ` +
          (type === 'number' ? `min="${min}" step="1"` : 'maxlength="80"') + ` />` +
          (help ? `<p class="help">${help}</p>` : '') + `</div>`;
      }

      function openOffer(offer: api.AdminPackOffer | null) {
        const n = offer ? (sold[offer.id] ?? 0) : 0;
        const o = offer ?? {
          id: '', name: '', netPricePaise: 0, itemsCount: 20,
          bonusItemsCount: 0, bonusWindowDays: 0, validityDays: 60,
          isActive: false, sortOrder: offers.length, schools: [],
        } as api.AdminPackOffer;

        /*
         * Where this offer is sold — READ-ONLY, with a link.
         *
         * The control lives on `/admin/schools` (see the header). Showing the state here is worth
         * it because "is this actually selling anywhere" is the question you ask while looking at
         * an offer; showing a *switch* here would be the second place to write one row.
         */
        const on = o.schools.filter((x) => x.isEnabled);
        const whereSold = offer
          ? `<div class="sec">Offered at</div>` +
            (on.length > 0
              ? `<p class="help">${on.map((x) => esc(x.schoolName)).join(', ')}</p>`
              : `<p class="help">Not offered at any school yet — so no parent can buy it, ` +
                `even while it is live.</p>`) +
            `<p class="help"><a href="/admin/schools">Turn packs on for a school</a> — it is a ` +
            `school-readiness setting and lives with the others.</p>`
          : `<p class="help">Save the offer first, then turn it on for a school from ` +
            `<a href="/admin/schools">Schools</a>.</p>`;

        openDrawer({
          title: offer ? offer.name : 'New pack',
          subtitle: offer
            ? `${n > 0 ? `${n} sold` : 'nothing sold yet'} · ${o.isActive ? 'live' : 'draft'}`
            : 'A draft until you make it live',
          body:
            (n > 0
              ? `<div class="notice notice--info"><b class="notice__head">${n} pack${n === 1 ? ' has' : 's have'} been bought under this offer</b>` +
                `Editing is safe. Every term a pack depends on — its name, price, tax, item count, ` +
                `bonus and expiry — was <b>copied onto it when it sold</b>, so changes here apply ` +
                `to the next buyer and <b>never</b> to a pack somebody already holds. Rename it, ` +
                `reprice it, change the bonus: the ${n} already sold keep exactly the terms they ` +
                `were sold under.</div>`
              : '') +
            `<div class="sec">The pack</div>` +
            field('f-name', 'Name', o.name, 'text') +
            `<div class="two">` +
              field('f-price', 'Price, ex-GST (paise)', o.netPricePaise) +
              field('f-items', 'Items in the pack', o.itemsCount) +
            `</div>` +
            `<div class="sec">Bonus</div>` +
            `<div class="two">` +
              field('f-bonus', 'Bonus items', o.bonusItemsCount, 'number', '', 0) +
              field('f-window', 'Earned within (days)', o.bonusWindowDays, 'number', '', 0) +
            `</div>` +
            `<p class="help">Free items earned by using all the purchased ones inside the window. ` +
            `<b>Set both, or set both to 0</b> — a window with no items promises nothing, and ` +
            `items with no window can never be earned. Bonus items are a giveaway: they cost no ` +
            `revenue and are reported separately.</p>` +
            `<div class="sec">Validity</div>` +
            field('f-days', 'Valid for (days)', o.validityDays, 'number',
              'From the day it is bought. Unused items are not refundable.') +
            whereSold +
            `<p class="help" data-err></p>`,
          footer:
            `<button class="btn" type="button" data-save>${offer ? 'Save' : 'Create it'}</button>` +
            (offer
              ? `<button class="btn btn--ghost" type="button" data-active>` +
                `${o.isActive ? 'Withdraw' : 'Make it live'}</button>`
              : '') +
            `<button class="btn btn--ghost" type="button" data-cancel>Cancel</button>`,
        });

        const err = document.querySelector<HTMLElement>('[data-err]')!;
        const read = () => ({
          name: document.querySelector<HTMLInputElement>('#f-name')!.value,
          netPricePaise: Number(document.querySelector<HTMLInputElement>('#f-price')!.value),
          itemsCount: Number(document.querySelector<HTMLInputElement>('#f-items')!.value),
          bonusItemsCount: Number(document.querySelector<HTMLInputElement>('#f-bonus')!.value),
          bonusWindowDays: Number(document.querySelector<HTMLInputElement>('#f-window')!.value),
          validityDays: Number(document.querySelector<HTMLInputElement>('#f-days')!.value),
          sortOrder: o.sortOrder,
        });

        document.querySelector('[data-cancel]')?.addEventListener('click', closeDrawer);

        document.querySelector('[data-save]')?.addEventListener('click', async (event) => {
          const button = event.currentTarget as HTMLButtonElement;
          const input = read();
          const problems = api.validatePackOffer(input);
          if (problems) { err.textContent = Object.values(problems)[0]!; return; }

          button.disabled = true;
          try {
            if (offer) await api.updatePackOffer(offer.id, input);
            else await api.createPackOffer(input);
            closeDrawer();
            await load();
          } catch (cause) {
            /*
             * `already_sold` names the field it refused, and the server is the authority on which
             * fields those are. Rather than restate a list this screen believes in — the mistake
             * that let `E21-67` sit unnoticed — whatever the function says is shown verbatim.
             */
            err.textContent = cause instanceof Error ? cause.message : 'That did not save.';
            button.disabled = false;
          }
        });

        document.querySelector('[data-active]')?.addEventListener('click', async (event) => {
          const button = event.currentTarget as HTMLButtonElement;
          button.disabled = true;
          try {
            await api.setPackOfferActive(o.id, !o.isActive);
            closeDrawer();
            await load();
          } catch (cause) {
            err.textContent = cause instanceof Error ? cause.message : 'That did not save.';
            button.disabled = false;
          }
        });
      }

      el.body.addEventListener('click', (event) => {
        const target = event.target as HTMLElement;
        if (target.closest('[data-retry]')) { void load(); return; }
        if (target.closest('[data-new]')) { openOffer(null); return; }
        const id = target.closest<HTMLElement>('[data-open]')?.dataset.open;
        if (id) openOffer(offers.find((o) => o.id === id) ?? null);
      });

      el.neu.addEventListener('click', () => openOffer(null));
      el.reload.addEventListener('click', () => void load());

      void (async () => {
        await mountShell();
        try {
          // The gate, not a session check — `E10-73`. An account that reaches no screen
          // is signed out at the door rather than shown a frame it cannot fill.
          if (!demo && !(await requireBackofficeAccess('/admin/packs'))) return;
        } catch { /* fall through and let the read fail visibly */ }
        await load();
      })();
    </script>
  </body>
</html>
