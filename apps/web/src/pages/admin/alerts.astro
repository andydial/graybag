---
/**
 * Who gets told when an order comes in — `E08-16`.
 *
 * Andy: *"Recipients are configured in the admin UI, not in environment variables. Per kitchen,
 * not global… Each recipient has an on/off toggle that stops alerts without deleting the address."*
 *
 * ## Its own page, not a section of `/admin/config`
 *
 * `/admin/config` is **per school** — cutoffs, break windows, service days. This is **per
 * kitchen**, which is a different axis, and folding a kitchen-scoped list into a school picker
 * would mean choosing a school in order to edit something a school has nothing to do with. It is
 * also the screen somebody opens when alerts are arriving wrongly, which is a different errand
 * from configuring a school.
 *
 * ## The toggle is the point
 *
 * Off and removed look the same from an inbox and are completely different decisions. A paused
 * recipient stays on the list, greyed, with the switch that put it there — so "turn my alerts
 * back on" is one tap and does not require remembering an address.
 */
import BackofficeShell from '../../components/BackofficeShell.astro';

import '../../styles/tokens.css';
import '../../styles/site.css';
import '../../styles/backoffice.css';
---

<!doctype html>
<html lang="en-IN">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <title>Order alerts — GrayBag</title>
    <link rel="preload" href="/fonts/nunito-latin-var.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="icon" href="/img/favicon.png" type="image/png" sizes="64x64" />
  </head>

  <body>
    <BackofficeShell
      current="/admin/alerts"
      title="Order alerts"
      subtitle="Who hears when an order is paid"
    >
      <button id="al-reload" class="btn btn--ghost" slot="actions" type="button">Refresh</button>
      <div class="pad">
        <div id="al-status" class="visually-hidden" role="status" aria-live="polite"></div>

        <p class="m">
          When an order is paid, everyone switched on below is emailed — the order code, school,
          break, service date, items and total, plus <b>which number it is that day</b>.
          <b>No child’s name is ever in the alert</b>; email is not a controlled channel and the
          kitchen board is where names belong.
        </p>

        <div id="al-body"></div>
      </div>
      </BackofficeShell>

    <script>
      import { mountShell } from '../../lib/backoffice/shell.js';
      import { api } from '@graybag/shared';
      import { configureBackofficeApi } from '../../lib/backoffice/session.js';
      import { requireBackofficeAccess } from '../../lib/backoffice/guard.js';
      import { ALERTS_FIXTURE } from '../../lib/admin/alerts-fixture.js';

      const $ = <T extends HTMLElement>(id: string) => document.getElementById(id) as T;
      const el = { body: $('al-body'), status: $('al-status'), reload: $<HTMLButtonElement>('al-reload') };
      const esc = (s: string) =>
        String(s ?? '').replace(/[&<>"']/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' })[c]!);

      const demo = new URLSearchParams(location.search).has('state');

      let kitchens: { id: string; name: string }[] = [];
      let recipients: api.AlertRecipient[] = [];
      let loading = true;
      let error: string | null = null;

      async function load() {
        loading = true; error = null; render();
        try {
          if (demo) {
            kitchens = [...ALERTS_FIXTURE.kitchens];
            recipients = [...ALERTS_FIXTURE.recipients];
          } else {
            configureBackofficeApi();
            const [k, r] = await Promise.all([api.fetchKitchens(), api.fetchAlertRecipients()]);
            kitchens = k.map((x) => ({ id: x.id, name: x.name }));
            recipients = r;
          }
        } catch (cause) {
          error = cause instanceof Error ? cause.message : 'The alert list did not load.';
          recipients = [];
        } finally {
          loading = false; render();
        }
      }

      function kitchenBlock(kitchen: { id: string; name: string }): string {
        const mine = recipients.filter((r) => r.kitchenId === kitchen.id);
        const on = mine.filter((r) => r.isEnabled).length;

        return (
          `<div class="card" style="margin-bottom:14px">` +
            `<div class="sec">${esc(kitchen.name)}</div>` +
            `<p class="m">` +
              (mine.length === 0
                // The state that matters most, said plainly. An empty list is silence, and
                // silence is indistinguishable from a broken mail provider from the outside.
                ? `<b>Nobody is alerted for this kitchen.</b> Orders will arrive with no email.`
                : on === 0
                  ? `<b>All ${mine.length} recipient${mine.length === 1 ? '' : 's'} are switched off.</b> ` +
                    `Orders will arrive with no email.`
                  : `${on} of ${mine.length} switched on.`) +
            `</p>` +

            (mine.length > 0
              ? `<ul class="alist">` +
                  mine.map((r) =>
                    `<li class="gate ${r.isEnabled ? 'gate--pass' : 'gate--warn'}">` +
                      `<span class="ic" aria-hidden="true">${r.isEnabled ? '\u2713' : '\u00b7'}</span>` +
                      `<span class="t">${esc(r.email)}` +
                        `<span>${r.label ? esc(r.label) + ' · ' : ''}` +
                        `${r.isEnabled ? 'alerted on every paid order' : 'paused — receives nothing'}</span>` +
                      `</span>` +
                      `<label class="alistswitch">` +
                        `<input type="checkbox" data-toggle="${esc(r.id)}"${r.isEnabled ? ' checked' : ''} />` +
                        `<span class="visually-hidden">Alerts to ${esc(r.email)}</span>` +
                      `</label>` +
                      `<button class="btn btn--ghost btn--sm" type="button" ` +
                        `data-remove="${esc(r.id)}" data-email="${esc(r.email)}">Remove</button>` +
                    `</li>`).join('') +
                `</ul>`
              : '') +

            `<div class="sec">Add someone</div>` +
            `<form class="aform two" data-add="${esc(kitchen.id)}">` +
              `<div class="field">` +
                `<label for="em-${esc(kitchen.id)}">Add an address</label>` +
                `<input id="em-${esc(kitchen.id)}" name="email" type="email" ` +
                  `required placeholder="name@example.com" autocomplete="off" />` +
              `</div>` +
              `<div class="field">` +
                `<label for="lb-${esc(kitchen.id)}">Who is it (optional)</label>` +
                `<input id="lb-${esc(kitchen.id)}" name="label" type="text" ` +
                  `maxlength="80" placeholder="Kitchen lead" />` +
              `</div>` +
              `<button class="btn" type="submit">Add</button>` +
            `</form>` +
            `<p class="notice notice--err" data-err="${esc(kitchen.id)}" role="alert" hidden></p>` +
          `</div>`
        );
      }

      function render() {
        if (loading) {
          el.body.innerHTML = Array(2).fill('<div class="sk"></div>').join('');
          return;
        }
        if (error) {
          el.body.innerHTML =
            `<div class="empty"><h2>We can't show the alert list</h2><p>${esc(error)}</p>` +
            `<p>This screen needs <b>kitchen.edit</b>.</p>` +
            `<button class="btn" data-retry>Try again</button></div>`;
          return;
        }
        if (kitchens.length === 0) {
          el.body.innerHTML =
            `<div class="empty"><h2>No kitchens</h2>` +
            `<p>Either none exist, or this account cannot see them — that needs ` +
            `<b>kitchen.edit</b>.</p></div>`;
          return;
        }

        const total = recipients.filter((r) => r.isEnabled).length;
        el.status.textContent = `${total} recipient${total === 1 ? '' : 's'} switched on.`;
        el.body.innerHTML = kitchens.map(kitchenBlock).join('');
      }

      function showError(kitchenId: string, message: string) {
        const box = el.body.querySelector(`[data-err="${kitchenId}"]`) as HTMLElement | null;
        if (!box) return;
        box.hidden = false;
        box.textContent = message;
      }

      const blocked = () => {
        if (!demo) return false;
        el.status.textContent = 'Demo view — nothing is written.';
        return true;
      };

      el.body.addEventListener('submit', (event) => {
        const form = (event.target as HTMLElement).closest('form[data-add]') as HTMLFormElement | null;
        if (!form) return;
        event.preventDefault();
        const kitchenId = form.dataset.add!;
        if (blocked()) return showError(kitchenId, 'Demo view — nothing is written.');

        const data = new FormData(form);
        void (async () => {
          try {
            configureBackofficeApi();
            await api.addAlertRecipient({
              kitchenId,
              email: String(data.get('email') ?? ''),
              label: String(data.get('label') ?? '').trim() || null,
            });
            await load();
          } catch (cause) {
            showError(kitchenId, cause instanceof Error ? cause.message : 'The address was not added.');
          }
        })();
      });

      el.body.addEventListener('change', (event) => {
        const box = event.target as HTMLInputElement;
        const id = box.dataset.toggle;
        if (!id) return;
        if (blocked()) { box.checked = !box.checked; return; }
        void (async () => {
          try {
            configureBackofficeApi();
            await api.setAlertRecipientEnabled(id, box.checked);
            await load();
          } catch {
            // Put the switch back. A control that reports a state the server did not accept is
            // worse than one that refuses, because nobody checks a toggle twice.
            box.checked = !box.checked;
            el.status.textContent = 'That change was not saved.';
          }
        })();
      });

      el.body.addEventListener('click', (event) => {
        const target = event.target as HTMLElement;
        if (target.closest('[data-retry]')) { void load(); return; }

        const button = target.closest('[data-remove]') as HTMLElement | null;
        if (!button) return;
        const id = button.dataset.remove!;
        if (blocked()) return;
        // Removing loses the address; pausing does not. Worth one question, because the two are
        // one row apart and the switch is the one people usually mean.
        if (!confirm(`Remove ${button.dataset.email} from the alert list? To stop alerts without losing the address, switch it off instead.`)) return;
        void (async () => {
          try {
            configureBackofficeApi();
            await api.removeAlertRecipient(id);
            await load();
          } catch {
            el.status.textContent = 'That address was not removed.';
          }
        })();
      });

      el.reload.addEventListener('click', () => void load());

      void (async () => {
        try {
          // The gate, not a session check — `E10-73`. An account that reaches no screen
          // is signed out at the door rather than shown a frame it cannot fill.
          if (!demo && !(await requireBackofficeAccess('/admin/alerts'))) return;
        } catch { /* fall through and let the read fail visibly */ }
        await load();
      })();

      void mountShell();
    </script>
  </body>
</html>
