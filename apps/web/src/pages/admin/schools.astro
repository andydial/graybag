---
/**
 * School readiness — `E10-41`.
 *
 * ## What this screen is for
 *
 * Answering "can a parent at this school order lunch, and if not, what is missing?" — every day,
 * for every school. Creating a school happens perhaps three times a year.
 *
 * The screen it replaces led with an empty create form taking two thirds of the page, and showed
 * one label per school: **"Open to parents"**, derived from `onboarded_at` and `is_active` alone.
 * A school could carry that label with no menu, no break windows and no service days. Andy: *"I
 * can't tell at a glance what state a school is in."*
 *
 * ## A checklist, not a status
 *
 * Four things have to be true, they fail independently, each has a different fix on a different
 * screen — and **any one of them missing looks identical to a parent**: the school is there and
 * nothing can be bought. So each school shows its gates, each gate says what is actually true
 * rather than just passing, and each failing gate carries the link to the screen that fixes it.
 * That is the "guided sequence" — it works for a school created ten minutes ago and for one that
 * has been live a month and just lost its menu, which a wizard would not.
 *
 * Schools that need work sort **first**. The opposite of alphabetical, deliberately.
 *
 * `?state=demo` renders fixtures so `check:a11y` audits the screen rather than the redirect.
 */
import BackofficeShell from '../../components/BackofficeShell.astro';

import '../../styles/tokens.css';
import '../../styles/site.css';
import '../../styles/backoffice.css';
---

<!doctype html>
<html lang="en-IN">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <title>Schools — GrayBag</title>
    <link rel="preload" href="/fonts/nunito-latin-var.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="icon" href="/img/favicon.png" type="image/png" sizes="64x64" />
  </head>

  <body>
    <BackofficeShell
      current="/admin/schools"
      title="Schools"
      subtitle="What has to be true before a school can take an order"
    >
      <button slot="actions" class="btn btn--ghost" id="s-reload" type="button">Refresh</button>

      <div class="toolbar">
        <p class="resultline" id="s-summary" role="status" aria-live="polite"></p>
        <!--
          One school at a time, behind a picker — `E10-71`.

          Every school was stacked on one page, which reads fine at three and is a wall at thirty:
          the answer to "is Amity ready" was somewhere in a scroll. The prototype picks one and
          shows it whole, and the chips carry the state, so the page still answers "how is the
          estate" without being read top to bottom.
        -->
        <div class="chips" id="s-picker" role="group" aria-label="Choose a school"></div>
      </div>

      <div class="pad">
      <div id="s-list"></div>

      <!--
        Last, and collapsed. Onboarding a school is rare; checking one is constant. Leading with
        the form was the old screen's central mistake.
      -->
      <details class="sec-wrap sch__new" id="s-new">
        <summary><b>Onboard a new school</b></summary>
        <p class="m">
          For more than a handful use <code>tools/bulk-import</code> — it takes a CSV and tells you
          what it would do first. See <code>docs/import-format.md</code>.
        </p>
        <form id="s-form">
          <div class="sch__grid">
            <div class="admin__field">
              <label  for="s-code">Code</label>
              <input  id="s-code" name="code" required pattern="[a-z0-9_-]+" />
              <p class="m">Lower-case letters, digits, <code>-</code> and <code>_</code>. <b>Permanent</b> — the importer matches on it.</p>
            </div>
            <div class="admin__field">
              <label  for="s-name">Name</label>
              <input  id="s-name" name="name" required />
              <p class="m">What parents see in the picker.</p>
            </div>
            <div class="admin__field">
              <label  for="s-city">City</label>
              <select  id="s-city" name="cityId" required></select>
            </div>
            <div class="admin__field">
              <label  for="s-kitchen">Kitchen</label>
              <select  id="s-kitchen" name="kitchenId" required></select>
            </div>
            <div class="admin__field">
              <label  for="s-type">Type</label>
              <select  id="s-type" name="institutionType">
                <option value="school">School</option>
                <option value="college">College</option>
              </select>
            </div>
            <div class="admin__field">
              <label  for="s-contact-email">Report contact email</label>
              <input  id="s-contact-email" name="contactEmail" type="email" />
              <p class="m">Where the monthly report goes. Can be added later.</p>
            </div>
          </div>
          <p class="notice notice--err" id="s-form-error" role="alert" hidden></p>
          <div class="setting__actions">
            <button class="btn" id="s-submit" type="submit">Onboard school</button>
          </div>
        </form>
      </details>
      </div>
    </BackofficeShell>

    <script>
      import { mountShell } from '../../lib/backoffice/shell.js';
      import { api } from '@graybag/shared';
      import { configureBackofficeApi, currentUser } from '../../lib/backoffice/session.js';
      import { SCHOOLS_FIXTURE } from '../../lib/admin/schools-fixture.js';
      import { MENUS_FIXTURE } from '../../lib/admin/menus-fixture.js';
      import { serviceDateToday } from '../../lib/kitchen/view.js';
      import { estate, readiness } from '../../lib/admin/school-readiness.js';
      import type { Gate, SchoolReadiness } from '../../lib/admin/school-readiness.js';

      const $ = <T extends HTMLElement>(id: string) => document.getElementById(id) as T;
      const el = {
        list: $('s-list'), summary: $('s-summary'), reload: $<HTMLButtonElement>('s-reload'),
        form: $<HTMLFormElement>('s-form'), formError: $('s-form-error'),
        submit: $<HTMLButtonElement>('s-submit'), newBox: $<HTMLDetailsElement>('s-new'),
        city: $<HTMLSelectElement>('s-city'), kitchen: $<HTMLSelectElement>('s-kitchen'),
        picker: $('s-picker'),
      };

      const esc = (s: string) =>
        String(s ?? '').replace(/[&<>"']/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' })[c]!);
      const demo = new URLSearchParams(location.search).has('state');
      const today = serviceDateToday(new Date());

      let list: SchoolReadiness[] = [];
      let cities: api.City[] = [];
      let kitchens: api.Kitchen[] = [];
      let loading = true;
      let error: string | null = null;
      /** A school created in this session, so the checklist that follows can be pointed at. */
      let justCreated: string | null = null;

      async function load() {
        loading = true; error = null; render();
        try {
          if (demo) {
            cities = SCHOOLS_FIXTURE.cities; kitchens = SCHOOLS_FIXTURE.kitchens;
            list = readiness(
              SCHOOLS_FIXTURE.schools, MENUS_FIXTURE.assignments, MENUS_FIXTURE.menus,
              MENUS_FIXTURE.dishes, [], new Map(), today,
            );
          } else {
            configureBackofficeApi();
            const [schools, assignments, menus, dishes, breaks, days, c, k] = await Promise.all([
              api.fetchAdminSchools(), api.fetchMenuAssignments(), api.fetchAdminMenus(),
              api.fetchAdminDishes(), api.fetchAllBreakTimes(), api.fetchServiceDaysBySchool(),
              api.fetchCities(), api.fetchKitchens(),
            ]);
            cities = c; kitchens = k;
            list = readiness(schools, assignments, menus, dishes, breaks, days, today);
          }
        } catch (cause) {
          error = cause instanceof Error ? cause.message : 'The school list did not load.';
          list = [];
        } finally {
          loading = false; fillSelects(); render();
        }
      }

      function fillSelects() {
        el.city.innerHTML = cities.map((c) => `<option value="${esc(c.id)}">${esc(c.name)}</option>`).join('');
        el.kitchen.innerHTML = kitchens.map((k) => `<option value="${esc(k.id)}">${esc(k.name)}</option>`).join('');
      }

      const STATE_WORD = { live: 'Live', scheduled: 'Scheduled', incomplete: 'Not live' } as const;

      function gateHtml(g: Gate): string {
        const mark = g.state === 'ok' ? '✓' : g.state === 'warning' ? '!' : '×';
        return (
          `<li class="gate gate--${esc(g.state)}">` +
            `<span class="gate__mark" aria-hidden="true">${mark}</span>` +
            `<span class="gate__label">${esc(g.label)}</span>` +
            `<span class="gate__detail">${esc(g.detail)}` +
              (g.fix ? `<a class="btn btn--ghost btn--sm" href="${esc(g.fix.href)}">${esc(g.fix.label)}</a>` : '') +
            `</span>` +
          `</li>`
        );
      }

      /*
       * Which school is on screen, in the URL — `E10-71`.
       *
       * "Look at Gem" has to be a link somebody can send, and Refresh must not throw you back to
       * the first school. Same reasoning as the dish workbench's query and the orders filters.
       */
      let selected = new URLSearchParams(location.search).get('school');

      /**
       * The school being shown.
       *
       * Defaults to the **first one that is not live**, not to the first alphabetically. This
       * screen exists to answer "what is stopping a school trading"; opening it on a school with
       * nothing wrong makes you do the finding, which is the job it was built to do for you.
       */
      function chosen(): SchoolReadiness {
        const byId = list.find((r) => r.school.id === selected || r.school.code === selected);
        return byId ?? list.find((r) => r.blockers.length > 0) ?? list[0]!;
      }

      function renderPicker(): void {
        const current = chosen();
        el.picker.innerHTML = list
          .map((r) => {
            const blocked = r.blockers.length > 0;
            return (
              `<button class="chip${blocked ? ' chip--warn' : ''}" type="button" ` +
                `data-school="${esc(r.school.id)}" ` +
                `aria-pressed="${r.school.id === current.school.id}">` +
                `${esc(r.school.name)}` +
                // The count of what is wrong, on the chip. A picker that does not carry state
                // makes you open all thirty to find the one that needs you.
                (blocked ? ` <b>${r.blockers.length}</b>` : '') +
              `</button>`
            );
          })
          .join('');
      }

      function cardHtml(r: SchoolReadiness): string {
        const s = r.school;
        return (
          `<section class="sch sch--${esc(r.state)}${justCreated === s.id ? ' sch--new' : ''}" aria-labelledby="sch-${esc(s.id)}">` +
            `<header class="sch__head">` +
              `<h2 class="sch__name" id="sch-${esc(s.id)}">${esc(s.name)}</h2>` +
              `<span class="statepill statepill--${esc(r.state)}">${esc(STATE_WORD[r.state])}</span>` +
              `<span class="sch__meta">${esc(s.code)} · ${esc(s.cityName)} · ${esc(s.kitchenName)}</span>` +
            `</header>` +
            (justCreated === s.id
              ? `<p class="notice notice--info">Created. Work down the list below — a parent cannot order until every <b>×</b> is cleared.</p>`
              : '') +
            (r.blockers.length > 0
              ? `<p class="sch__why"><b>${r.blockers.length} thing${r.blockers.length === 1 ? '' : 's'} stopping orders.</b> ` +
                `Every one of them looks the same to a parent: the school is there and nothing can be bought.</p>`
              : r.state === 'scheduled'
                ? `<p class="sch__why">Set up correctly — its menu has not started yet.</p>`
                : '') +
            `<ol class="gates">${r.gates.map(gateHtml).join('')}</ol>` +
            elsewhereHtml(r) +
          `</section>`
        );
      }

      /**
       * What else is true about this school, and where it is changed — `E10-71`.
       *
       * The prototype puts a **meal-packs toggle** and an **editable config block** on this page.
       * Both are controls that already exist elsewhere: the per-school pack switch is on
       * `/admin/packs`, and cutoffs and break windows are on `/admin/config`, where the
       * inherited-vs-overridden model lives. It is worth being explicit about why they are not
       * duplicated here rather than just leaving them out.
       *
       * The prototype has **one** screen per noun, so everything about a school has to be on the
       * school. We have screens per **job**, and each of those two controls is gated on a
       * different permission — `meal_packs.manage` at platform scope, `config.platform_edit` — so
       * a second copy here would be a second write path with a second set of failure states, and
       * the two would drift. `D3` and `E10-08` make the same argument about `/orders`.
       *
       * What is genuinely missing is the **information**, not the control: somebody checking a
       * school should not have to guess whether it offers packs. So this is read-only, and it
       * says where to go — which also means it is safe to render for an account that cannot open
       * either screen, because a link they cannot follow is not a permission they gained.
       */
      function elsewhereHtml(r: SchoolReadiness): string {
        const cutoff = r.gates.find((g) => g.key === 'serviceDays');
        return (
          `<div class="sch__elsewhere">` +
            `<p class="m">` +
              `<b>Meal packs</b> are offered school by school and are switched on where the offers ` +
              `are configured. <a href="/admin/packs">Meal packs</a>` +
            `</p>` +
            `<p class="m">` +
              `<b>Cutoffs, service days and break times</b> are inherited from the platform default ` +
              `unless this school overrides them` +
              (cutoff ? ` — currently ${esc(cutoff.detail)}` : '') +
              `. <a href="/admin/config">Configuration</a>` +
            `</p>` +
          `</div>`
        );
      }

      function render() {
        if (loading) { el.list.innerHTML = Array(3).fill('<div class="sk"></div>').join(''); return; }
        if (error) {
          el.list.innerHTML =
            `<div class="empty"><h2>We can't show the schools</h2><p>${esc(error)}</p>` +
            `<button class="btn" data-retry>Try again</button></div>`;
          return;
        }
        if (list.length === 0) {
          el.list.innerHTML =
            `<div class="empty"><h2>No schools yet</h2>` +
            `<p>Onboard one below, or import a CSV with <code>tools/bulk-import</code>.</p></div>`;
          el.summary.textContent = 'No schools.';
          return;
        }

        const e = estate(list);
        el.summary.textContent =
          `${e.total} schools — ${e.live} live` +
          (e.scheduled ? `, ${e.scheduled} scheduled` : '') +
          (e.incomplete ? `, ${e.incomplete} not live` : '');
        renderPicker();
        el.list.innerHTML = cardHtml(chosen());
      }

      // ------------------------------------------------------------------------------- creating

      async function create(event: SubmitEvent) {
        event.preventDefault();
        el.formError.hidden = true;
        if (demo) { el.formError.hidden = false; el.formError.textContent = 'Demo view — nothing is written.'; return; }

        const data = new FormData(el.form);
        const value = (k: string) => { const v = String(data.get(k) ?? '').trim(); return v === '' ? null : v; };
        el.submit.disabled = true;
        try {
          const created = await api.createSchool({
            code: String(data.get('code') ?? '').trim(),
            name: String(data.get('name') ?? '').trim(),
            cityId: String(data.get('cityId') ?? ''),
            kitchenId: String(data.get('kitchenId') ?? ''),
            institutionType: String(data.get('institutionType') ?? 'school'),
            contactEmail: value('contactEmail'),
          } as unknown as api.NewSchool);
          justCreated = created.id;
          el.form.reset();
          el.newBox.open = false;
          await load();
          // Straight to the new school's checklist, which is the next thing to do rather than a
          // congratulation. This is the "guided sequence": the gaps are the guide.
          document.getElementById(`sch-${created.id}`)?.scrollIntoView({ block: 'center', behavior: 'smooth' });
        } catch (cause) {
          el.formError.hidden = false;
          el.formError.textContent = cause instanceof Error ? cause.message : 'The school was not created.';
        } finally {
          el.submit.disabled = false;
        }
      }

      el.form.addEventListener('submit', (e) => void create(e as SubmitEvent));
      el.picker.addEventListener('click', (event) => {
        // One listener on the container: the chips are re-rendered whenever the data changes, so
        // a listener bound per chip would outlive the button it was bound to.
        const chip = (event.target as HTMLElement).closest<HTMLElement>('[data-school]');
        if (!chip) return;
        selected = chip.dataset.school ?? null;
        const next = new URLSearchParams(location.search);
        if (selected) next.set('school', selected); else next.delete('school');
        history.replaceState(null, '', `?${next.toString()}`);
        render();
      });

      el.reload.addEventListener('click', () => { justCreated = null; void load(); });
      el.list.addEventListener('click', (event) => {
        if ((event.target as HTMLElement).closest('[data-retry]')) void load();
      });

      void (async () => {
        try {
          if (!demo && !(await currentUser())) {
            location.assign(`/signin?next=${encodeURIComponent('/admin/schools')}`);
            return;
          }
        } catch { /* an unconfigured build falls through to the error state */ }
        await load();
      })();
    void mountShell();
    </script>
  </body>
</html>
