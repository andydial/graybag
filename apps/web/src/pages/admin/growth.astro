---
/**
 * How registration is tracking — `E11-08`.
 *
 * Andy: *"All registered users — registrations per date — registrations per school etc. Want to be
 * able to see exactly how the registrations / growth is tracking. Would be good to have some basic
 * graphs / visuals as well to reflect the data."*
 *
 * ## Separate from `/reports`
 *
 * `/reports` answers "what did this school order and what is it worth", for a school. This answers
 * "is the product growing", for us. They share no row and no audience, and `E10-10` is explicit
 * that the monthly report is the narrow thing Andy asked for and nothing more — growing it
 * quietly is the failure that task exists to prevent.
 *
 * ## No child, and no parent, appears on this page
 *
 * Every number here is a count. `fetchGrowth` selects three columns per child, none of which
 * identifies anybody (non-negotiable #4), and the account read carries no name or address either —
 * a growth chart needs magnitudes, and a list of who signed up is a different screen with a
 * different justification.
 *
 * ## The charts are inline SVG
 *
 * No chart library. The site ships **zero** third-party assets — `check-build.mjs` fails the build
 * on one — and the CSP is `script-src 'self'`. A polyline and a row of `<rect>`s cost nothing at
 * runtime and are readable by a screen reader when the numbers are in a table beside them, which
 * they are.
 */
import BackofficeShell from '../../components/BackofficeShell.astro';

import '../../styles/tokens.css';
import '../../styles/site.css';
import '../../styles/backoffice.css';
---

<!doctype html>
<html lang="en-IN">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <title>Growth — GrayBag</title>
    <link rel="preload" href="/fonts/nunito-latin-var.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="icon" href="/img/favicon.png" type="image/png" sizes="64x64" />
  </head>

  <body>
    <BackofficeShell
      current="/admin/growth"
      title="Growth"
      subtitle="Are new families arriving"
    >
      <button id="g-reload" class="btn btn--ghost" slot="actions" type="button">Refresh</button>

        <div id="g-status" class="visually-hidden" role="status" aria-live="polite"></div>

        <p class="m">
          Registered accounts, how far they get, and which schools they are at.
          <b>No child appears anywhere on this page</b> — not a name, a class or a section.
          The one personal detail here is a <b>parent's email</b>, and only in the list of people
          who registered and never added a child, because that list exists to be emailed.
        </p>

        <div class="pad" id="g-body"></div>
      </BackofficeShell>

    <script>
      import { mountShell } from '../../lib/backoffice/shell.js';
      import { api, money } from '@graybag/shared';
      import { growth } from '../../lib/admin/growth.js';
      import { area, columns } from '../../lib/admin/chart.js';
      import type { Growth } from '../../lib/admin/growth.js';
      import { configureBackofficeApi, currentUser } from '../../lib/backoffice/session.js';
      import { GROWTH_FIXTURE } from '../../lib/admin/growth-fixture.js';
      import { serviceDateToday } from '../../lib/kitchen/view.js';

      const $ = <T extends HTMLElement>(id: string) => document.getElementById(id) as T;
      const el = { body: $('g-body'), status: $('g-status'), reload: $<HTMLButtonElement>('g-reload') };
      const esc = (s: string) =>
        String(s ?? '').replace(/[&<>"']/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' })[c]!);

      const MONTHS = ['Jan', 'Feb', 'Mar', 'Apr', 'May', 'Jun',
        'Jul', 'Aug', 'Sep', 'Oct', 'Nov', 'Dec'];
      /** `2026-08-17` as `17 Aug`. From the parts, never through a Date (`E09-32`). */
      const shortDate = (iso: string) => {
        const [, m, d] = iso.split('-');
        return `${Number(d)} ${MONTHS[Number(m) - 1] ?? ''}`;
      };

      const demo = new URLSearchParams(location.search).has('state');
      const today = serviceDateToday(new Date());

      let data: Growth | null = null;
      let loading = true;
      let error: string | null = null;

      async function load() {
        loading = true; error = null; render();
        try {
          if (demo) {
            data = growth(
              GROWTH_FIXTURE.users, GROWTH_FIXTURE.children, GROWTH_FIXTURE.links,
              GROWTH_FIXTURE.schools, GROWTH_FIXTURE.today, GROWTH_FIXTURE.orders,
            );
          } else {
            configureBackofficeApi();
            const [g, schools] = await Promise.all([api.fetchGrowth(), api.fetchAdminSchools()]);
            data = growth(
              g.users, g.children, g.links,
              schools.map((s) => ({ id: s.id, name: s.name })),
              today, g.orders,
            );
          }
        } catch (cause) {
          error = cause instanceof Error ? cause.message : 'The growth figures did not load.';
          data = null;
        } finally {
          loading = false; render();
        }
      }

      /** A number and what it means, for the row of headline figures. */
      /** The prototype's card: the label first, then the number, then the note. */
      const stat = (value: string, label: string, note = '') =>
        `<div class="card"><h4>${esc(label)}</h4>` +
        `<div class="k">${esc(value)}</div>` +
        (note ? `<div class="m">${esc(note)}</div>` : '') + `</div>`;

      /**
       * Two charts, sharing an axis width — `E11-10`.
       *
       * The first version of this drew a bare polyline with `preserveAspectRatio="none"`, no y
       * axis, no dates and no baseline. Andy: *"the graph in growth is abysmal."* It was: a line
       * with no scale says "it went up" and nothing else, and the stretching distorted the one
       * thing a line is for.
       *
       * Cumulative as an **area**, because a running total is the rare case where the area under
       * the curve means something. Per-day as **columns**, because at these numbers a day with
       * three signups next to a day with none is legible as bars and invisible as a step.
       */
      function chart(g: Growth): string {
        if (g.daily.length === 0) return '';
        const last = g.daily.at(-1)!;

        const cumulative = g.daily.map((d) => ({
          label: shortDate(d.date), value: d.cumulative,
          title: `${d.date}: ${d.cumulative} accounts in total`,
        }));
        const perDay = g.daily.map((d) => ({
          label: shortDate(d.date), value: d.registrations,
          title: `${d.date}: ${d.registrations} new account${d.registrations === 1 ? '' : 's'}`,
        }));

        return (
          `<section class="admin__section" aria-labelledby="chart-h">` +
            `<h2 id="chart-h">Total accounts</h2>` +
            `<p class="m">` +
              `${esc(g.daily[0]!.date)} to ${esc(last.date)} · ending at <b>${last.cumulative}</b>` +
            `</p>` +
            area(cumulative, { label: `Total registered accounts, ending at ${last.cumulative}` }) +
          `</section>` +
          `<section class="admin__section" aria-labelledby="perday-h">` +
            `<h2 id="perday-h">New accounts per day</h2>` +
            columns(perDay, { label: 'New registrations per day' }) +
          `</section>`
        );
      }

      /*
       * The funnel used to be rendered here — `E11-22` moved it to Reports.
       *
       * Andy: *"Growth = are new families arriving. Reports = does a family who arrives get to an
       * order, over a range, beside the revenue it explains."* They are different questions on
       * different clocks, and an all-time funnel could only ever flatten as the product grew,
       * because everyone who ever signed up and stopped stayed in it for good.
       *
       * `whereConversionWent` below is what replaces it on this page: a pointer, not a number.
       * Deleting a section people used without saying where it went is how a screen gets a
       * reputation for losing things.
       */

      function stuckList(g: Growth): string {
        if (g.stuck.length === 0) return '';
        return (
          `<details class="admin__section">` +
            `<summary><b>${g.stuck.length} to email</b> — registered, no child added</summary>` +
            `<p class="m">` +
              `They cannot order until a child exists. Newest first, capped at ${g.stuck.length}. ` +
              `Nothing about a child is shown here because nothing about a child is read.` +
            `</p>` +
            `<table>` +
              `<thead><tr><th scope="col">Email</th><th scope="col">Registered</th></tr></thead>` +
              `<tbody>` +
                g.stuck.map((u) =>
                  `<tr><th scope="row">${esc(u.email)}</th>` +
                  `<td>${esc(u.registered)}</td></tr>`).join('') +
              `</tbody>` +
            `</table>` +
          `</details>`
        );
      }

      /*
       * Paid orders per day and the average order value were drawn here. Both are money over
       * time, which is Reports' question — `E11-22`. An acquisition screen that reports revenue
       * invites being read as a revenue screen, and then two screens disagree about the month.
       */

      /** Where the funnel went, and a way to get there. */
      function whereConversionWent(): string {
        return (
          `<div class="notice notice--info">` +
            `<b>Where conversion went</b>` +
            `<p>` +
              `Registered → added a child → first order → ordered again now lives on ` +
              `<b>Reports</b>, over a date range, beside the revenue it explains. This page ` +
              `answers whether new families are arriving; that one answers whether a family who ` +
              `arrives gets to an order.` +
            `</p>` +
            `<p><a class="btn btn--ghost" href="/reports">Open Reports</a></p>` +
          `</section>`
        );
      }

      function schoolTable(g: Growth): string {
        if (g.bySchool.length === 0) return '';
        return (
          `<section class="admin__section" aria-labelledby="school-h">` +
            `<h2 id="school-h">By school</h2>` +
            `<p class="m">` +
              `A family is counted <b>once per school</b>, however many children they have there. ` +
              `<b>Ordered at least once</b> is all-time and counts accounts, not orders — a school ` +
              `with families and none of them ordering is the row worth a phone call.` +
            `</p>` +
            `<table>` +
              `<thead><tr><th scope="col">School</th><th scope="col">Families</th>` +
              `<th scope="col">Children</th><th scope="col">Ordered at least once</th>` +
              `<th scope="col">Share</th></tr></thead>` +
              `<tbody>` +
                g.bySchool.map((s) =>
                  `<tr>` +
                    `<th scope="row">${esc(s.name)}</th>` +
                    `<td class="num">${s.guardians}</td>` +
                    `<td class="num">${s.children}</td>` +
                    // The column that makes this an acquisition table rather than a registration
                    // one. A school with families and none of them ordering is the row to act on,
                    // so it is a number rather than a bar — a zero bar is invisible.
                    `<td class="num">${s.ordered || '—'}</td>` +
                    `<td>` +
                      // A track with a fill, not a bare bar: at 0% a bare bar is invisible, and
                      // "no families here" is the most actionable row on this table.
                      `<span class="gtrack"><span class="gfill" style="--w:${(s.share * 100).toFixed(1)}%"></span></span>` +
                      `<span class="gbar__pc">${(s.share * 100).toFixed(0)}%</span>` +
                    `</td>` +
                  `</tr>`,
                ).join('') +
              `</tbody>` +
            `</table>` +
          `</section>`
        );
      }

      function dayTable(g: Growth): string {
        // Newest first, and only the last 28. The whole series is on the chart; this is for
        // reading exact numbers off recent days, which is what it is actually used for.
        const recent = [...g.daily].reverse().slice(0, 28);
        if (recent.length === 0) return '';
        return (
          `<details class="admin__section">` +
            `<summary><b>Day by day</b> — the last ${recent.length} days</summary>` +
            `<table>` +
              `<thead><tr><th scope="col">Date</th><th scope="col">New</th><th scope="col">Total</th></tr></thead>` +
              `<tbody>` +
                recent.map((d) =>
                  `<tr><th scope="row">${esc(d.date)}</th>` +
                  `<td class="num">${d.registrations}</td>` +
                  `<td class="num">${d.cumulative}</td></tr>`).join('') +
              `</tbody>` +
            `</table>` +
          `</details>`
        );
      }

      function render() {
        if (loading) {
          el.body.innerHTML = Array(3).fill('<div class="sk"></div>').join('');
          return;
        }
        if (error) {
          el.body.innerHTML =
            `<div class="empty"><h2>We can't show growth</h2><p>${esc(error)}</p>` +
            `<p>This screen needs <b>users.view</b> at platform scope.</p>` +
            `<button class="btn" data-retry>Try again</button></div>`;
          return;
        }
        const g = data;
        if (!g) return;

        if (g.totalUsers === 0) {
          // Ambiguous by nature, exactly like `/reports`: no registrations, or no permission to
          // count them. Say both rather than picking one (`[AUTH-01]`).
          el.body.innerHTML =
            `<div class="empty"><h2>No registrations to show</h2>` +
            `<p>Either nobody has registered yet, or this account cannot read the user list — ` +
            `it needs <b>users.view</b> at platform scope.</p></div>`;
          return;
        }

        const week = g.recent.find((r) => r.days === 7)!;
        const delta = (r: { now: number; previous: number }) =>
          r.previous === 0 ? (r.now > 0 ? 'first ones' : 'none before') :
          `${r.now >= r.previous ? '+' : ''}${Math.round(((r.now - r.previous) / r.previous) * 100)}% on the previous`;

        el.status.textContent = `${g.totalUsers} registered accounts.`;

        el.body.innerHTML =
          /*
           * Four cards, as the prototype has — `E11-22`. It previously showed six, and "Last 7
           * days" and "Last 28 days" were two of them; the 7-day figure now rides along with the
           * account total, where it reads as a rate of arrival rather than as a fifth statistic.
           *
           * The prototype's fourth card is **Install base** — "Play + TestFlight · 13 have signed
           * in". There is no source for that here: store install counts live in the Play and App
           * Store consoles, and nothing in this database knows them. Inventing a plausible number
           * for that tile would be worse than not having it, so the slot goes to the conversion
           * gap instead and `E11-23` records what it would take to show the real thing.
           */
          `<div class="grid">` +
            stat(String(g.totalUsers), 'Registered accounts',
              `+${week.now} this week · ${delta(week)}`) +
            stat(String(g.totalChildren), 'Children added',
              `across ${g.bySchool.filter((s) => s.children > 0).length} school` +
              `${g.bySchool.filter((s) => s.children > 0).length === 1 ? '' : 's'}` +
              (g.totalUsers > 0 ? ` · ${(g.totalChildren / g.totalUsers).toFixed(2)} per account` : '')) +
            stat(String(g.activeParents), 'Ordered in the last 7 days',
              `of ${g.totalUsers} accounts`) +
            // The conversion gap. `AR7` makes signup-to-first-order a primary goal, and an
            // account with no child cannot order at all — so this is the number that says
            // whether onboarding works, not a curiosity. The list to email is below.
            stat(String(g.usersWithoutChildren), 'Signed up, no child yet',
              g.totalUsers > 0 ? `${Math.round((g.usersWithoutChildren / g.totalUsers) * 100)}% of accounts` : '') +
          `</div>` +
          chart(g) +
          schoolTable(g) +
          stuckList(g) +
          dayTable(g) +
          // Last, deliberately: it is a signpost, not a finding, and it must not be the first
          // thing between the reader and their numbers.
          whereConversionWent();
      }

      el.reload.addEventListener('click', () => void load());
      el.body.addEventListener('click', (event) => {
        if ((event.target as HTMLElement).closest('[data-retry]')) void load();
      });

      (async () => {
        try {
          if (!demo && !(await currentUser())) {
            location.assign(`/signin?next=${encodeURIComponent('/admin/growth')}`);
            return;
          }
        } catch { /* fall through and let the read fail visibly */ }
        await load();
      })();

      void mountShell();
    </script>
  </body>
</html>
