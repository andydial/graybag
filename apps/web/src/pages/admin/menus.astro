---
/**
 * Named menus, and the schools serving them — `E10-49`.
 *
 * Andy asked for *"named, reusable menus"* as the third item of the back-office build, and the
 * prototype states what they are for: *"A menu has a NAME and can be assigned to more than one
 * school, which is what makes onboarding a new school a two-minute job — start from one that
 * already works, then diverge only where it needs to."*
 *
 * ## What this screen is for, and what it is not
 *
 * It is the **overview**: what menus exist, who is serving each one, what is wrong with them.
 * Editing a menu's items and prices already happens in the dish workbench at `/admin/dishes`,
 * where the dish and its price sit together, and duplicating that here would give two screens
 * that can disagree about a price.
 *
 * The state it exists to surface is a menu **assigned to nobody**, which is invisible in both
 * directions today: the workbench counts its dishes as placed and is satisfied, and the school
 * screen reports a school as having no menu without mentioning that a finished one is sitting
 * unused. Two screens each showing half a problem is how it survives a month.
 *
 * ## Read-only, deliberately
 *
 * The prototype has **New menu** and **Duplicate a menu** buttons, and both are `alert('Prototype')`
 * in it. Creating or copying a menu is a write, and every write goes through an Edge Function
 * (`A4`, non-negotiable #1) — there is no menu-write function yet. A button that looks like it
 * creates a menu and does not is worse than no button, so they are absent and `E10-50` carries
 * the work.
 */
import BackofficeNav from '../../components/BackofficeNav.astro';

import '../../styles/tokens.css';
import '../../styles/site.css';
import '../../styles/kitchen.css';
import '../../styles/admin.css';
---

<!doctype html>
<html lang="en-IN">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <title>Menus — GrayBag</title>
    <link rel="preload" href="/fonts/nunito-latin-var.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="icon" href="/img/favicon.png" type="image/png" sizes="64x64" />
  </head>

  <body>
    <div class="kitchen">
      <header class="kitchen__bar">
        <div class="kitchen__bar-inner kitchen__bar-inner--admin">
          <h1 class="kitchen__title">Menus</h1>
          <button id="m-reload" class="kitchen__btn kitchen__refresh" type="button">Refresh</button>
          <BackofficeNav current="/admin/menus" />
        </div>
      </header>

      <main class="kitchen__wrap admin__wrap">
        <div id="m-status" class="visually-hidden" role="status" aria-live="polite"></div>

        <p class="admin__intro">
          A menu is a <b>named set of dishes with prices</b>, served by one or more schools over a
          date window. Onboarding a school means pointing it at a menu that already works, so the
          same menu serving three schools is the normal case rather than a mistake.
          Prices and dishes are edited on <a href="/admin/dishes">Dishes</a>, where the price sits
          with the dish it belongs to.
        </p>

        <p class="rctl__line" id="m-line"></p>

        <div id="m-body"></div>
      </main>
    </div>

    <script>
      import { mountNav } from '../../lib/backoffice/nav-mount.js';
      import { api, money } from '@graybag/shared';
      import { configureBackofficeApi, currentUser } from '../../lib/backoffice/session.js';
      import { serviceDateToday } from '../../lib/kitchen/view.js';
      import { MENUS_FIXTURE } from '../../lib/admin/menus-fixture.js';
      import { buildMenuPlans, unassignedCount } from '../../lib/admin/menu-plans.js';
      import type { MenuPlan, MenuSchool } from '../../lib/admin/menu-plans.js';

      const $ = <T extends HTMLElement>(id: string) => document.getElementById(id) as T;
      const el = {
        body: $('m-body'), status: $('m-status'), line: $('m-line'),
        reload: $<HTMLButtonElement>('m-reload'),
      };
      const esc = (s: string) =>
        String(s ?? '').replace(/[&<>"']/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' })[c]!);
      const rupees = (p: number) => money.formatPaise(p);
      const demo = new URLSearchParams(location.search).has('state');

      let plans: MenuPlan[] = [];
      let loading = true;
      let error: string | null = null;

      async function load() {
        loading = true; error = null; render();
        try {
          const today = serviceDateToday(new Date());
          if (demo) {
            plans = buildMenuPlans(
              MENUS_FIXTURE.menus, MENUS_FIXTURE.assignments, MENUS_FIXTURE.dishes, today,
            );
          } else {
            configureBackofficeApi();
            const [menus, assignments, dishes] = await Promise.all([
              api.fetchAdminMenus(), api.fetchMenuAssignments(), api.fetchAdminDishes(),
            ]);
            plans = buildMenuPlans(menus, assignments, dishes, today);
          }
        } catch (cause) {
          error = cause instanceof Error ? cause.message : 'The menus did not load.';
          plans = [];
        } finally {
          loading = false; render();
        }
      }

      /** A school chip. The state is in the word, never only in the colour (WCAG 1.4.1). */
      function schoolChip(s: MenuSchool): string {
        const when =
          s.state === 'scheduled' ? `from ${esc(s.validFrom)}`
          : s.state === 'ended' ? `ended ${esc(s.validTo ?? '')}`
          : s.state === 'revoked' ? 'revoked'
          : 'serving now';
        return (
          `<span class="mchip mchip--${s.state}">` +
            `<b>${esc(s.schoolCode.toUpperCase())}</b> ${esc(s.schoolName)}` +
            `<span class="mchip__when">${when}</span>` +
          `</span>`
        );
      }

      function card(p: MenuPlan): string {
        const priced = p.priceRange
          ? p.priceRange.lowPaise === p.priceRange.highPaise
            ? rupees(p.priceRange.lowPaise)
            : `${rupees(p.priceRange.lowPaise)} – ${rupees(p.priceRange.highPaise)}`
          : 'nothing on sale';
        const parked = p.menu.items.length - p.liveItems;

        return (
          `<section class="mcard${p.liveCount === 0 ? ' mcard--idle' : ''}">` +
            `<div class="mcard__head">` +
              `<h2 class="mcard__name">${esc(p.menu.name)}</h2>` +
              (p.menu.status !== 'active'
                ? `<span class="mchip mchip--draft">${esc(p.menu.status)}</span>` : '') +
            `</div>` +

            `<p class="mcard__meta">` +
              `<b>${p.liveItems}</b> dish${p.liveItems === 1 ? '' : 'es'} on sale · ${esc(priced)}` +
              (parked > 0 ? ` · ${parked} parked` : '') +
            `</p>` +

            (p.schools.length > 0
              ? `<div class="mcard__schools">${p.schools.map(schoolChip).join('')}</div>`
              : '') +

            /*
             * The finding, said plainly. A menu nobody serves is not an error — it is often a
             * term being prepared — so it is stated rather than alarmed about, and it says what
             * would change it.
             */
            (p.liveCount === 0
              ? `<p class="mcard__note">` +
                  `<b>No school is serving this today.</b> ` +
                  (p.schools.some((s) => s.state === 'scheduled')
                    ? `It is scheduled to start — the date is on the chip above.`
                    : p.schools.length > 0
                    ? `Every assignment it has has ended or been revoked.`
                    : `It has never been assigned to a school. Assign it on ` +
                      `<a href="/admin/schools">Schools</a>.`) +
                `</p>`
              : '') +

            (p.untypedDishes.length > 0
              ? `<p class="mcard__note mcard__note--warn">` +
                  `<b>${p.untypedDishes.length} dish${p.untypedDishes.length === 1 ? '' : 'es'} ` +
                  `with no food type</b> — ${esc(p.untypedDishes.slice(0, 4).join(', '))}` +
                  `${p.untypedDishes.length > 4 ? `, and ${p.untypedDishes.length - 4} more` : ''}. ` +
                  `A parent cannot tell whether these are vegetarian. ` +
                  `<a href="/admin/dishes?type=unset">Fix on Dishes</a>.` +
                `</p>`
              : '') +
          `</section>`
        );
      }

      function render() {
        if (loading) {
          el.line.textContent = '';
          el.body.innerHTML = Array(3).fill('<div class="kitchen__skeleton"></div>').join('');
          return;
        }
        if (error) {
          el.line.textContent = '';
          el.body.innerHTML =
            `<div class="kitchen__state"><h2>We can't show the menus</h2><p>${esc(error)}</p>` +
            `<button class="kitchen__btn kitchen__btn--primary" data-retry>Try again</button></div>`;
          return;
        }
        if (plans.length === 0) {
          // Both possibilities, because they are indistinguishable from here (`[AUTH-01]`).
          el.line.textContent = '';
          el.body.innerHTML =
            `<div class="kitchen__state"><h2>No menus</h2>` +
            `<p>Either none has been created, or this account cannot read them — that needs ` +
            `<b>menu.edit</b>.</p></div>`;
          return;
        }

        const idle = unassignedCount(plans);
        const line =
          `${plans.length} menu${plans.length === 1 ? '' : 's'}` +
          (idle > 0 ? ` · ${idle} serving no school today` : ' · all in use');
        el.line.textContent = line;
        el.status.textContent = line;

        el.body.innerHTML = plans.map(card).join('');
      }

      el.reload.addEventListener('click', () => void load());
      el.body.addEventListener('click', (event) => {
        if ((event.target as HTMLElement).closest('[data-retry]')) void load();
      });

      void (async () => {
        try {
          if (!demo && !(await currentUser())) {
            location.assign(`/signin?next=${encodeURIComponent('/admin/menus')}`);
            return;
          }
        } catch { /* fall through and let the read fail visibly */ }
        await load();
      })();

      void mountNav();
    </script>
  </body>
</html>
