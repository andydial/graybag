---
/**
 * Named menus, and the schools serving them — `E10-49`, rebuilt on the shell in `E10-55`.
 *
 * The prototype's Menus screen, this time as its design rather than its idea: the persistent
 * sidebar, a `.card` per menu with a `.tag` for its state, `Rename` / `Assign to another school` /
 * `Duplicate` / `Edit its dishes`, and the assign-vs-duplicate `.notice` that says which one you
 * want.
 *
 * ## The explanation is the most useful thing on the page
 *
 * *"Assign points a second school at the same menu: change a price once and both schools change.
 * Duplicate takes a copy that then goes its own way."* That decides whether a price edit next term
 * touches one school or three, and it is invisible in the data — both produce "a menu at a
 * school". Getting it wrong is discovered a month later, at a price change.
 *
 * ## Assign links out rather than duplicating the control
 *
 * Assigning a menu to a school writes `menu_assignment` **with a date window**, which is a
 * decision about that school and belongs on Schools where the window is visible. A second place to
 * assign a menu is a second place to get the dates wrong.
 */
import BackofficeShell from '../../components/BackofficeShell.astro';

import '../../styles/tokens.css';
import '../../styles/site.css';
import '../../styles/backoffice.css';
---

<!doctype html>
<html lang="en-IN">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <title>Menus — GrayBag</title>
    <link rel="preload" href="/fonts/nunito-latin-var.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="icon" href="/img/favicon.png" type="image/png" sizes="64x64" />
  </head>

  <body>
    <BackofficeShell
      current="/admin/menus"
      title="Menus"
      subtitle="Named menus, assigned to schools — reuse one to start a new school"
    >
      <button slot="actions" class="btn btn--ghost" id="m-reload" type="button">Refresh</button>
      <button slot="actions" class="btn" id="m-new" type="button">New menu</button>

      <div class="toolbar">
        <p class="resultline" id="m-line" role="status" aria-live="polite"></p>
      </div>

      <div class="pad" id="m-body"></div>
    </BackofficeShell>

    <script>
      import { api, money } from '@graybag/shared';
      import { closeDrawer, mountShell, openDrawer } from '../../lib/backoffice/shell.js';
      import { configureBackofficeApi, currentUser } from '../../lib/backoffice/session.js';
      import { serviceDateToday } from '../../lib/kitchen/view.js';
      import { MENUS_FIXTURE } from '../../lib/admin/menus-fixture.js';
      import { buildMenuPlans, unassignedCount } from '../../lib/admin/menu-plans.js';
      import type { MenuPlan, MenuSchool } from '../../lib/admin/menu-plans.js';

      const $ = <T extends HTMLElement>(id: string) => document.getElementById(id) as T;
      const el = {
        body: $('m-body'), line: $('m-line'),
        reload: $<HTMLButtonElement>('m-reload'), neu: $<HTMLButtonElement>('m-new'),
      };
      const esc = (s: string) =>
        String(s ?? '').replace(/[&<>"']/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' })[c]!);
      const rupees = (p: number) => money.formatPaise(p);
      const demo = new URLSearchParams(location.search).has('state');

      let plans: MenuPlan[] = [];
      let kitchenId = '';
      let loading = true;
      let error: string | null = null;

      async function load() {
        loading = true; error = null; render();
        try {
          const today = serviceDateToday(new Date());
          if (demo) {
            plans = buildMenuPlans(
              MENUS_FIXTURE.menus, MENUS_FIXTURE.assignments, MENUS_FIXTURE.dishes, today,
            );
          } else {
            configureBackofficeApi();
            const [menus, assignments, dishes] = await Promise.all([
              api.fetchAdminMenus(), api.fetchMenuAssignments(), api.fetchAdminDishes(),
            ]);
            plans = buildMenuPlans(menus, assignments, dishes, today);
          }
          kitchenId = plans[0]?.menu.kitchenId ?? '';
        } catch (cause) {
          error = cause instanceof Error ? cause.message : 'The menus did not load.';
          plans = [];
        } finally {
          loading = false; render();
        }
      }

      /** The state is in the words, never only in the tint (WCAG 1.4.1). */
      const schoolTag = (s: MenuSchool) => {
        const when =
          s.state === 'scheduled' ? `from ${esc(s.validFrom)}`
          : s.state === 'ended' ? `ended ${esc(s.validTo ?? '')}`
          : s.state === 'revoked' ? 'revoked'
          : 'serving now';
        return `<span class="tag tag--menu">${esc(s.schoolName)} · ${when}</span>`;
      };

      function card(p: MenuPlan): string {
        const priced = p.priceRange
          ? p.priceRange.lowPaise === p.priceRange.highPaise
            ? rupees(p.priceRange.lowPaise)
            : `${rupees(p.priceRange.lowPaise)} – ${rupees(p.priceRange.highPaise)}`
          : 'nothing on sale';
        const parked = p.menu.items.length - p.liveItems;
        const n = p.untypedDishes.length;

        return (
          `<div class="card bocard">` +
            `<div class="bocard__head">` +
              `<div style="flex:1">` +
                `<h4>${esc(p.menu.name)}</h4>` +
                `<div class="m">${p.liveItems} dish${p.liveItems === 1 ? '' : 'es'} on sale · ` +
                  `${esc(priced)}${parked > 0 ? ` · ${parked} parked` : ''}</div>` +
              `</div>` +
              (p.liveCount > 0
                ? `<span class="tag tag--live">on ${p.liveCount} school${p.liveCount > 1 ? 's' : ''}</span>`
                : `<span class="tag tag--draft">not assigned</span>`) +
            `</div>` +

            `<div class="bocard__tags">` +
              (p.schools.length > 0
                ? p.schools.map(schoolTag).join('')
                : `<span class="m">No school uses this yet — parents cannot see it.</span>`) +
            `</div>` +

            (n > 0
              ? `<div class="notice notice--warn bocard__notice">` +
                  `<b>${n} dish${n === 1 ? '' : 'es'} on this menu ${n === 1 ? 'has' : 'have'} no food type</b>` +
                  `Visible to parents right now with no veg marking.` +
                  `<div class="bocard__act"><a class="btn btn--sm" href="/admin/dishes?type=unset">Fix them</a></div>` +
                `</div>`
              : '') +

            `<div class="bocard__actions">` +
              `<button class="btn btn--ghost btn--sm" type="button" data-rename="${esc(p.menu.id)}">Rename</button>` +
              `<a class="btn btn--ghost btn--sm" href="/admin/schools">Assign to another school</a>` +
              `<button class="btn btn--ghost btn--sm" type="button" data-dup="${esc(p.menu.id)}">Duplicate as a new menu</button>` +
              `<a class="btn btn--ghost btn--sm" href="/admin/dishes">Edit its dishes</a>` +
            `</div>` +
          `</div>`
        );
      }

      function render() {
        if (loading) {
          el.line.textContent = '';
          el.body.innerHTML = Array(3).fill('<div class="sk"></div>').join('');
          return;
        }
        if (error) {
          el.line.textContent = '';
          el.body.innerHTML =
            `<div class="notice notice--err"><b>We can't show the menus</b>${esc(error)}</div>` +
            `<button class="btn" type="button" data-retry>Try again</button>`;
          return;
        }
        if (plans.length === 0) {
          // Both possibilities, because they are indistinguishable from here (`[AUTH-01]`).
          el.line.textContent = '';
          el.body.innerHTML =
            `<div class="empty"><h3>No menus</h3>` +
            `<p>Either none has been created, or this account cannot read them — that needs ` +
            `<b>menu.edit</b>.</p></div>`;
          return;
        }

        const idle = unassignedCount(plans);
        el.line.innerHTML =
          `<b>${plans.length} menu${plans.length === 1 ? '' : 's'}</b>` +
          (idle > 0 ? ` · ${idle} not assigned to any school` : ' · all in use');

        el.body.innerHTML =
          plans.map(card).join('') +
          `<div class="notice notice--info">` +
            `<b>Assigning vs duplicating — the distinction that matters</b>` +
            `<b>Assign</b> points a second school at the <i>same</i> menu: ` +
            `change a price once and both schools change. ` +
            `<b>Duplicate</b> takes a copy that then goes its own way. ` +
            `Starting a new school by assigning an existing menu is the fast path; duplicate the ` +
            `moment its prices or dishes need to differ.` +
          `</div>`;
      }

      /** Rename, Duplicate and New share a shape: one name, one button, one call. */
      function nameDrawer(opts: {
        title: string; sub: string; value: string; cta: string; run: (name: string) => Promise<unknown>;
      }) {
        openDrawer({
          title: opts.title,
          subtitle: opts.sub,
          body:
            `<div class="field"><label for="d-name">Menu name</label>` +
            `<input id="d-name" type="text" value="${esc(opts.value)}" maxlength="80" />` +
            `<p class="help" data-err></p></div>`,
          footer:
            `<button class="btn" type="button" data-go>${esc(opts.cta)}</button>` +
            `<button class="btn btn--ghost" type="button" data-cancel>Cancel</button>`,
        });

        const input = document.querySelector<HTMLInputElement>('#d-name')!;
        const err = document.querySelector<HTMLElement>('[data-err]')!;
        document.querySelector('[data-cancel]')?.addEventListener('click', closeDrawer);
        document.querySelector('[data-go]')?.addEventListener('click', async (event) => {
          const button = event.currentTarget as HTMLButtonElement;
          const problem = api.validateMenuName(input.value);
          if (problem) { err.textContent = problem.name!; return; }
          button.disabled = true;
          try {
            await opts.run(input.value);
            closeDrawer();
            await load();
          } catch (cause) {
            err.textContent = cause instanceof Error ? cause.message : 'That did not save.';
            button.disabled = false;
          }
        });
      }

      el.body.addEventListener('click', (event) => {
        const target = event.target as HTMLElement;
        if (target.closest('[data-retry]')) { void load(); return; }

        const rename = target.closest<HTMLElement>('[data-rename]')?.dataset.rename;
        if (rename) {
          const plan = plans.find((p) => p.menu.id === rename)!;
          nameDrawer({
            title: 'Rename this menu', sub: plan.menu.name, value: plan.menu.name,
            cta: 'Save the name',
            /*
             * Renaming has no write path yet — `E10-56`. The drawer says so rather than closing on
             * a no-op, because a dialog that appears to save and does not is the worst of the
             * three options; a stated limit is the second best, and the button is still here so
             * the screen matches the prototype it is being measured against.
             */
            run: async () => {
              throw new Error('Renaming lands with E10-56. Duplicate and New work today.');
            },
          });
          return;
        }

        const dup = target.closest<HTMLElement>('[data-dup]')?.dataset.dup;
        if (dup) {
          const plan = plans.find((p) => p.menu.id === dup)!;
          nameDrawer({
            title: 'Duplicate as a new menu',
            sub: 'Copies its dishes and prices. It is assigned to no school.',
            value: api.copyName(plan.menu.name, plans.map((p) => p.menu.name)),
            cta: 'Create the copy',
            run: (name) => api.duplicateMenu({ menuId: dup, name }),
          });
        }
      });

      el.neu.addEventListener('click', () => nameDrawer({
        title: 'New menu', sub: 'Empty, and a draft until you publish it', value: '',
        cta: 'Create it', run: (name) => api.createMenu({ name, kitchenId }),
      }));

      el.reload.addEventListener('click', () => void load());

      void (async () => {
        await mountShell();
        try {
          if (!demo && !(await currentUser())) {
            location.assign(`/signin?next=${encodeURIComponent('/admin/menus')}`);
            return;
          }
        } catch { /* fall through and let the read fail visibly */ }
        await load();
      })();
    </script>
  </body>
</html>
