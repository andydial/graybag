---
/**
 * Orders and revenue — `E10-10`, rebuilt in `E11-10`.
 *
 * ## What was wrong with it
 *
 * Andy: *"The /reports is very bad and does not even show the right data. It shows orders and I
 * updated date to at least include 1 more order from the new range and it didn't change any
 * numbers. Also reports does not have option to do per school or per month etc."*
 *
 * Three separate faults, and the first is the serious one:
 *
 * 1. **Unpaid orders were counted as revenue.** `summarise` did `if cancelled or refunded … else
 *    add to gross`, which swept `draft` and `pending_payment` in. On production that was ₹228.92
 *    of "takings" nobody had paid. A number being too large is the one error on a report that
 *    never gets questioned.
 * 2. **Changing a date did nothing until you pressed Show.** The query was correct all along —
 *    extending the range to `2026-08-21` does return one more order — but the form only applied
 *    on submit, so changing a date and reading the numbers showed the previous answer. It now
 *    applies on change, and the presets mean the common ranges need no typing at all.
 * 3. **No grouping.** Month, school and day are now a control rather than a rebuild.
 *
 * ## One set of rows, three views
 *
 * `summarise` returns (day, school) rows — the finest grain the source has — and every view is a
 * fold of those via `groupRows`. Three separate queries would let the per-school total disagree
 * with the per-month one, and a report whose own totals disagree is worse than no report.
 *
 * ## Still no child, anywhere
 *
 * `REPORT_ORDER_COLUMNS` reads no recipient, class or section (non-negotiable #4). None of this
 * rebuild widens it.
 */
import BackofficeNav from '../components/BackofficeNav.astro';

import '../styles/tokens.css';
import '../styles/site.css';
import '../styles/kitchen.css';
import '../styles/admin.css';
---

<!doctype html>
<html lang="en-IN">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <title>Revenue — GrayBag</title>
    <link rel="preload" href="/fonts/nunito-latin-var.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="icon" href="/img/favicon.png" type="image/png" sizes="64x64" />
  </head>

  <body>
    <div class="kitchen">
      <header class="kitchen__bar">
        <div class="kitchen__bar-inner kitchen__bar-inner--admin">
          <h1 class="kitchen__title">Revenue</h1>
          <button id="r-reload" class="kitchen__btn kitchen__refresh" type="button">Refresh</button>
          <BackofficeNav current="/reports" />
        </div>
      </header>

      <main class="kitchen__wrap admin__wrap">
        <div id="r-status" class="visually-hidden" role="status" aria-live="polite"></div>

        <!--
          The controls apply on change. There is no Show button, deliberately: one existed, and
          changing a date without pressing it showed the previous answer while looking like the
          new one. A control that silently does nothing is worse than no control.
        -->
        <div class="rctl">
          <div class="rctl__presets" role="group" aria-label="Range">
            <button class="kitchen__btn kitchen__btn--small" type="button" data-preset="7">7 days</button>
            <button class="kitchen__btn kitchen__btn--small" type="button" data-preset="30">30 days</button>
            <button class="kitchen__btn kitchen__btn--small" type="button" data-preset="month">This month</button>
            <button class="kitchen__btn kitchen__btn--small" type="button" data-preset="last">Last month</button>
            <button class="kitchen__btn kitchen__btn--small" type="button" data-preset="180">6 months</button>
          </div>

          <div class="rctl__dates">
            <label class="admin__label" for="r-from">From</label>
            <input class="admin__input" id="r-from" type="date" required />
            <label class="admin__label" for="r-to">To</label>
            <input class="admin__input" id="r-to" type="date" required />
          </div>

          <div class="rctl__group">
            <label class="admin__label" for="r-school">School</label>
            <select class="admin__select" id="r-school">
              <option value="">All schools</option>
            </select>
          </div>

          <div class="rctl__group">
            <label class="admin__label" for="r-by">Group by</label>
            <select class="admin__select" id="r-by">
              <option value="day">Day</option>
              <option value="month" selected>Month</option>
              <option value="school">School</option>
            </select>
          </div>
        </div>

        <div class="rctl__actions">
          <!--
            Exports what is on the screen, from the same rows the table renders. A second query
            for the export is how a CSV ends up quietly disagreeing with the table above it.
          -->
          <button class="kitchen__btn" id="r-export" type="button">Download CSV</button>
        </div>

        <!--
          The range and filter, in words, visible — the prototype's `resultline` (`E11-17`).

          It was previously only in the `aria-live` region, which is to say only somebody using a
          screen reader was told what they were looking at. It is also the fix for the complaint
          that started this screen's rebuild: when every range returns the same rows, a sentence
          that changes is the only proof the control did anything.
        -->
        <p class="rctl__line" id="r-line"></p>

        <div id="r-body"></div>
      </main>
    </div>

    <script>
      import { mountNav } from '../lib/backoffice/nav-mount.js';
      import { api, money } from '@graybag/shared';
      import { csvFilename, downloadCsv, reportToCsv } from '../lib/admin/csv-export.js';
      import { funnelForCohort, usageInRange } from '../lib/admin/growth.js';
      import type { FunnelOrder } from '../lib/admin/growth.js';
      import { area, columns } from '../lib/admin/chart.js';
      import { configureBackofficeApi, currentUser } from '../lib/backoffice/session.js';
      import { serviceDateToday } from '../lib/kitchen/view.js';
      import { REPORTS_FIXTURE } from '../lib/admin/reports-fixture.js';
      import { GROWTH_FIXTURE } from '../lib/admin/growth-fixture.js';

      const $ = <T extends HTMLElement>(id: string) => document.getElementById(id) as T;
      const el = {
        body: $('r-body'), status: $('r-status'), reload: $<HTMLButtonElement>('r-reload'),
        from: $<HTMLInputElement>('r-from'), to: $<HTMLInputElement>('r-to'),
        by: $<HTMLSelectElement>('r-by'), school: $<HTMLSelectElement>('r-school'),
        exportBtn: $<HTMLButtonElement>('r-export'), line: $('r-line'),
      };
      const esc = (s: string) =>
        String(s ?? '').replace(/[&<>"']/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' })[c]!);
      const rupees = (p: number) => money.formatPaise(p);

      const demo = new URLSearchParams(location.search).has('state');
      let rows: api.ReportRow[] = [];
      /** The cohort funnel for the range — `E11-16`. Null until the read succeeds. */
      let funnel: ReturnType<typeof funnelForCohort> | null = null;
      /**
       * The orders behind the usage block — `E11-17`.
       *
       * Kept raw rather than pre-aggregated, because the school filter applies on render and
       * re-aggregating from these is instant while re-fetching would make a dropdown hit the
       * network. Empty when the growth read was refused, which is a state the render handles.
       */
      let growthOrders: FunnelOrder[] = [];
      let loading = true;
      let error: string | null = null;

      const MONTHS = ['January', 'February', 'March', 'April', 'May', 'June',
        'July', 'August', 'September', 'October', 'November', 'December'];

      /** `2026-08` as "August 2026", `2026-08-17` as "17 Aug". Formatted from parts, never a Date. */
      function label(key: string, by: api.GroupBy): string {
        if (by === 'month') {
          const [y, m] = key.split('-');
          return `${MONTHS[Number(m) - 1] ?? key} ${y}`;
        }
        if (by === 'day') {
          const [, m, d] = key.split('-');
          return `${Number(d)} ${(MONTHS[Number(m) - 1] ?? '').slice(0, 3)}`;
        }
        return key;
      }

      /**
       * "20–26 August 2026", or "28 July – 26 August 2026" across a boundary — `E11-17`.
       *
       * The prototype's result line, in words rather than as two ISO dates. The month is written
       * once when both ends share it, because "20 August 2026 – 26 August 2026" is the same fact
       * said twice and reads as a longer range than it is.
       */
      function rangeWords(from: string, to: string): string {
        const [fy, fm, fd] = from.split('-').map(Number) as [number, number, number];
        const [ty, tm, td] = to.split('-').map(Number) as [number, number, number];
        const name = (m: number) => MONTHS[m - 1] ?? '';
        if (fy === ty && fm === tm) return `${fd}–${td} ${name(tm)} ${ty}`;
        if (fy === ty) return `${fd} ${name(fm)} – ${td} ${name(tm)} ${ty}`;
        return `${fd} ${name(fm)} ${fy} – ${td} ${name(tm)} ${ty}`;
      }

      /**
       * Shift a `YYYY-MM-DD` by whole days, without a `Date`.
       *
       * `E09-32` cost this project a morning: parsing a date string gives UTC midnight, and in
       * IST — UTC+5:30 — formatting it back can land on the previous day. Every date on this
       * screen is arithmetic on the epoch at noon, which no timezone can move across a boundary.
       */
      function shift(date: string, days: number): string {
        const t = Date.parse(`${date}T12:00:00Z`) + days * 86_400_000;
        return new Date(t).toISOString().slice(0, 10);
      }

      function applyPreset(preset: string) {
        const today = serviceDateToday(new Date());
        const [y, m] = today.split('-').map(Number) as [number, number];
        if (preset === 'month') {
          el.from.value = `${y}-${String(m).padStart(2, '0')}-01`;
          el.to.value = today;
        } else if (preset === 'last') {
          const py = m === 1 ? y - 1 : y;
          const pm = m === 1 ? 12 : m - 1;
          el.from.value = `${py}-${String(pm).padStart(2, '0')}-01`;
          // The last day of the previous month is the day before the first of this one.
          el.to.value = shift(`${y}-${String(m).padStart(2, '0')}-01`, -1);
        } else {
          el.from.value = shift(today, -Number(preset));
          el.to.value = today;
        }
        void load();
      }

      async function load() {
        loading = true; error = null; render();
        try {
          if (demo) {
            rows = REPORTS_FIXTURE.rows as unknown as api.ReportRow[];
            // The funnel is part of this screen now, so the demo has to carry one or the a11y
            // gate audits a page with a section missing.
            funnel = funnelForCohort(
              GROWTH_FIXTURE.users, GROWTH_FIXTURE.links, GROWTH_FIXTURE.children,
              GROWTH_FIXTURE.orders, REPORTS_FIXTURE.from, REPORTS_FIXTURE.to,
            );
            growthOrders = [...GROWTH_FIXTURE.orders];
          } else {
            configureBackofficeApi();
            /*
             * The funnel read is allowed to fail on its own — `E11-16`.
             *
             * It needs `users.view`, which the revenue report does not. Somebody holding only
             * `reports.view` should still get their revenue rather than an error page about a
             * funnel they did not ask for.
             */
            const [revenue, growthData] = await Promise.all([
              api.fetchMonthlyRevenue(el.from.value, el.to.value),
              api.fetchGrowth().catch(() => null),
            ]);
            rows = revenue;
            funnel = growthData
              ? funnelForCohort(
                  growthData.users, growthData.links, growthData.children,
                  growthData.orders, el.from.value, el.to.value,
                )
              : null;
            growthOrders = growthData ? growthData.orders : [];
          }

          // The filter is rebuilt from the rows in range, so it never offers a school with
          // nothing in it — and a school that drops out of range clears rather than filtering
          // everything to zero with no explanation.
          const schools = api.schoolsIn(rows);
          const chosen = el.school.value;
          el.school.innerHTML =
            `<option value="">All schools</option>` +
            schools.map((sc) => `<option value="${esc(sc.id)}">${esc(sc.name)}</option>`).join('');
          el.school.value = schools.some((sc) => sc.id === chosen) ? chosen : '';
        } catch (cause) {
          error = cause instanceof Error ? cause.message : 'The report did not load.';
          rows = [];
        } finally {
          loading = false; render();
        }
      }

      const stat = (value: string, label: string, note = '', tone = '') =>
        `<div class="gstat${tone ? ` gstat--${tone}` : ''}">` +
        `<p class="gstat__n">${esc(value)}</p><p class="gstat__l">${esc(label)}</p>` +
        (note ? `<p class="gstat__note">${esc(note)}</p>` : '') + `</div>`;

      /**
       * The per-school breakdown, always on — `E11-17`.
       *
       * It used to appear only when "Group by" was set to School, which made the one thing Andy
       * asks of this screen most often — *"which school is actually ordering"* — a thing you had
       * to know to go looking for. The prototype shows it unconditionally, under its own heading,
       * beneath whatever grouping is selected above. Same rows, folded a second way; the totals
       * cannot disagree with the table above because both come from `visible`.
       *
       * Hidden only when a single school is selected, where it would be one row repeating the
       * headline.
       */
      function perSchoolSection(
        visible: api.ReportRow[], usage: ReturnType<typeof usageInRange>, schoolId: string | null,
      ): string {
        if (schoolId) return '';
        const schools = api.groupRows(visible, 'school');
        if (schools.length < 2) return '';

        const row = (b: api.Bucket) => {
          const paid = b.orders - b.cancelled - b.pending;
          const active = usage.bySchool.get(b.key) ?? 0;
          return `<tr>` +
            `<th scope="row">${esc(b.label)}</th>` +
            `<td class="otable__num">${paid || '—'}</td>` +
            `<td class="otable__num">${esc(rupees(b.netPaise))}</td>` +
            `<td class="otable__num">${paid > 0 ? esc(rupees(Math.round(b.netPaise / paid))) : '—'}</td>` +
            // A dash rather than 0 when the growth read was refused — see the Usage note.
            `<td class="otable__num">${growthOrders.length === 0 ? '—' : active || '—'}</td>` +
          `</tr>`;
        };

        return `<section class="admin__section" aria-labelledby="sch-h">` +
          `<h2 id="sch-h">By school</h2>` +
          `<table class="otable">` +
            `<thead><tr>` +
              `<th scope="col">School</th><th scope="col">Paid orders</th>` +
              `<th scope="col">Net</th><th scope="col">Average order</th>` +
              `<th scope="col">Parents who ordered</th>` +
            `</tr></thead>` +
            // Sorted by what was earned. A school table ordered by name buries the answer to the
            // only question it is opened to answer.
            `<tbody>${[...schools].sort((a, b) => b.netPaise - a.netPaise).map(row).join('')}</tbody>` +
          `</table>` +
        `</section>`;
      }

      function render() {
        if (loading) {
          el.body.innerHTML = Array(3).fill('<div class="kitchen__skeleton"></div>').join('');
          return;
        }
        if (error) {
          el.body.innerHTML =
            `<div class="kitchen__state"><h2>We can't show the report</h2><p>${esc(error)}</p>` +
            `<button class="kitchen__btn kitchen__btn--primary" data-retry>Try again</button></div>`;
          return;
        }
        if (rows.length === 0) {
          // Both possibilities, because they are indistinguishable from here (`[AUTH-01]`).
          el.body.innerHTML =
            `<div class="kitchen__state"><h2>Nothing in this range</h2>` +
            `<p>Either no orders were served between <b>${esc(el.from.value)}</b> and ` +
            `<b>${esc(el.to.value)}</b>, or this account cannot read them — that needs ` +
            `<b>reports.view</b>, and what it shows is scoped to the schools you are granted.</p></div>`;
          return;
        }

        const by = el.by.value as api.GroupBy;
        const schoolId = el.school.value || null;
        // Filtered on the rows, before grouping, so every view and the export agree without each
        // having to remember to do it.
        const visible = api.forSchool(rows, schoolId);
        const buckets = api.groupRows(visible, by);
        const t = api.totalOf(buckets);
        const paidOrders = t.orders - t.cancelled - t.pending;

        // Same range, same filter, same service-date basis as the money above — see `usageInRange`.
        const usage = usageInRange(growthOrders, el.from.value, el.to.value, schoolId);

        const chosenSchool = api.schoolsIn(rows).find((sc) => sc.id === schoolId);
        el.line.textContent =
          `${rangeWords(el.from.value, el.to.value)} · ` +
          `${chosenSchool ? chosenSchool.name : 'all schools'}`;

        el.status.textContent =
          `${t.orders} orders, ${rupees(t.netPaise)} net, across ${buckets.length} ${by}s.`;

        // Two series on one axis: what was earned, and what is placed but unpaid. Stacking them
        // would restate the bug this rebuild fixes — that unpaid money looks like revenue.
        const earned = buckets.map((b) => ({
          label: label(b.key, by), value: b.netPaise,
          title: `${label(b.key, by)}: ${rupees(b.netPaise)} net from ${b.orders - b.cancelled - b.pending} paid orders`,
        }));
        const pending = buckets.map((b) => ({
          label: label(b.key, by), value: b.pendingPaise,
          title: `${label(b.key, by)}: ${rupees(b.pendingPaise)} placed but not paid`,
        }));

        const chart = by === 'school'
          ? columns(earned, { label: `Net revenue by school`, format: rupees })
          : columns(earned, { label: `Net revenue by ${by}`, format: rupees });

        const orderChart = columns(
          buckets.map((b) => ({ label: label(b.key, by), value: b.orders,
            title: `${label(b.key, by)}: ${b.orders} orders (${b.cancelled} cancelled, ${b.pending} unpaid)` })),
          { label: `Orders by ${by}` },
        );

        const pendingChart = t.pendingPaise > 0
          ? `<section class="admin__section"><h2>Placed but not paid</h2>` +
            `<p class="admin__section-note">` +
              `<b>${rupees(t.pendingPaise)}</b> across ${t.pending} order` +
              `${t.pending === 1 ? '' : 's'}. <b>This is not revenue</b> — it is what those orders ` +
              `would be worth if they were paid.</p>` +
            columns(pending, { label: 'Unpaid order value', format: rupees }).replace(/cx__bar/g, 'cx__bar cx__bar--pending') +
            `</section>`
          : '';

        el.body.innerHTML =
          `<div class="gstats">` +
            stat(rupees(t.netPaise), 'Net revenue', `${rupees(t.grossPaise)} gross`) +
            stat(String(paidOrders), 'Paid orders', `${t.orders} placed in total`) +
            // The prototype's fourth money card. Over **paid** orders only — dividing by every
            // order placed would quietly shrink the average every time somebody abandoned a cart.
            stat(
              paidOrders > 0 ? rupees(Math.round(t.netPaise / paidOrders)) : '—',
              'Average order', paidOrders > 0 ? 'net, over paid orders' : 'nothing paid in this range',
            ) +
            stat(rupees(t.taxPaise), 'GST collected', 'CGST + SGST, 5%') +
            stat(String(t.cancelled), 'Cancelled', t.refundedPaise > 0 ? `${rupees(t.refundedPaise)} refunded` : 'nothing refunded') +
            stat(String(t.pending), 'Unpaid', rupees(t.pendingPaise), t.pending > 0 ? 'warn' : '') +
          `</div>` +

          `<section class="admin__section" aria-labelledby="rev-h">` +
            `<h2 id="rev-h">Net revenue by ${esc(by)}</h2>` +
            chart +
          `</section>` +

          `<section class="admin__section" aria-labelledby="ord-h">` +
            `<h2 id="ord-h">Orders by ${esc(by)}</h2>` +
            orderChart +
          `</section>` +

          pendingChart +

          perSchoolSection(visible, usage, schoolId) +

          `<section class="admin__section" aria-labelledby="use-h">` +
            `<h2 id="use-h">Usage</h2>` +
            `<p class="admin__section-note">` +
              `Whether the families we already have keep ordering — a different question from the ` +
              `funnel below, and a product can look healthy on one while dying on the other. ` +
              `Counted on the same paid orders and the same service dates as the money above.` +
            `</p>` +
            `<div class="gstats">` +
              stat(String(usage.activeParents), 'Parents who ordered',
                usage.activeParents === 1 ? 'in this range' : 'distinct, in this range') +
              stat(usage.activeParents > 0 ? usage.ordersPerParent.toFixed(1) : '—',
                'Orders per parent', 'paid orders ÷ parents who ordered') +
              stat(
                usage.repeatRate === null ? '—' : String(usage.repeatParents),
                'Ordered more than once',
                usage.repeatRate === null
                  ? 'nobody ordered in this range'
                  : `of ${usage.activeParents} who ordered`,
              ) +
            `</div>` +
            (growthOrders.length === 0
              // Said rather than shown as zeros: three dashes with no explanation reads as "nobody
              // is using it", which is a very different message from "this account cannot see it".
              ? `<p class="admin__hint">Usage needs <b>users.view</b> as well as ` +
                `<b>reports.view</b>. The revenue above does not, which is why it is still here.</p>`
              : usage.paidOrders !== paidOrders && !demo
              /*
               * The two halves of this screen come from two reads — `fetchMonthlyRevenue`, which
               * filters by service date in the database, and `fetchGrowth`, which reads orders
               * unpaginated and is filtered here. They count the same paid orders on the same
               * dates, so they must agree, and the day they stop agreeing is the day the growth
               * read starts truncating.
               *
               * That failure is silent by nature: revenue stays correct and usage quietly shrinks
               * beside it. Saying so is worth more than a plausible number — the whole reason
               * `E11-10` existed was a screen whose figures contradicted each other.
               *
               * Exempt in the demo, where the two fixtures are deliberately independent datasets
               * and disagreeing is what they are supposed to do.
               */
              ? `<p class="admin__hint admin__hint--warn">These counts are built from a second ` +
                `read that found <b>${usage.paidOrders}</b> paid orders where the revenue above ` +
                `found <b>${paidOrders}</b>. They should be identical. Treat the parent counts as ` +
                `a floor and tell Andy — this usually means the order read is being truncated.</p>`
              : `<p class="admin__hint">A parent who ordered before this range and again inside ` +
                `it counts here as one order, not a repeat. That understates loyalty, and it is ` +
                `the right direction to be wrong in — the alternative reads all-time history into ` +
                `a seven-day window and reports a repeat rate that can never fall.</p>`) +
          `</section>` +

          (funnel && funnel.cohort > 0
            ? `<section class="admin__section" aria-labelledby="fn-h">` +
                `<h2 id="fn-h">Of the families who arrived in this range</h2>` +
                `<p class="admin__section-note">` +
                  `The <b>${funnel.cohort}</b> parents who registered between ` +
                  `${esc(el.from.value)} and ${esc(el.to.value)}, and how far they have got ` +
                  `<b>since</b> — not only within the range. A parent who registered on the last ` +
                  `day has had less time than one who registered on the first, so a range ending ` +
                  `recently will always look worse.` +
                `</p>` +
                `<ol class="fnl">` +
                  funnel.steps.map((f) =>
                    `<li class="fnl__step">` +
                      `<span class="fnl__bar" style="--w:${funnel!.cohort === 0 ? 0 : Math.round((f.reached / funnel!.cohort) * 100)}%"></span>` +
                      `<span class="fnl__body">` +
                        `<span class="fnl__top">` +
                          `<b class="fnl__n">${f.reached}</b>` +
                          `<span class="fnl__label">${esc(f.label)}</span>` +
                          /*
                           * **No percentage here — `E11-17`.** The prototype states the reason
                           * and it wins where it and this screen disagree: "4 of 13 is a fact,
                           * 31% is a claim about a pattern that isn't there yet." At production's
                           * current volume one more parent moves the rate by eight points, and a
                           * number that swings that hard invites conclusions the data cannot
                           * carry. `FunnelStep.rate` still exists; nothing renders it.
                           */
                        `</span>` +
                        `<span class="fnl__lost">` +
                          (f.lost > 0 ? `<b>${f.lost}</b> stopped here. ` : '') + esc(f.action) +
                        `</span>` +
                      `</span>` +
                    `</li>`).join('') +
                `</ol>` +
              `</section>`
            : '') +

          `<section class="admin__section" aria-labelledby="tbl-h">` +
            `<h2 id="tbl-h">The numbers</h2>` +
            `<table class="otable">` +
              `<thead><tr>` +
                `<th scope="col">${by === 'school' ? 'School' : by === 'month' ? 'Month' : 'Day'}</th>` +
                `<th scope="col">Paid</th><th scope="col">Unpaid</th><th scope="col">Cancelled</th>` +
                `<th scope="col">Gross</th><th scope="col">GST</th>` +
                `<th scope="col">Refunded</th><th scope="col">Net</th>` +
              `</tr></thead>` +
              `<tbody>` +
                buckets.map((b) =>
                  `<tr>` +
                    `<th scope="row">${esc(by === 'school' ? b.label : label(b.key, by))}</th>` +
                    `<td class="otable__num">${b.orders - b.cancelled - b.pending}</td>` +
                    `<td class="otable__num">${b.pending || '—'}</td>` +
                    `<td class="otable__num">${b.cancelled || '—'}</td>` +
                    `<td class="otable__num">${esc(rupees(b.grossPaise))}</td>` +
                    `<td class="otable__num">${esc(rupees(b.taxPaise))}</td>` +
                    `<td class="otable__num">${b.refundedPaise ? esc(rupees(b.refundedPaise)) : '—'}</td>` +
                    `<td class="otable__num"><b>${esc(rupees(b.netPaise))}</b></td>` +
                  `</tr>`).join('') +
              `</tbody>` +
              // The total is a `<tfoot>`, so it stays with the table when it scrolls and is
              // announced as a summary rather than as one more row of data.
              `<tfoot><tr>` +
                `<th scope="row">Total</th>` +
                `<td class="otable__num">${t.orders - t.cancelled - t.pending}</td>` +
                `<td class="otable__num">${t.pending || '—'}</td>` +
                `<td class="otable__num">${t.cancelled || '—'}</td>` +
                `<td class="otable__num">${esc(rupees(t.grossPaise))}</td>` +
                `<td class="otable__num">${esc(rupees(t.taxPaise))}</td>` +
                `<td class="otable__num">${t.refundedPaise ? esc(rupees(t.refundedPaise)) : '—'}</td>` +
                `<td class="otable__num"><b>${esc(rupees(t.netPaise))}</b></td>` +
              `</tr></tfoot>` +
            `</table>` +
            `<p class="admin__hint">` +
              `<b>Unpaid orders are not counted as revenue.</b> Cancelled orders are counted in ` +
              `the order total so it reconciles with the kitchen, and excluded from gross.` +
            `</p>` +
          `</section>`;
      }

      el.body.addEventListener('click', (event) => {
        if ((event.target as HTMLElement).closest('[data-retry]')) void load();
      });
      el.reload.addEventListener('click', () => void load());

      // Apply on change. No Show button — see the markup.
      el.school.addEventListener('change', render);

      el.exportBtn.addEventListener('click', () => {
        const by = el.by.value as api.GroupBy;
        const visible = api.forSchool(rows, el.school.value || null);
        const buckets = api.groupRows(visible, by);
        const chosen = api.schoolsIn(rows).find((sc) => sc.id === el.school.value);

        downloadCsv(
          reportToCsv(buckets, {
            by, from: el.from.value, to: el.to.value,
            schoolName: chosen?.name ?? null,
            label: (key) => label(key, by),
          }),
          csvFilename(el.from.value, el.to.value, 'revenue'),
        );
      });

      el.from.addEventListener('change', () => void load());
      el.to.addEventListener('change', () => void load());
      el.by.addEventListener('change', render);

      for (const button of document.querySelectorAll<HTMLButtonElement>('[data-preset]')) {
        button.addEventListener('click', () => applyPreset(button.dataset.preset!));
      }

      void (async () => {
        if (demo) {
          el.from.value = REPORTS_FIXTURE.from;
          el.to.value = REPORTS_FIXTURE.to;
        } else {
          const today = serviceDateToday(new Date());
          // Thirty days, ending **tomorrow** rather than today: an order for tomorrow's lunch is
          // already placed and paid for, and a revenue report that hides it is the "why is this
          // number stale" question that started this rebuild.
          el.from.value = shift(today, -30);
          el.to.value = shift(today, 1);
        }

        try {
          if (!demo && !(await currentUser())) {
            location.assign(`/signin?next=${encodeURIComponent('/reports')}`);
            return;
          }
        } catch { /* fall through and let the read fail visibly */ }
        await load();
      })();

      void mountNav();
    </script>
  </body>
</html>
