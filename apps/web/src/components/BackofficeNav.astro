---
/**
 * The back-office navigation bar — `E10-43`.
 *
 * Andy: *"I (as super admin or all privileges) should login into a dashboard and should have
 * options to navigate to all other available web screens / reports etc. Currently I need to find
 * and paste URL endpoints to open some / many of those."*
 *
 * ## Why this exists when `nav.ts` already did
 *
 * `nav.ts` has modelled this since `E10-12` — every route, what it requires, a description, and
 * the reason an unreachable item is omitted rather than disabled. **Nothing imported it.** Each
 * screen hand-rolled its own links instead, so `/admin/menus` offered four of them, `/orders`
 * offered one, six screens offered none, and `/kitchen/sheet`, `/admin/allergens` and
 * `/admin/people` were reachable from no link anywhere in the app.
 *
 * The table was also wrong in a way nobody could see: it pointed at `/admin/orders`, which has
 * never existed. A nav item pointing at nothing looks exactly like one correctly hidden from you.
 *
 * ## Rendered from the table, filtered in the browser
 *
 * The markup below is generated by mapping `NAV`, so a route added there appears here with no
 * second edit. Every item ships **hidden** and is revealed once `fetchMyGrants()` says it may be —
 * the opposite order from rendering everything and hiding what is forbidden, which would flash a
 * list of screens at somebody who cannot open one of them.
 *
 * Hiding is presentation only. Every route is enforced server-side by RLS regardless, exactly as
 * `fetchMyGrants`' own documentation says: hiding a button is a courtesy, not a control.
 */
import { NAV } from '../lib/backoffice/nav.js';

interface Props {
  /** The page this bar is on, e.g. `/kitchen`. Marks the current item for screen readers. */
  current: string;
}

const { current } = Astro.props;
---

<nav class="bonav" aria-label="Back office" data-bonav>
  <button
    class="bonav__toggle"
    type="button"
    id="bonav-toggle"
    aria-expanded="false"
    aria-controls="bonav-panel"
  >
    <span class="bonav__burger" aria-hidden="true"></span>
    <span>Menu</span>
  </button>

  <div class="bonav__panel" id="bonav-panel" data-bonav-panel>
    <ul class="bonav__list">
      {
        NAV.map((item) => (
          <li class="bonav__item" data-nav-item data-requires={item.requires.join(' ')} hidden>
            <a
              class="bonav__link"
              href={item.href}
              aria-current={item.href === current ? 'page' : undefined}
            >
              {item.label}
            </a>
          </li>
        ))
      }
    </ul>

    <div class="bonav__account">
      <!--
        The address is the only way to tell which account a shared kitchen tablet is signed in as,
        and getting that wrong is how one person's grants silently become everyone's.
      -->
      <span class="bonav__who" data-bonav-who></span>
      <button class="bonav__signout" type="button" data-bonav-signout hidden>Sign out</button>
    </div>
  </div>
</nav>
