# Template for .secrets.<environment>.env — copy, fill in, never commit.
#
#   cp .env.example .secrets.staging.env
#   $EDITOR .secrets.staging.env
#   npm run secrets:set -- staging --dry
#   npm run secrets:set -- staging
#
# .secrets.*.env is gitignored. Values come from the password manager, not from a
# colleague's message and not from a provider dashboard's "reveal" button.
#
# Every variable below is validated by packages/shared/src/env.ts before anything is
# sent anywhere. In particular RAZORPAY_KEY_ID must be rzp_test_ for local and staging
# and rzp_live_ for production — that check is the reason this file exists.
#
# Inventory, ownership and rotation cadence: docs/secret-rotation-policy.md §1.

# Which environment this file is for: local | staging | production
APP_ENV=staging

# --- Supabase -----------------------------------------------------------------
# Project ref is the subdomain of the project URL: https://<ref>.supabase.co
SUPABASE_PROJECT_REF=
SUPABASE_URL=
# Publishable. Ships in the mobile bundle by design — RLS is the control, not this key.
SUPABASE_ANON_KEY=
# SERVER ONLY. Bypasses RLS entirely. Never in a client bundle, never in a log.
SUPABASE_SERVICE_ROLE_KEY=
# Personal access token used by CI to run migrations. Not an application secret.
SUPABASE_ACCESS_TOKEN=

# The Postgres password for THIS project. Must differ per environment: the deploy
# workflows read the unscoped name `secrets.SUPABASE_DB_PASSWORD`, so a repository-level
# value would let a production `db push` authenticate with staging's password (E17-64).
SUPABASE_DB_PASSWORD=

# --- Razorpay -----------------------------------------------------------------
# rzp_test_… for local and staging, rzp_live_… for production. Enforced, not assumed.
# The key id is public (the checkout SDK needs it); the secret is not.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Chosen by us per endpoint, not issued by Razorpay.
RAZORPAY_WEBHOOK_SECRET=
# Set ONLY during a webhook-secret rotation, so events signed with either secret
# verify while Razorpay's in-flight retries drain. Unset it once the window closes.
# docs/secret-rotation-policy.md §2.2
RAZORPAY_WEBHOOK_SECRET_PREVIOUS=

# --- Observability ------------------------------------------------------------
# Semi-public: a DSN can submit events but not read them. Optional.
SENTRY_DSN=
